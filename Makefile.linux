# Sea -- checks on x86_64 Linux (GNU as), docs/DESIGN.md 6.
#
#   make -f Makefile.linux check-includes   assemble tests/include_check_x86_64.s:
#                                           the contract include files with GNU as,
#                                           layout assertions, code ranges, table
#                                           sizes, no name clash with Baysick's
#                                           include/limits.inc and include/runtime.inc
#
# Run on x86_64 Linux; from the Mac, tests/cross_includes.sh (make cross-includes)
# copies the files to the Linux host and runs this target there. BAYSICK is the
# Baysick checkout (default: the parent directory). The check works in a
# temporary directory and leaves no files behind.

UNAME_SM := $(shell uname -sm)
ifneq ($(UNAME_SM),Linux x86_64)
$(error Makefile.linux: run the x86_64 checks on x86_64 Linux (uname -sm is '$(UNAME_SM)'))
endif

AS      ?= as
BAYSICK ?= ..

INCLUDES := include/limits.inc include/errors.inc include/rt.inc
ASFLAGS_BASE := --64 --fatal-warnings -I include -I tests

.PHONY: check-includes
.DEFAULT_GOAL := check-includes

# Same comment rule and grep as the Mac Makefile (Baysick DESIGN.md 3.4).
check-includes: $(INCLUDES) tests/include_check_x86_64.s tests/include_asserts.inc
	@if [ ! -f "$(BAYSICK)/include/limits.inc" ] || [ ! -f "$(BAYSICK)/include/runtime.inc" ]; then \
	  echo "make: Baysick's include/limits.inc and include/runtime.inc not found under BAYSICK=$(BAYSICK)" >&2; exit 1; \
	fi
	@if grep -nE '^[[:space:]]*[^[:space:]/].*//' $(INCLUDES) tests/include_asserts.inc; then \
	  echo "make: trailing // comment in a shared include file (use /* ... */)" >&2; exit 1; \
	fi
	@t=$$(mktemp -d "$${TMPDIR:-/tmp}/sea-incl.XXXXXX") || exit 1; \
	b=$$(cd "$(BAYSICK)" && pwd); \
	printf '# generated by make check-includes\n.include "%s/include/limits.inc"\n.include "%s/include/runtime.inc"\n' "$$b" "$$b" > "$$t/bsk_contract.inc"; \
	echo "$(AS) $(ASFLAGS_BASE) -I $$t -o $$t/include_check.o tests/include_check_x86_64.s"; \
	$(AS) $(ASFLAGS_BASE) -I "$$t" -o "$$t/include_check.o" tests/include_check_x86_64.s; st=$$?; \
	rm -rf "$$t"; \
	if [ $$st -ne 0 ]; then exit $$st; fi
	@echo "include files assemble, layout assertions hold, no clash with Baysick's include/limits.inc and include/runtime.inc"
