75000 REM f64emu.bas: exact IEEE binary64 on 16-bit limbs (needs limb); lines 75000-81999; API: API-arith.md
75010 SUB "FEUNP": X3,X2,X1,X0,S,K,M,E ' sign S, class K, |A| = M*2^E
75020     LET G = INT(X3/32768)
75030     LET T = X3-G*32768
75040     LET B = INT(T/16) ' biased exponent
75050     LET F = (((T-B*16)*65536+X2)*65536+X1)*65536+X0 ' fraction, < 2^52
75060     LET S = G
75070     IF B = 2047 THEN 75210
75080     IF B = 0 THEN 75130
75090     LET K = 2
75100     LET M = F+65536*65536*65536*16
75110     LET E = B-1075
75120     GOTO 75260
75130     LET K = 0
75140     LET M = 0
75150     LET E = 0
75160     IF F = 0 THEN 75260
75170     LET K = 1
75180     LET M = F
75190     LET E = -1074
75200     GOTO 75260
75210     LET K = 3
75220     IF F = 0 THEN 75240
75230     LET K = 4
75240     LET M = 0
75250     LET E = 0
75260 SUBEND
75270 SUB "FECLS": X3,X2,X1,X0,K,S ' class K (0 zero 1 sub 2 normal 3 inf 4 NaN), sign S
75280     CALL "FEUNP": X3,X2,X1,X0,S,K,M,E
75290 SUBEND
75300 SUB "FEPCK": G,K,M,E,R3,R2,R1,R0 ' internal: R = (-1)^G*M*2^E, or K = 3 inf, K = 4 NaN
75310     DIM P(4)
75320     IF K = 4 THEN 75370
75330     IF K = 3 THEN 75420
75340     CALL "LBSET": P(),M
75350     CALL "LBTOF": P(),E,G,0,R3,R2,R1,R0,V
75360     GOTO 75460
75370     LET R3 = 32760
75380     LET R2 = 0
75390     LET R1 = 0
75400     LET R0 = 0
75410     GOTO 75460
75420     LET R3 = 32752+G*32768
75430     LET R2 = 0
75440     LET R1 = 0
75450     LET R0 = 0
75460 SUBEND
75470 SUB "FEADS": S1,K1,M1,E1,S2,K2,M2,E2,R3,R2,R1,R0 ' internal: signed exact add, rounded
75480     DIM P(150),Q(150)
75490     IF K1 = 4 THEN 75910
75500     IF K2 = 4 THEN 75910
75510     IF K1 <> 3 THEN 75560
75520     IF K2 <> 3 THEN 75540
75530     IF S1 <> S2 THEN 75910 ' inf - inf
75540     CALL "FEPCK": S1,3,0,0,R3,R2,R1,R0
75550     GOTO 75920
75560     IF K2 <> 3 THEN 75590
75570     CALL "FEPCK": S2,3,0,0,R3,R2,R1,R0
75580     GOTO 75920
75590     LET F1 = E1
75600     LET F2 = E2
75610     IF M1 > 0 THEN 75630
75620     LET F1 = F2
75630     IF M2 > 0 THEN 75650
75640     LET F2 = F1
75650     LET F = F1 ' align both on the smaller exponent, exactly
75660     IF F2 >= F THEN 75680
75670     LET F = F2
75680     CALL "LBSET": P(),M1
75690     CALL "LBSHL": P(),F1-F
75700     CALL "LBSET": Q(),M2
75710     CALL "LBSHL": Q(),F2-F
75720     LET G = S1
75730     IF S1 <> S2 THEN 75760
75740     CALL "LBADD": P(),Q()
75750     GOTO 75890
75760     CALL "LBCMP": P(),Q(),C
75770     IF C > 0 THEN 75840
75780     IF C < 0 THEN 75860
75790     LET R3 = 0 ' exact zero of a difference: +0
75800     LET R2 = 0
75810     LET R1 = 0
75820     LET R0 = 0
75830     GOTO 75920
75840     CALL "LBSUB": P(),Q()
75850     GOTO 75890
75860     CALL "LBSUB": Q(),P()
75870     CALL "LBCPY": Q(),P()
75880     LET G = S2
75890     CALL "LBTOF": P(),F,G,0,R3,R2,R1,R0,V
75900     GOTO 75920
75910     CALL "FEPCK": 0,4,0,0,R3,R2,R1,R0
75920 SUBEND
75930 SUB "FEADD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = A+B
75932     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y
75934     IF Y = 1 THEN 75970 ' a NaN operand, propagated
75940     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
75950     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
75960     CALL "FEADS": S1,K1,M1,E1,S2,K2,M2,E2,R3,R2,R1,R0
75970 SUBEND
75980 SUB "FESUB": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = A-B
75982     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y ' before the sign flip of B
75984     IF Y = 1 THEN 76020
75990     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
76000     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
76010     CALL "FEADS": S1,K1,M1,E1,1-S2,K2,M2,E2,R3,R2,R1,R0
76020 SUBEND
76030 SUB "FEMUL": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = A*B
76040     DIM P(8),Q(8),C(8)
76042     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y
76044     IF Y = 1 THEN 76270
76050     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
76060     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
76070     LET G = 0
76080     IF S1 = S2 THEN 76100
76090     LET G = 1
76100     LET K = 4
76110     IF K1 = 4 THEN 76260
76120     IF K2 = 4 THEN 76260
76130     IF K1 <> 3 THEN 76170
76140     IF K2 = 0 THEN 76260 ' inf * 0
76150     LET K = 3
76160     GOTO 76260
76170     IF K2 <> 3 THEN 76210
76180     IF K1 = 0 THEN 76260
76190     LET K = 3
76200     GOTO 76260
76210     CALL "LBSET": P(),M1
76220     CALL "LBSET": Q(),M2
76230     CALL "LBMUL": P(),Q(),C() ' exact product, < 2^106
76240     CALL "LBTOF": C(),E1+E2,G,0,R3,R2,R1,R0,V
76250     GOTO 76270
76260     CALL "FEPCK": G,K,0,0,R3,R2,R1,R0
76270 SUBEND
76280 SUB "FEDIV": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = A/B
76290     DIM P(16),Q(16),Z(16)
76292     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y
76294     IF Y = 1 THEN 76640
76300     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
76310     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
76320     LET G = 0
76330     IF S1 = S2 THEN 76350
76340     LET G = 1
76350     LET K = 4
76360     IF K1 = 4 THEN 76630
76370     IF K2 = 4 THEN 76630
76380     IF K1 <> 3 THEN 76420
76390     IF K2 = 3 THEN 76630 ' inf / inf
76400     LET K = 3
76410     GOTO 76630
76420     LET K = 0
76430     IF K2 = 3 THEN 76630 ' finite / inf = 0
76440     IF K2 <> 0 THEN 76490
76450     LET K = 4
76460     IF K1 = 0 THEN 76630 ' 0 / 0
76470     LET K = 3 ' x / 0 = inf
76480     GOTO 76630
76490     LET K = 0
76500     IF K1 = 0 THEN 76630
76510     CALL "LBSET": P(),M1
76520     CALL "LBSET": Q(),M2
76530     CALL "LBLEN": P(),N1
76540     CALL "LBLEN": Q(),N2
76550     LET D = 55+N2-N1 ' quotient >= 2^54: a guard bit at least
76560     CALL "LBSHL": P(),D
76570     CALL "LBDIV": P(),Q(),Z()
76580     LET T = 0
76590     IF P(0) = 0 THEN 76610
76600     LET T = 1
76610     CALL "LBTOF": Z(),E1-E2-D,G,T,R3,R2,R1,R0,V
76620     GOTO 76640
76630     CALL "FEPCK": G,K,0,0,R3,R2,R1,R0
76640 SUBEND
76650 SUB "FESQR": A3,A2,A1,A0,R3,R2,R1,R0 ' R = sqrt(A)
76660     DIM P(16),Q(16)
76662     CALL "FEQNP": A3,A2,A1,A0,0,0,0,0,1,R3,R2,R1,R0,Y
76664     IF Y = 1 THEN 76920
76670     CALL "FEUNP": A3,A2,A1,A0,S,K,M,E
76690     IF K <> 0 THEN 76750
76700     LET R3 = A3 ' sqrt(+-0) = +-0
76710     LET R2 = A2
76720     LET R1 = A1
76730     LET R0 = A0
76740     GOTO 76920
76750     IF S = 1 THEN 76910
76760     IF K <> 3 THEN 76790
76770     CALL "FEPCK": 0,3,0,0,R3,R2,R1,R0
76780     GOTO 76920
76790     CALL "LBSET": P(),M
76800     CALL "LBLEN": P(),N
76810     LET D = 109-N ' P*2^D has >= 109 bits: root >= 2^54
76820     IF (E-D)/2 = INT((E-D)/2) THEN 76840
76830     LET D = D+1
76840     CALL "LBSHL": P(),D
76850     CALL "LBSQR": P(),Q()
76860     LET T = 0
76870     IF P(0) = 0 THEN 76890
76880     LET T = 1
76890     CALL "LBTOF": Q(),(E-D)/2,0,T,R3,R2,R1,R0,V
76900     GOTO 76920
76910     CALL "FEPCK": 0,4,0,0,R3,R2,R1,R0
76920 SUBEND
76930 SUB "FENEG": A3,A2,A1,A0,R3,R2,R1,R0 ' sign flip
76940     LET T = A3+32768
76950     IF T < 65536 THEN 76970
76960     LET T = T-65536
76970     LET R3 = T
76980     LET R2 = A2
76990     LET R1 = A1
77000     LET R0 = A0
77010 SUBEND
77020 SUB "FECMP": A3,A2,A1,A0,B3,B2,B1,B0,C ' C = -1/0/1, 2 if unordered
77030     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
77040     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
77050     LET D = 2
77060     IF K1 = 4 THEN 77150
77070     IF K2 = 4 THEN 77150
77080     LET D = 0
77090     IF K1+K2 = 0 THEN 77150 ' +0 = -0
77100     LET D = S2-S1
77110     IF S1 <> S2 THEN 77150
77120     CALL "LMCMP": A3-S1*32768,A2,A1,A0,B3-S2*32768,B2,B1,B0,D ' magnitudes order as patterns
77130     IF S1 = 0 THEN 77150
77140     LET D = -D
77150     LET C = D
77160 SUBEND
77170 SUB "FEMDS": X,Y,D,R ' internal: exact X mod Y, doubled D times
77180     LET V = X
77190     LET W = Y
77200     LET Z = 0
77210     LET P = 65536*65536*65536*16 ' 2^52
77220     FOR J = 1 TO 53
77230         LET B = 0
77240         IF V < P THEN 77270
77250         LET B = 1
77260         LET V = V-P
77270         LET U = W-Z-B ' 2Z+B >= W exactly when Z >= U
77280         IF Z >= U THEN 77310
77290         LET Z = Z+Z+B
77300         GOTO 77320
77310         LET Z = Z-U
77320         LET P = P/2
77330     NEXT J
77340     FOR J = 1 TO D
77350         LET U = W-Z
77360         IF Z >= U THEN 77390
77370         LET Z = Z+Z
77380         GOTO 77400
77390         LET Z = Z-U
77400     NEXT J
77410     LET R = Z
77420 SUBEND
77430 SUB "FEFMD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = fmod(A,B), exact
77432     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y
77434     IF Y = 1 THEN 77710
77440     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
77450     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
77460     IF K1 >= 3 THEN 77700
77470     IF K2 = 4 THEN 77700
77480     IF K2 = 0 THEN 77700
77490     IF K2 = 3 THEN 77650
77500     IF K1 = 0 THEN 77650
77510     CALL "LMCMP": A3-S1*32768,A2,A1,A0,B3-S2*32768,B2,B1,B0,C
77520     IF C < 0 THEN 77650 ' |A| < |B|: A
77530     IF E1 < E2 THEN 77570
77540     CALL "FEMDS": M1,M2,E1-E2,Z ' |A| mod |B| = (M1*2^(E1-E2) mod M2) * 2^E2
77550     LET F = E2
77560     GOTO 77630
77570     LET W = M2
77580     FOR J = 1 TO E2-E1
77590         LET W = W*2 ' <= M1 < 2^53, since |B| <= |A|
77600     NEXT J
77610     CALL "FEMDS": M1,W,0,Z
77620     LET F = E1
77630     CALL "FEPCK": S1,0,Z,F,R3,R2,R1,R0 ' exact; a zero keeps the sign of A
77640     GOTO 77710
77650     LET R3 = A3
77660     LET R2 = A2
77670     LET R1 = A1
77680     LET R0 = A0
77690     GOTO 77710
77700     CALL "FEPCK": 0,4,0,0,R3,R2,R1,R0
77710 SUBEND
77720 SUB "FEMOD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0 ' R = A % B (LANGUAGE 6.6)
77730     CALL "FEUNP": A3,A2,A1,A0,S1,K1,M1,E1
77740     CALL "FEUNP": B3,B2,B1,B0,S2,K2,M2,E2
77750     IF K2 = 0 THEN 77870 ' b == 0 -> a
77752     CALL "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,2,R3,R2,R1,R0,Y
77754     IF Y = 1 THEN 77930
77760     IF K1 >= 3 THEN 77920
77770     IF K2 = 4 THEN 77920
77780     CALL "FEFMD": A3,A2,A1,A0,B3,B2,B1,B0,Y3,Y2,Y1,Y0
77790     IF Y3-S1*32768+Y2+Y1+Y0 = 0 THEN 77820 ' r = 0: kept
77800     IF S1 = S2 THEN 77820
77810     CALL "FEADD": Y3,Y2,Y1,Y0,B3,B2,B1,B0,Y3,Y2,Y1,Y0 ' r + b
77820     LET R3 = Y3
77830     LET R2 = Y2
77840     LET R1 = Y1
77850     LET R0 = Y0
77860     GOTO 77930
77870     LET R3 = A3
77880     LET R2 = A2
77890     LET R1 = A1
77900     LET R0 = A0
77910     GOTO 77930
77920     CALL "FEPCK": 0,4,0,0,R3,R2,R1,R0
77930 SUBEND
77940 SUB "FEFRI": I3,I2,I1,I0,R3,R2,R1,R0,X ' i64 -> f64, X = 1 inexact
77950     DIM P(8)
77960     LET G = INT(I3/32768)
77970     LET C3 = I3
77980     LET C2 = I2
77990     LET C1 = I1
78000     LET C0 = I0
78010     IF G = 0 THEN 78030
78020     CALL "LMSUB": 0,0,0,0,I3,I2,I1,I0,C3,C2,C1,C0,W
78030     CALL "LBLMB": C3,C2,C1,C0,P()
78040     CALL "LBTOF": P(),0,G,0,R3,R2,R1,R0,V
78050     LET X = V
78060 SUBEND
78070 SUB "FETOI": A3,A2,A1,A0,R3,R2,R1,R0,E ' f64 -> i64; E 1 not integral/finite, 2 out of range
78080     DIM P(80)
78090     CALL "FEUNP": A3,A2,A1,A0,S,K,M,F
78100     LET Z = 1
78110     IF K >= 3 THEN 78340
78120     CALL "LBSET": P(),M
78130     IF F < 0 THEN 78160
78140     CALL "LBSHL": P(),F
78150     GOTO 78180
78160     CALL "LBSHR": P(),-F,T
78170     IF T = 1 THEN 78340 ' a fraction
78180     LET Z = 2
78190     CALL "LBLEN": P(),N
78200     IF N <= 63 THEN 78250
78210     IF N > 64 THEN 78340
78220     IF S = 0 THEN 78340
78230     IF P(4) <> 32768 THEN 78340
78240     IF P(3)+P(2)+P(1) > 0 THEN 78340 ' only -2^63 has 64 bits
78250     CALL "LBTOL": P(),Y3,Y2,Y1,Y0
78260     IF S = 0 THEN 78280
78270     CALL "LMSUB": 0,0,0,0,Y3,Y2,Y1,Y0,Y3,Y2,Y1,Y0,W
78280     LET R3 = Y3
78290     LET R2 = Y2
78300     LET R1 = Y1
78310     LET R0 = Y0
78320     LET E = 0
78330     GOTO 78390
78340     LET R3 = 0
78350     LET R2 = 0
78360     LET R1 = 0
78370     LET R0 = 0
78380     LET E = Z
78390 SUBEND
78400 SUB "FETON": A3,A2,A1,A0,N,E ' f64 -> Baysick number; E 1 inf/NaN; not for folds
78410     CALL "FEUNP": A3,A2,A1,A0,S,K,M,F
78420     IF K < 3 THEN 78460
78430     LET N = 0
78440     LET E = 1
78450     GOTO 78680
78460     LET V = M ' V = M*2^F: every intermediate value is exact
78470     LET H = 1/65536
78480     IF F < 16 THEN 78520
78490     LET V = V*65536
78500     LET F = F-16
78510     GOTO 78480
78520     IF F < 1 THEN 78560
78530     LET V = V*2
78540     LET F = F-1
78550     GOTO 78520
78560     IF F > -16 THEN 78600
78570     LET V = V*H
78580     LET F = F+16
78590     GOTO 78560
78600     IF F > -1 THEN 78640
78610     LET V = V/2
78620     LET F = F+1
78630     GOTO 78600
78640     IF S = 0 THEN 78660
78650     LET V = -V
78660     LET N = V
78670     LET E = 0
78680 SUBEND
78690 SUB "FEFRN": N,R3,R2,R1,R0 ' Baysick number -> f64; zero gives +0; not for folds
78700     DIM P(4)
78710     LET V = ABS(N)
78720     LET G = 0
78730     IF N >= 0 THEN 78750
78740     LET G = 1
78750     LET F = 0
78760     IF V > 0 THEN 78790
78770     LET G = 0
78780     GOTO 78880
78790     LET Q = 65536*65536*65536*16 ' 2^52
78800     IF V < Q+Q THEN 78840
78810     LET V = V/2 ' exact: V >= 2^53
78820     LET F = F+1
78830     GOTO 78800
78840     IF V >= Q THEN 78880
78850     LET V = V*2 ' exact
78860     LET F = F-1
78870     GOTO 78840
78880     CALL "LBSET": P(),V ' V is now an integer below 2^53
78890     CALL "LBTOF": P(),F,G,0,R3,R2,R1,R0,W
78900 SUBEND
78910 SUB "FEQNP": A3,A2,A1,A0,B3,B2,B1,B0,N,R3,R2,R1,R0,Y ' NaN operand of N (1, 2): R = the first, quieted; Y = 1
78920     LET Y = 0
78930     LET T = A3-INT(A3/32768)*32768 ' A without its sign
78940     IF T < 32752 THEN 79010 ' exponent below 2047
78950     IF T-32752+A2+A1+A0 = 0 THEN 79010 ' an infinity
78960     LET G3 = A3
78970     LET G2 = A2
78980     LET G1 = A1
78990     LET G0 = A0
79000     GOTO 79090
79010     IF N < 2 THEN 79170
79020     LET T = B3-INT(B3/32768)*32768
79030     IF T < 32752 THEN 79170
79040     IF T-32752+B2+B1+B0 = 0 THEN 79170
79050     LET G3 = B3
79060     LET G2 = B2
79070     LET G1 = B1
79080     LET G0 = B0
79090     IF INT(G3/8)/2 <> INT(INT(G3/8)/2) THEN 79110 ' bit 51 already set
79100     LET G3 = G3+8 ' set the quiet bit (bit 51 = bit 3 of the top limb)
79110     LET R3 = G3
79120     LET R2 = G2
79130     LET R1 = G1
79140     LET R0 = G0
79150     LET Y = 1
79170 SUBEND
79200 SUB "FEPOW": M(),X3,X2,X1,X0,Y3,Y2,Y1,Y0,R3,R2,R1,R0 ' R = pow(X,Y) with the runtime's bits (DESIGN 4.10.4)
79205     DIM F(49,3)
79210     CALL "FELD": F(),1,X3,X2,X1,X0
79215     CALL "FELD": F(),2,Y3,Y2,Y1,Y0
79220     CALL "FECLS": X3,X2,X1,X0,K1,S1
79225     CALL "FECLS": Y3,Y2,Y1,Y0,K2,S2
79230     LET G = 0
79235     IF K2 = 0 THEN 79900 ' 1: y = +-0 -> 1.0
79240     IF X3 <> 16368 THEN 79250
79245     IF X2+X1+X0 = 0 THEN 79900 ' 2: x = +1 -> 1.0
79250     IF K1 = 4 THEN 79920 ' 3: a NaN -> NAN
79255     IF K2 = 4 THEN 79920
79260     IF K2 <> 3 THEN 79300
79265     IF X3 <> 49136 THEN 79275 ' 4: y = +-inf
79270     IF X2+X1+X0 = 0 THEN 79900 ' x = -1 -> 1.0
79275     CALL "FECMP": X3-S1*32768,X2,X1,X0,16368,0,0,0,C
79280     IF C = 1-2*S2 THEN 79960 ' |x| < 1 and y = -inf, or |x| > 1 and y = +inf
79285     GOTO 79940
79300     LET E = INT((Y3-S2*32768)/16) ' 5: Q = 0 not an integer, 1 odd, 2 even
79305     LET Q = 0
79310     IF E < 1023 THEN 79400
79315     LET Q = 2
79320     IF E > 1075 THEN 79400
79325     CALL "FEBIT": Y3,Y2,Y1,Y0,1075-E,Z,T
79330     LET Q = 0
79335     IF Z = 0 THEN 79400
79340     LET Q = 2-T
79400     IF K1 <> 0 THEN 79450 ' 6: x = +-0
79405     IF S2 = 0 THEN 79430
79410     IF S1 = 0 THEN 79960
79415     IF Q = 1 THEN 79970
79420     GOTO 79960
79430     IF Q <> 1 THEN 79940
