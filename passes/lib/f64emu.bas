81620     LET L = X0
81625     IF J < 1 THEN 81665
81630     LET S = X0
81635     LET L = X1
81640     IF J < 2 THEN 81665
81645     LET S = S+X1
81650     LET L = X2
81655     IF J < 3 THEN 81665
81657     LET S = S+X2
81660     LET L = X3
81665     LET P = 1
81670     LET I = 0
81675     IF I >= W THEN 81690
81680     LET P = P+P
81682     LET I = I+1
81685     GOTO 81675
81690     LET U = INT(L/P)
81692     LET Z = 0
81694     IF S+L-U*P > 0 THEN 81698
81696     LET Z = 1
81698     LET T = U-INT(U/2)*2
