72950     LET W2 = INT(M/H)
72955     LET M = M-W2*H
72960     LET W1 = INT(M/65536)
72965     LET W0 = M-W1*65536
72970     LET W3 = W3+S
72975     LET R3 = W3
72980     LET R2 = W2
72985     LET R1 = W1
72990     LET R0 = W0
72995     LET V = I
73000 SUBEND
