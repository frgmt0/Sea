72710 SUB "LBTOF": B(),X,G,T,R3,R2,R1,R0,V ' round (-1)^G*(B+sticky T)*2^X to binary64; V 0 exact, 1 inexact, 2 overflow
72715     CALL "LBLEN": B(),N
