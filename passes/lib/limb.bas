72770     IF L >= -1074 THEN 72780
72775     LET L = -1074
72780     LET D = L-X ' low bits of B below the last place
72785     IF D > 0 THEN 72820
72790     CALL "LBFLD": B(),0,N,M
72795     FOR J = 1 TO -D
72800         LET M = M*2
72805     NEXT J
72810     LET I = Z
