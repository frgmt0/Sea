# w4_heat_plate.struct -- written from workloads/w4_heat_plate.m and DESIGN.md 2.14.9; never from
# the Sea output.
file output/w4_heat_plate.svg
canvas 960 720
heading W4 heat plate
panels 3
panel 0
title Temperature [degC]
xlabel x [m]
ylabel y [m]
ylabel2 -
count image 1
count colorbar 1
count contour 1
count legend 0
panel 1
title Centerline profiles
xlabel Position [m]
ylabel T [degC]
