count line 2
legend horizontal centerline
legend vertical centerline
panel 2
title~ Balance error -?[0-9]\.[0-9]{2}e[-+][0-9]{2} W
xlabel -
ylabel Heat flow into plate [W]
ylabel2 -
count bars 1
count legend 0
