# w7_drivetrain.struct -- written from workloads/w7_drivetrain.m and DESIGN.md 2.14.9; never from
# the Sea output. The three CVTs are cvt.name = Stock, Launch, Overdrive (script line 83).
file output/w7_drivetrain.svg
canvas 960 720
heading W7 drivetrain
panels 4
panel 0
title Acceleration run
xlabel Gearbox reduction [-]
ylabel~ Time to [0-9]+ m \[s\]
ylabel2 -
count line 3
count markers 3
legend Stock
legend Launch
legend Overdrive
panel 1
title Steady-state top speed
xlabel Gearbox reduction [-]
ylabel Top speed [m/s]
ylabel2 -
count line 3
legend Stock
legend Launch
legend Overdrive
panel 2
title~ Stock CVT, G = [0-9]+\.[0-9]{2}
xlabel Time [s]
ylabel Speed [m/s]
ylabel2 -
count line 1
count legend 0
panel 3
title~ [0-9]+ feasible gear designs
xlabel Rank
ylabel Blank volume [cm^3]
ylabel2 -
count line 1
count legend 0
