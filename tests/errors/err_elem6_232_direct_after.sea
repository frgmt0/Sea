// err_elem6_232_direct_after -- 232 at the first call, in source order, of an elemental function to itself (LANGUAGE.md 8.5; DESIGN.md
// the same program with an earlier error of seacheck (the first statement, `let early: i64 = 1.5`):
// in source order the earlier one is reported (DESIGN.md 2.6.2 "Order across the two programs", L-cq)
let early: i64 = 1.5
elemental fn f(x: f64) -> f64 {
    if x > 0.0 {
        return f(x - 1.0)
    }
    return f(x + 1.0)
}
