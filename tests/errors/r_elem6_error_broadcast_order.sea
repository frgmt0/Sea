// r_elem6_error_broadcast_order -- the first failing element of a .col/.row broadcast is in column-major order (LANGUAGE.md 8.5, 6.3): the
// products x * y are 10, 20 (x = 2, y = 10), 20 (x = 1, y = 20), ...; the test x * y == 20 first holds at
// (1, 0), x = 2 and y = 10; a row-major scan would meet x = 1 and y = 20
elemental fn gate(x: f64, y: f64) -> f64 {
    if x * y == 20.0 {
        error("bad %g %g", x, y)
    }
    return x * y
}
let a = [1.0, 2.0]
let b = [10.0, 20.0, 30.0]
let R = gate(a.col, b.row)
