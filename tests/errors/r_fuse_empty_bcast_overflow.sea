// r_fuse_empty_bcast_overflow -- a failing node below an empty broadcast space (DESIGN.md 2.12.4 F1 (2)): `f64(a * 2) + z` with a an i64[1,3] whose
// first element overflows and z an f64[0,1] (result 0 x 3): the loop of a * 2 runs over its own 3 elements first
let a = [4611686018427387904, 1, 2].row
let z = zeros(0, 1)
printf("start %d %d\n", rows(z), cols(a))
let r = f64(a * 2) + z
printf("%d\n", rows(r))
