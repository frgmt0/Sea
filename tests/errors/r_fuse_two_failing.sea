// r_fuse_two_failing -- two failing nodes (DESIGN.md 2.12.2 (2), F1 (2)): `idiv(a, b) + idiv(c, d)`; the first loop overflows at element 1
// (idiv(-2^63, -1)) before the second divides by zero at element 0: `integer overflow` at the first call's line
let a: i64[] = [7, -9223372036854775807 - 1, 3]
let b: i64[] = [2, -1, 1]
let c: i64[] = [1, 2, 3]
let d: i64[] = [0, 1, 1]
printf("start %d\n", a[0] + d[0])
let r = (idiv(a, b)
    + idiv(c, d))
printf("%d\n", r[0])
