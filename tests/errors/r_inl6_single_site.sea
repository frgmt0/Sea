// r_inl6_single_site -- a run-time error inside a single-site inlined function with a loop reports the callee's line, not the call's
// (DESIGN.md 3.6.4 "Sites": inlined code keeps its own sites; LANGUAGE.md 9.2, 5.4)
fn scan(v: i64[]) -> i64 {
    var s = 0
    for k in 0..4 {
        s += v[k]
    }
    return s
}
let a: i64[] = [1, 2, 3]
printf("start\n")
printf("%d\n", scan(a))
