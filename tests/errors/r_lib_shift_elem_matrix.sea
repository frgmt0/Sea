// r_lib_shift_elem_matrix -- a matrix of counts: increasing linear order is column-major (LANGUAGE.md 4.5, 10.14, 8.5):
// [1, 64; 70, 2] holds 1, 70, 64, 2 in linear order, so 70 is reported (row-major order would give 64)
let n: i64[,] = [1, 64; 70, 2]
let a: i64[,] = [5, 6; 7, 8]
printf("start\n")
let r = shr(a, n)
printf("never %d\n", r[0, 0])
