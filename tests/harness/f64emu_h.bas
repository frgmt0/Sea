10 REM f64emu harness (tests/arith_check.sh): reads tests/vectors/f64emu.txt on standard input and
20 REM prints every vector with its results recomputed by passes/lib/f64emu.bas.
30 DIM F$(9)
40 IF END #0 THEN 830
50 LINPUT #0, L$
60 GOSUB 720
70 LET O$ = F$(1)
80 IF O$ = "fri" THEN 620
100 CALL "LMRF": F$(2),A3,A2,A1,A0,E
110 LET P$ = F$(1) & " " & F$(2) & " "
120 IF O$ = "sqrt" THEN 400
130 IF O$ = "neg" THEN 420
140 IF O$ = "cls" THEN 490
150 IF O$ = "toi" THEN 520
160 IF O$ = "ton" THEN 560
170 CALL "LMRF": F$(3),B3,B2,B1,B0,E
180 LET P$ = P$ & F$(3) & " "
190 IF O$ = "add" THEN 280
200 IF O$ = "sub" THEN 300
210 IF O$ = "mul" THEN 320
220 IF O$ = "div" THEN 340
230 IF O$ = "fmod" THEN 360
240 IF O$ = "mod" THEN 380
250 IF O$ = "cmp" THEN 460
260 PRINT "unknown vector: " & L$
270 GOTO 40
280 CALL "FEADD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
290 GOTO 430
300 CALL "FESUB": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
310 GOTO 430
320 CALL "FEMUL": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
330 GOTO 430
340 CALL "FEDIV": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
350 GOTO 430
360 CALL "FEFMD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
370 GOTO 430
380 CALL "FEMOD": A3,A2,A1,A0,B3,B2,B1,B0,R3,R2,R1,R0
390 GOTO 430
400 CALL "FESQR": A3,A2,A1,A0,R3,R2,R1,R0
410 GOTO 430
420 CALL "FENEG": A3,A2,A1,A0,R3,R2,R1,R0
430 CALL "LMHEX": R3,R2,R1,R0,R$
440 PRINT P$ & R$
450 GOTO 40
460 CALL "FECMP": A3,A2,A1,A0,B3,B2,B1,B0,C
470 PRINT P$ & STR$(C)
480 GOTO 40
490 CALL "FECLS": A3,A2,A1,A0,K,S
500 PRINT P$ & STR$(K) & " " & STR$(S)
510 GOTO 40
520 CALL "FETOI": A3,A2,A1,A0,R3,R2,R1,R0,E
530 CALL "LMHEX": R3,R2,R1,R0,R$
540 PRINT P$ & R$ & " " & STR$(E)
550 GOTO 40
560 REM to a Baysick number and back
570 CALL "FETON": A3,A2,A1,A0,X,E
580 CALL "FEFRN": X,R3,R2,R1,R0
590 CALL "LMHEX": R3,R2,R1,R0,R$
600 PRINT P$ & STR$(E) & " " & R$
610 GOTO 40
620 CALL "LMRF": F$(2),A3,A2,A1,A0,E
630 CALL "FEFRI": A3,A2,A1,A0,R3,R2,R1,R0,X
640 CALL "LMHEX": R3,R2,R1,R0,R$
650 PRINT "fri " & F$(2) & " " & R$ & " " & STR$(X)
660 GOTO 40
720 LET N = 0
730 LET P = 1
740 LET Q = POS(L$," ",P)
750 IF Q = 0 THEN 800
760 LET N = N+1
770 LET F$(N) = SEG$(L$,P,Q-1)
780 LET P = Q+1
790 GOTO 740
800 LET N = N+1
810 LET F$(N) = SEG$(L$,P,LEN(L$))
820 RETURN
830 STOP
