fn mk(a: f64) -> f64[2] {
    var r = [a, a]
    for k in 0..2 {
        r[k] = r[k] + 1.0
    }
    return r
}
let p = mk(1.5)
let q = mk(0.5)
printf("%g %g\n", p[1], q[0])
