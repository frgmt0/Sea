var a = ones(2)
a[1] = 3.0
let v = [a, 5.0, a]
var M = ones(2, 1)
M[1, 0] = 2.0
let W = [M, M]
printf("%g %g %d %g %d\n", v[2], v[4], len(v), W[1, 1], cols(W))
