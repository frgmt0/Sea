ci 0:1:9 3 3
bind 0:1:1 1
lv 0:1:25 3 1
lib 0:1:20 10 ones 1
bind 0:1:12 2
lv 0:2:19 10 2
ci 0:2:21 3 2
idx 0:2:19 4 1
fconv 0:2:8 1 - - - g
ftext 0:2:8 1 %20
lv 0:2:29 10 2
lib 0:2:25 3 len 1
fconv 0:2:8 1 - - - d
ftext 0:2:8 1 %0A
fmt 0:2:8 1 4
lib 0:2:1 1 printf 1
eval 0:2:1
block 0:1:1 3
end
