var T = mk()
var j = 1
var i = 0
let tn = 2.5
fn mk() -> f64[,] {
    var A = zeros(2, 2)
    for k in 0..2 {
        A[k, k] = 1.0
    }
    return A
}
T[j, i] = tn
printf("%g\n", T[1, 0])
let U = mk()
printf("%g\n", U[1, 0])
