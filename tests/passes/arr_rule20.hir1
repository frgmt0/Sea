#sea 1
#target arm64-macos
#file arr_rule20.sea
tvec 10 4
tvec 11 3
fn 1 .main main 1 0 1 0:1:1
loc a 10 var 0:1:5
ci 0:1:15 3 5
lib 0:1:9 10 zeros 1
bind 0:1:1 1
lv 0:2:1 10 1
ci 0:2:3 3 2
idx 0:2:1 4 1
cf 0:2:8 4 #4000000000000000
asg 0:2:1 set
lv 0:3:1 10 1
ci 0:3:3 3 3
idx 0:3:1 4 1
cf 0:3:8 4 #4008000000000000
asg 0:3:1 set
lv 0:4:21 10 1
call 0:4:16 4 2 1
fconv 0:4:8 1 - - - g
ftext 0:4:8 1 %0A
fmt 0:4:8 1 2
lib 0:4:1 1 printf 1
eval 0:4:1
ci 0:5:26 3 5
lib 0:5:21 10 ones 1
call 0:5:16 4 2 1
fconv 0:5:8 1 - - - g
ftext 0:5:8 1 %0A
fmt 0:5:8 1 2
lib 0:5:1 1 printf 1
eval 0:5:1
block 0:1:1 5
end
fn 2 pick fn 4 1 3 0:29:1
par u 10 val
loc u1 10 let 0:30:9
loc s 4 var 0:31:9
loc x 4 for 0:32:9
lv 0:30:14 10 1
ci 0:30:16 3 0
dol 0:30:19 3 0
ci 0:30:26 3 2
rng 0:30:16 11 0 1
idx 0:30:14 10 1
bind 0:30:5 2
cf 0:31:13 4 #0000000000000000
bind 0:31:5 3
lv 0:32:14 10 2
lv 0:33:9 4 3
lv 0:33:14 4 4
asg 0:33:9 add
block 0:32:17 1
fore 0:32:5 4
lv 0:35:12 4 3
ret 0:35:5 1
block 0:29:26 4
end
#end
