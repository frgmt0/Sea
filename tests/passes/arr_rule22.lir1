#sea 1
#target arm64-macos
#file arr_rule22.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
li i1 3
li i2 1
li i3 1
li i4 1
rcall sea_arr_new_u 0:9 1 p5 4 i2 i3 i1 i4
lf f6 #3FF0000000000000
ldp p7 p5 - 0 40
li i8 0
icmp gt i9 i1 i8
if 1 i9
li i10 1
isub i11 i1 i10
loop 2 i12 i8 i11 i10
stf f6 p7 i12 8 0
endloop 2
endif 1
call twice 1 f13 1 p5
release p5
sa p14 s1
stf f13 p14 - 0 0
la p15 d1
rcall sea_printf 0:9 0 2 p15 p14
li i16 2
li i17 1
li i18 1
li i19 1
rcall sea_arr_new 0:10 1 p20 4 i17 i18 i16 i19
call twice 1 f21 1 p20
release p20
sa p22 s2
stf f21 p22 - 0 0
la p23 d2
rcall sea_printf 0:10 0 2 p23 p22
ret 0
endfunc
func twice fn 0:1:1 1 p1 1 f
lf f2 #4000000000000000
ldi i3 p1 - 0 16
li i4 1
li i5 1
li i6 1
rcall sea_arr_new_u 0:2 1 p7 4 i4 i5 i3 i6
ldp p8 p7 - 0 40
ldp p9 p1 - 0 40
li i10 0
icmp gt i11 i3 i10
if 1 i11
li i12 1
isub i13 i3 i12
loop 2 i14 i10 i13 i12
ldf f15 p9 i14 8 0
fmul f16 f15 f2
stf f16 p8 i14 8 0
endloop 2
endif 1
lf f17 #0000000000000000
mov p18 p7
retain p18
ldi i19 p18 - 0 16
li i20 0
icmp gt i21 i19 i20
if 3 i21
ldp p22 p18 - 0 40
li i23 1
isub i24 i19 i23
loop 4 i25 i20 i24 i23
ldf f26 p22 i25 8 0
fadd f17 f17 f26
endloop 4
endif 3
release p18
release p7
ret 1 f17
endfunc
fmt d1 2
fconv - - - g f
ftext %0A
fmt d2 2
fconv - - - g f
ftext %0A
#end
