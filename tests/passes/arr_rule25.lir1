#sea 1
#target arm64-macos
#file arr_rule25.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
li i1 3
call hist 1 i2 1 i1
sa p3 s1
sti i2 p3 - 0 0
la p4 d1
rcall sea_printf 0:11 0 2 p4 p3
li i5 0
call hist 1 i6 1 i5
sa p7 s2
sti i6 p7 - 0 0
la p8 d2
rcall sea_printf 0:12 0 2 p8 p7
ret 0
endfunc
func hist fn 0:1:1 1 i1 1 i
li i2 0
li i3 1
rcount i4 i5 i2 i1 i3 1 0:4
li i6 1
iadd i7 i4 i6
li i8 0
isel i9 i5 i7 i8
li i10 #000000007FFFFFFE
icmp gt i11 i4 i10
icmp lt i12 i4 i8
ior i13 i11 i12
iand i13 i13 i5
li i14 #7FFFFFFFFFFFFFFF
icmp eq i15 i4 i14
ior i15 i15 i12
isel i16 i15 i14 i7
chk i13 ARRAY_SIZE 0:4 1 i16
li i17 2
li i18 1
li i19 1
rcall sea_arr_new_u 0:4 1 p20 4 i17 i18 i9 i19
ldp p21 p20 - 0 40
li i22 0
li i23 1
if 1 i5
loop 2 i24 i2 i4 i3
sti i24 p21 i22 8 0
iadd i22 i22 i23
endloop 2
endif 1
li i25 0
mov p26 p20
retain p26
ldi i27 p26 - 0 16
li i28 0
icmp gt i29 i27 i28
if 3 i29
ldp p30 p26 - 0 40
li i31 1
isub i32 i27 i31
loop 4 i33 i28 i32 i31
ldi i34 p30 i33 8 0
iaddc i25 i25 i34 0:7
endloop 4
endif 3
release p26
release p20
ret 1 i25
endfunc
fmt d1 2
fconv - - - d i
ftext %0A
fmt d2 2
fconv - - - d i
ftext %0A
#end
