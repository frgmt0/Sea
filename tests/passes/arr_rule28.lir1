#sea 1
#target arm64-macos
#file arr_rule28.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
li i1 2
li i2 3
li i3 1
li i4 2
rcall sea_arr_new 0:10 1 p5 4 i3 i4 i1 i2
lf f6 #401E000000000000
li i7 0
li i8 2
ldi i9 p5 - 0 16
chkb i7 i9 0 0:11
ldi i10 p5 - 0 24
chkb i8 i10 1 0:11
ldi i11 p5 - 0 0
li i12 1
icmp ne i13 i11 i12
if 1 i13
rcall sea_arr_unique 0:11 1 p14 1 p5
mov p5 p14
endif 1
ldp p15 p5 - 0 40
imul i16 i8 i9
iadd i17 i7 i16
stf f6 p15 i17 8 0
li i18 4
call flat_at 1 f19 2 p5 i18
sa p20 s1
stf f19 p20 - 0 0
la p21 d1
rcall sea_printf 0:12 0 2 p21 p20
li i22 1
call flat_at 1 f23 2 p5 i22
sa p24 s2
stf f23 p24 - 0 0
la p25 d2
rcall sea_printf 0:13 0 2 p25 p24
release p5
ret 0
endfunc
func flat_at fn 0:1:1 2 p1 i2 1 f
ldi i3 p1 - 0 16
ldi i4 p1 - 0 24
imul i5 i3 i4
chkb i2 i5 0 0:3
ldp p6 p1 - 0 40
ldf f7 p6 i2 8 0
mov f8 f7
li i9 0
li i10 1
rcount i11 i12 i9 i2 i10 0 0:5
if 1 i12
loop 2 i13 i9 i11 i10
lf f14 #3FF0000000000000
fadd f8 f8 f14
endloop 2
endif 1
ret 1 f8
endfunc
fmt d1 2
fconv - - - g f
ftext %0A
fmt d2 2
fconv - - - g f
ftext %0A
#end
