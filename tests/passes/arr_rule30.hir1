#sea 1
#target arm64-macos
#file arr_rule30.sea
tvec 10 4
fn 1 .main main 1 0 0 0:1:1
ci 0:7:11 3 3
lib 0:7:6 10 ones 1
call 0:7:1 1 2 1
eval 0:7:1
ci 0:8:12 3 0
lib 0:8:6 10 zeros 1
call 0:8:1 1 2 1
eval 0:8:1
block 0:1:1 2
end
fn 2 walk fn 1 1 1 0:2:1
par v 10 val
loc x 4 for 0:3:9
lv 0:3:14 10 1
block 0:3:16 0
fore 0:3:5 2
ftext 0:5:12 1 walked%20
lv 0:5:31 10 1
lib 0:5:27 3 len 1
fconv 0:5:12 1 - - - d
ftext 0:5:12 1 %0A
fmt 0:5:12 1 3
lib 0:5:5 1 printf 1
eval 0:5:5
block 0:2:19 2
end
#end
