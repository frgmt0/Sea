rcall sea_arr_unique 0:13 1 p19 1 p5
mov p5 p19
endif 3
ldp p20 p5 - 0 40
stf f14 p20 i11 8 0
endloop 2
endif 1
retain p5
release p5
ret 1 p5
endfunc
func f fn 0:17:1 1 p1 0
li i2 0
li i3 2
li i4 1
rcount i5 i6 i2 i3 i4 0 0:18
if 1 i6
