#sea 1
#target arm64-macos
#file elem6_vec.sea
tvec 10 4
fn 1 .main main 1 0 3 0:1:1
loc v 10 let 0:7:5
loc w 10 let 0:8:5
loc s 4 let 0:9:5
ci 0:7:15 3 3
lib 0:7:9 10 zeros 1
bind 0:7:1 1
lv 0:8:11 10 1
cf 0:8:14 4 #4000000000000000
call 0:8:9 10 2 2
bind 0:8:1 2
cf 0:9:11 4 #3FE0000000000000
cf 0:9:16 4 #4010000000000000
call 0:9:9 4 2 2
bind 0:9:1 3
lv 0:10:19 10 2
ci 0:10:21 3 2
idx 0:10:19 4 1
fconv 0:10:8 1 - - - g
ftext 0:10:8 1 %20
lv 0:10:25 4 3
fconv 0:10:8 1 - - - g
ftext 0:10:8 1 %0A
fmt 0:10:8 1 4
lib 0:10:1 1 printf 1
eval 0:10:1
block 0:1:1 4
end
fn 2 f elem 4 2 0 0:4:1
par x 4 val
par k 4 val
lv 0:5:12 4 1
lv 0:5:16 4 2
bin 0:5:12 4 mul
cf 0:5:20 4 #3FF0000000000000
bin 0:5:12 4 add
ret 0:5:5 1
block 0:4:39 1
end
#end
