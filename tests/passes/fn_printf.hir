#sea 1
#target arm64-macos
#file fn_printf.sea
fn 1 .main main 1 0 3 0:1:1
loc n 3 let 0:5:5
loc x 4 let 0:6:5
loc t 4 let 0:8:5
ci 0:5:9 3 42
bind 0:5:1 1
lv 0:6:13 3 1
lib 0:6:9 4 f64 1
cf 0:6:18 4 #4020000000000000
bin 0:6:9 4 div
bind 0:6:1 2
ftext 0:7:8 1 n=
lv 0:7:34 3 1
fconv 0:7:8 1 - 5 - d
ftext 0:7:8 1 %20x=
lv 0:7:37 4 2
fconv 0:7:8 1 l 8 3 f
ftext 0:7:8 1 %20
cs 0:7:40 5 ok
fconv 0:7:8 1 - - - s
ftext 0:7:8 1 |%25%0A
fmt 0:7:8 1 7
lib 0:7:1 1 printf 1
eval 0:7:1
lib 0:8:9 4 now 0
bind 0:8:1 3
lv 0:9:20 4 2
fconv 0:9:8 1 p - - e
ftext 0:9:8 1 %20
lv 0:9:27 4 2
cf 0:9:31 4 #4020000000000000
bin 0:9:27 4 mul
lib 0:9:23 3 i64 1
fconv 0:9:8 1 - - - d
ftext 0:9:8 1 %0A
fmt 0:9:8 1 4
lib 0:9:1 1 printf 1
eval 0:9:1
ftext 0:10:8 1 done%0A
fmt 0:10:8 1 1
lib 0:10:1 1 printf 1
eval 0:10:1
block 0:1:1 6
end
#end
