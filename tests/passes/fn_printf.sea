// fn_printf -- printf: the fmt/ftext/fconv pieces in HIR (%% already %); in LIR the argument
// slot, one store per argument by class, the fmt and str data records and rcall sea_printf;
// now() is rcall sea_now; f64() and i64() are itof and ftoi (DESIGN.md 3.5.5, 3.6.2,
// 3.6.6 rules 7-10)
let n = 42
let x = f64(n) / 8.0
printf("n=%5d x=%-8.3f %s|%%\n", n, x, "ok")
let t = now()
printf("%+e %d\n", x, i64(x * 8.0))
printf("done\n")
