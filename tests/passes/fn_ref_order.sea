// fn_ref_order -- a read of x evaluated before a call that passes x by ref sees the old value
// (it is copied at its evaluation point), a read after the call sees the new one, and in
// x = g(ref x) the assignment wins over the reload (LANGUAGE.md 6.8 rule 5; DESIGN.md 3.6.6 r12)
fn g(ref s: i64) -> i64 {
    for k in 0..2 {
        s += 5
    }
    return s * 2
}
fn f(a: i64, b: i64) -> i64 {
    var r = b
    for k in 0..3 {
        r += a
    }
    return r
}
var x = 1
var y = 0
y = x + g(ref x)
x += g(ref x)
let z = f(x, g(ref x))
x = g(ref x)
let w = g(ref x) + f(x, 0)
printf("%d %d %d %d\n", x, y, z, w)
