// fuse7_f1_sel_inplace -- DESIGN.md 2.12.4 F1 (3), (4), (5): a selection store whose tree does not
// read the target is stored in place (L6 steps 2-7 after the value's leaf and check phase, the
// element computed in the selection's nest, no result array)
let x: f64[] = [1.0, 2.0]
var v: f64[] = [0.0, 0.0, 0.0]
v[1..3] = x * 2.0 + 1.0
printf("%g %g %g\n", v[0], v[1], v[2])
