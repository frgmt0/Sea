#sea 1
#target arm64-macos
#file std.sea
#file inl_dest.sea
tvec 10 4
fn 1 .main main 1 0 4 1:1:1
loc x 4 var 1:4:5
loc c 2 let 1:6:5
loc y 4 let 1:7:5
loc v 10 var 1:8:5
cf 1:4:19 4 #4020000000000000
call 1:4:14 4 2 1
call 1:4:9 4 2 1
bind 1:4:1 1
lv 1:5:1 4 1
lv 1:5:10 4 1
call 1:5:5 4 2 1
asg 1:5:1 set
lv 1:6:9 4 1
cf 1:6:13 4 #3FF0000000000000
bin 1:6:9 2 gt
bind 1:6:1 2
lv 1:7:12 2 2
lv 1:7:21 4 1
call 1:7:16 4 2 1
cf 1:7:33 4 #0000000000000000
ifx 1:7:9 4
bind 1:7:1 3
ci 1:8:15 3 2
lib 1:8:9 10 zeros 1
bind 1:8:1 4
lv 1:9:1 10 4
lv 1:9:10 10 4
call 1:9:5 10 3 1
asg 1:9:1 set
lv 1:10:10 4 1
rarg 1:10:6 4
call 1:10:1 1 4 1
eval 1:10:1
block 1:1:1 7
end
fn 2 half fn 4 1 0 0:1:1
par x 4 val
lv 0:1:33 4 1
cf 0:1:37 4 #4000000000000000
bin 0:1:33 4 div
ret 0:1:26 1
block 0:1:24 1
end
fn 3 keep fn 10 1 0 0:2:1
par v 10 val
lv 0:2:37 10 1
ret 0:2:30 1
block 0:2:28 1
end
fn 4 setq fn 1 1 0 1:1:1
par q 4 ref
lv 1:2:5 4 1
lv 1:2:14 4 1
call 1:2:9 4 2 1
asg 1:2:5 set
block 1:1:21 1
end
#end
