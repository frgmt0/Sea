#sea 1
#target arm64-macos
#file std.sea
#file inl_half.sea
fn 1 .main main 1 0 1 1:1:1
loc y 4 let 1:1:5
cf 1:1:14 4 #4008000000000000
call 1:1:9 4 2 1
bind 1:1:1 1
block 1:1:1 1
end
fn 2 half fn 4 1 0 0:1:1
par x 4 val
lv 0:1:33 4 1
cf 0:1:37 4 #4000000000000000
bin 0:1:33 4 div
ret 0:1:26 1
block 0:1:24 1
end
#end
