#sea 1
#target arm64-macos
#file std.sea
#file inl_multi.sea
func .main main 1:1:1 0 0
slot s1 8 8
li i1 1
do 1
li i2 1
iaddc i3 i1 i2 1:6
mov i4 i1
mov i5 i3
exit 1
enddo 1
mov i6 i4
li i7 0
sa p8 s1
sti i7 p8 - 0 0
call g 2 i9 i10 1 p8
ldi i7 p8 - 0 0
ret 0
endfunc
func g fn 1:1:1 1 p1 2 i i
lf f2 #0000000000000000
li i3 5
do 1
li i4 1
iaddc i5 i3 i4 1:3
mov i6 i3
mov i7 i5
exit 1
enddo 1
itof f8 i6
mov f2 f8
sti i7 p1 - 0 0
ldi i9 p1 - 0 0
do 2
li i10 1
iaddc i11 i9 i10 1:4
mov i12 i9
mov i13 i11
exit 2
enddo 2
ret 2 i12 i13
endfunc
#end
