#sea 1
#target arm64-macos
#file std.sea
#file inl_owned_arg.sea
tvec 10 4
ttuple 11 2 3 3
fn 1 .main main 1 0 3 1:1:1
loc n 3 let 1:1:5
loc r 3 let 1:2:6
loc c 3 let 1:2:9
ci 1:1:21 3 2
lib 1:1:15 10 zeros 1
call 1:1:9 3 2 1
bind 1:1:1 1
ci 1:2:25 3 3
lib 1:2:19 10 zeros 1
call 1:2:14 11 3 1
tbind 1:2:1 2 2 3
ci 1:3:12 3 4
lib 1:3:6 10 zeros 1
call 1:3:1 10 4 1
eval 1:3:1
block 1:1:1 3
end
fn 2 count fn 3 1 0 0:1:1
par v 10 val
lv 0:2:16 10 1
lib 0:2:12 3 len 1
ret 0:2:5 1
block 0:1:27 1
end
fn 3 dims fn 11 1 0 0:4:1
par v 10 val
lv 0:5:17 10 1
lib 0:5:13 3 len 1
lv 0:5:25 10 1
lib 0:5:21 3 len 1
ci 0:5:30 3 1
bin 0:5:21 3 add
ret 0:5:5 2
block 0:4:33 1
end
fn 4 same fn 10 1 0 0:7:1
par v 10 val
lv 0:8:12 10 1
ret 0:8:5 1
block 0:7:28 1
end
#end
