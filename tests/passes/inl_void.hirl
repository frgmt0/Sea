#sea 1
#target arm64-macos
#file std.sea
#file inl_void.sea
fn 1 .main main 1 0 2 1:1:1
loc .l1 3 let 1:1:1
loc .l2 3 let 1:2:1
ci 1:1:5 3 7
tmp 1:1:1 1
lv 1:1:1 3 1
ci 1:1:1 3 0
bin 1:1:1 2 lt
iret 1:1:1 0
block 1:1:1 1
if 1:1:1 0
lv 1:1:1 3 1
fconv 1:1:1 1 - - - d
ftext 1:1:1 1 %0A
fmt 1:1:1 1 2
lib 1:1:1 1 printf 1
eval 1:1:1
block 1:1:1 2
iblk 1:1:1 1 0
xblk 1:1:1 1 1
eval 1:1:1
ci 1:2:5 3 -1
tmp 1:2:1 2
lv 1:2:1 3 2
ci 1:2:1 3 0
bin 1:2:1 2 lt
iret 1:2:1 0
block 1:2:1 1
if 1:2:1 0
lv 1:2:1 3 2
fconv 1:2:1 1 - - - d
ftext 1:2:1 1 %0A
fmt 1:2:1 1 2
lib 1:2:1 1 printf 1
eval 1:2:1
block 1:2:1 2
iblk 1:2:1 1 0
xblk 1:2:1 1 1
eval 1:2:1
block 1:1:1 2
end
#end
