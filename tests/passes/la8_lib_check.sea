fn g(A: f64[,], Ai: i64[,], b: f64[], F: Lu) -> Chol {
    let M = [4.0, 0.0; 0.0, 4.0]
    let Mi = [4, 0; 0, 4]
    let G: Lu = lu(Ai)
    let C = chol(A)
    let x = solve(F, b)
    let y = solve(C, A)
    let z = solve(Ai, b)
    let r = rcond(G)
    let e = eig_sym(M)
    let e2 = eig_sym(Mi, A)
    printf("%g %g %g %g %g %g\n", x[0], y[0, 0], z[0], r, e[0], e2[0])
    return C
}
