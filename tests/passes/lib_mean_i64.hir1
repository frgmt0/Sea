#sea 1
#target arm64-macos
#file lib_mean_i64.sea
tfvec 10 3 3
fn 1 .main main 1 0 3 0:1:1
loc w 10 let 0:1:5
loc t 3 let 0:2:5
loc m 4 let 0:3:5
ci 0:1:10 3 3
ci 0:1:13 3 5
ci 0:1:16 3 9
row 0:1:10 10 3
arr 0:1:9 10 1
bind 0:1:1 1
lv 0:2:13 10 1
lib 0:2:9 3 sum 1
bind 0:2:1 2
lv 0:3:14 10 1
lib 0:3:9 4 mean 1
bind 0:3:1 3
lv 0:4:19 3 2
fconv 0:4:8 1 - - - d
ftext 0:4:8 1 %20
lv 0:4:22 4 3
fconv 0:4:8 1 - - - g
ftext 0:4:8 1 %0A
fmt 0:4:8 1 4
lib 0:4:1 1 printf 1
eval 0:4:1
block 0:1:1 4
end
#end
