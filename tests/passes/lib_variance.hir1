#sea 1
#target arm64-macos
#file lib_variance.sea
tvec 10 4
fn 1 .main main 1 0 0 0:1:1
ci 0:6:13 3 3
lib 0:6:8 10 ones 1
call 0:6:1 1 2 1
eval 0:6:1
ci 0:7:14 3 0
lib 0:7:8 10 zeros 1
call 0:7:1 1 2 1
eval 0:7:1
block 0:1:1 2
end
fn 2 spread inl 1 1 2 0:1:1
par x 10 val
loc v 4 let 0:2:9
loc d 4 let 0:3:9
lv 0:2:22 10 1
lib 0:2:13 4 variance 1
bind 0:2:5 2
lv 0:3:17 10 1
lib 0:3:13 4 std 1
bind 0:3:5 3
lv 0:4:23 4 2
fconv 0:4:12 1 - - - g
ftext 0:4:12 1 %20
lv 0:4:26 4 3
fconv 0:4:12 1 - - - g
ftext 0:4:12 1 %0A
fmt 0:4:12 1 4
lib 0:4:5 1 printf 1
eval 0:4:5
block 0:1:21 3
end
#end
