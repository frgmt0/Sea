#sea 1
#target arm64-macos
#file lir4_release_leaf.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
slot s3 8 8
li i1 4
li i2 1
li i3 2
li i4 1
rcall sea_arr_new 0:2 1 p5 4 i1 i2 i3 i4
retain p5
call drop 0 1 p5
ldi i6 p5 - 0 0
sa p7 s1
sti i6 p7 - 0 0
la p8 d1
rcall sea_printf 0:3 0 2 p8 p7
call drop 0 1 p5
li i9 7
rcall sea_str_i64 0:4 1 p10 1 i9
sa p11 s2
stp p10 p11 - 0 0
la p12 d2
rcall sea_printf 0:5 0 2 p12 p11
call drop 0 1 p10
sa p13 s3
la p14 d3
rcall sea_printf 0:6 0 2 p14 p13
ret 0
endfunc
func drop fn 0:10:1 1 p1 0
release p1
ret 0
endfunc
fmt d1 3
ftext after%20one%20drop%20
fconv - - - d i
ftext %0A
fmt d2 3
ftext freed%20in%20drop,%20then%20
fconv - - - s p
ftext %0A
fmt d3 1
ftext ok%0A
#end
