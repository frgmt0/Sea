#sea 1
#target arm64-macos
#file lir4_seaopt.sea
func .main main 0:1:1 0 0
la p1 d1
li i2 1
li i3 2
rcall sea_arr_new_s 0:2 1 p4 4 p1 i2 i3 i2
ldp p5 p4 - 0 40
la p6 d2
li i7 16
mcopy p5 p6 i7
release p4
la p8 d3
li i9 3
rcall sea_arr_new_s 0:3 1 p10 4 p8 i3 i2 i9
release p10
ret 0
endfunc
slay d1 8 0
dat d2 i64 2
dvi 7
dvi -7
slay d3 24 2
soff 0
soff 16
#end
