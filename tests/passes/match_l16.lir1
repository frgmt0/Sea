#sea 1
#target arm64-macos
#file match_l16.sea
func .main main 0:1:1 0 0
li i1 5
call scan 0 1 i1
li i2 1
call scan 0 1 i2
ret 0
endfunc
func scan fn 0:4:1 1 i1 0
slot s1 8 8
slot s2 8 8
slot s3 8 8
li i2 0
do 1
icmp lt i3 i2 i1
ifz 2 i3
exit 1
endif 2
do 3
rcall sea_str_i64 0:2 1 p4 1 i2
mov p5 p4
exit 3
enddo 3
la p6 d1
rcall sea_str_cmp - 1 i7 2 p5 p6
li i8 0
icmp eq i9 i7 i8
la p10 d2
rcall sea_str_cmp - 1 i11 2 p5 p10
li i12 0
icmp eq i13 i11 i12
ior i14 i9 i13
if 4 i14
release p5
exit 1
else 4
la p15 d3
rcall sea_str_cmp - 1 i16 2 p5 p15
li i17 0
icmp eq i18 i16 i17
if 5 i18
sa p19 s1
la p20 d4
rcall sea_printf 0:9 0 2 p20 p19
else 5
sa p21 s2
sti i2 p21 - 0 0
la p22 d5
rcall sea_printf 0:10 0 2 p22 p21
endif 5
endif 4
release p5
li i23 1
iaddc i2 i2 i23 0:12
enddo 1
do 6
rcall sea_str_i64 0:2 1 p24 1 i1
mov p25 p24
exit 6
enddo 6
sa p26 s3
la p27 d6
rcall sea_printf 0:15 0 2 p27 p26
release p25
ret 0
endfunc
str d1 2
str d2 9
str d3 0
fmt d4 1
ftext zero%0A
fmt d5 2
fconv - - - d i
ftext %0A
fmt d6 1
ftext end%0A
#end
