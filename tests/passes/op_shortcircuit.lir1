#sea 1
#target arm64-macos
#file op_shortcircuit.sea
func .main main 0:1:1 0 0
li i1 5
li i2 3
call pick 1 i3 2 i1 i2
li i4 2
li i5 2
call pick 1 i6 2 i4 i5
ret 0
endfunc
func pick fn 0:3:1 2 i1 i2 1 i
li i3 0
li i4 0
li i5 1
rcount i6 i7 i4 i1 i5 0 0:5
if 1 i7
loop 2 i8 i4 i6 i5
li i9 1
icmp gt i10 i8 i9
if 3 i10
icmp lt i10 i8 i2
endif 3
if 4 i10
li i11 1
iaddc i3 i3 i11 0:7
endif 4
li i12 0
icmp eq i13 i8 i12
ifz 5 i13
li i14 3
icmp gt i13 i3 i14
endif 5
if 6 i13
li i15 2
imulc i16 i3 i15 0:10
li i17 4
icmp gt i18 i3 i17
if 7 i18
li i19 1
else 7
li i19 0
endif 7
iaddc i3 i16 i19 0:10
endif 6
endloop 2
endif 1
ret 1 i3
endfunc
#end
