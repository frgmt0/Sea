fn eqs(k: i64, n: i64) -> f64 {
    let v = zeros(8)
    let w = zeros(7)
    var s = 0.0
    if k == 5 {
        s = s + v[k]
    }
    s = s + v[k]
    if k != 5 {
        s = s + 1.0
    } else {
        s = s + v[k]
    }
    let q = k != 5 || v[k] > 0.0
    if q {
        s = s + 2.0
    }
    for i in 0..n {
        let j = i % 8
        if j < 0 {
            break
        }
        if j > 7 {
            break
        }
        if j == 7 {
            break
        }
        s = s + w[j]
    }
    return s
}
printf("%g %g\n", eqs(5, 3), eqs(2, 9))
