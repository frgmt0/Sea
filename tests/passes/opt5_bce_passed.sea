fn twice(v: f64[], w: f64[], n: i64) -> f64 {
    var s = 0.0
    for i in 0..n {
        let j = i * 5 % len(v)
        s = s + v[j] * v[j]
        s = s + w[j]
    }
    return s
}
let a = [1.0, 2.0, 3.0]
let b = [4.0, 5.0, 6.0, 7.0]
printf("%g %g\n", twice(a, b, 4), twice(b, b, 2))
