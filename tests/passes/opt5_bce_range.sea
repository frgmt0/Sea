fn fill(n: i64, m: i64) -> f64[] {
    var u = zeros(n)
    for i in 0..n {
        u[i] = 1.5
    }
    for i in 0..=m {
        u[i] = u[i] + 2.0
    }
    return u
}
fn back(k: f64) -> f64 {
    var w = zeros(10)
    for i in 9..=0 step -1 {
        w[i] = k
    }
    for j in 0..10 step 3 {
        w[j] = w[j] * k
    }
    return w[9]
}
let a = fill(4, 2)
let b = fill(6, 5)
printf("%g %g %g %g\n", a[0], b[5], back(2.0), back(0.5))
