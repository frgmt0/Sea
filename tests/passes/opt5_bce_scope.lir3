sa p5 s1
stf f2 p5 - 0 0
stf f4 p5 - 0 8
la p6 d1
rcall sea_printf 0:24 0 2 p6 p5
ret 0
endfunc
func scope fn 0:1:1 1 i1 1 f
li i2 8
li i3 1
rcall sea_arr_new 0:2 1 p4 4 i3 i3 i2 i3
lf f5 #0000000000000000
li i6 0
icmp ge i7 i1 i6
if 1 i7
li i8 8
li i9 1
rcount i10 i11 i1 i8 i9 0 0:5
if 2 i11
ldp p12 p4 - 0 40
loop 3 i13 i1 i10 i9
ldf f14 p12 i1 8 0
fadd f15 f5 f14
ldf f16 p12 i13 8 0
fadd f5 f15 f16
