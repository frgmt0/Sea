endif 2
ldi i17 p4 - 0 16
chkb i1 i17 0 0:8
ldp p18 p4 - 0 40
ldf f19 p18 i1 8 0
fadd f5 f5 f19
endif 1
li i20 0
li i21 100
li i22 1
li i23 5
li i24 0
ldp p25 p4 - 0 40
do 4
icmp lt i26 i20 i21
ifz 5 i26
exit 4
endif 5
iaddc i20 i20 i22 0:12
icmp ge i27 i20 i23
if 6 i27
exit 4
endif 6
icmp lt i28 i20 i24
if 7 i28
exit 4
endif 7
ldf f29 p25 i20 8 0
