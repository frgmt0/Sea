fn scope(k: i64) -> f64 {
    var v = zeros(8)
    var s = 0.0
    if k >= 0 {
        for i in k..8 {
            s = s + v[k] + v[i]
        }
        s = s + v[k]
    }
    var j = 0
    while j < 100 {
        j = j + 1
        if j >= 5 {
            break
        }
        if j < 0 {
            break
        }
        s = s + v[j]
    }
    s = s + v[j]
    return s
}
printf("%g %g\n", scope(2), scope(7))
