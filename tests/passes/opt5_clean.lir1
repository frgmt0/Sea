#sea 1
#target arm64-macos
#file opt5_clean.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
slot s3 16 8
sa p1 s1
sa p2 s2
lf f3 #3FF0000000000000
stf f3 p2 - 0 0
li i4 8
