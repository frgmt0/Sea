#sea 1
#target arm64-macos
#file opt5_clean.sea
func .main main 0:1:1 0 0
slot s1 8 8
slot s2 8 8
slot s3 16 8
sa p1 s1
sa p2 s2
lf f3 #3FF0000000000000
stf f3 p2 - 0 0
li i4 8
mcopy p1 p2 i4
li i5 1
rcall sea_arr_new_u 0:17 1 p6 4 i5 i5 i5 i5
ldp p7 p6 - 0 40
mcopy p7 p1 i4
lf f8 #3FE0000000000000
li i9 2
call clean 1 p10 4 p6 i5 f8 i9
release p6
rcall sea_arr_new_u 0:18 1 p11 4 i5 i5 i5 i5
ldp p12 p11 - 0 40
mcopy p12 p1 i4
lf f13 #3FF8000000000000
li i14 3
call clean 1 p15 4 p11 i9 f13 i14
release p11
ldi i16 p10 - 0 16
ldi i17 p15 - 0 16
sa p18 s3
sti i16 p18 - 0 0
sti i17 p18 - 0 8
la p19 d1
rcall sea_printf 0:19 0 2 p19 p18
release p15
release p10
ret 0
endfunc
func clean fn 0:1:1 4 p1 i2 f3 i4 1 p
li i5 1
rcall sea_arr_new 0:2 1 p6 4 i5 i5 i4 i5
li i7 0
mov i8 i5
rcount i9 i10 i7 i4 i8 0 0:5
if 1 i10
loop 2 i11 i7 i9 i8
li i12 0
ldi i13 p1 - 0 16
chkb i12 i13 0 0:6
li i14 1
iaddc i15 i2 i14 0:7
endloop 2
endif 1
ret 1 p6
endfunc
fmt d1 4
fconv - - - d i
ftext %20
fconv - - - d i
ftext %0A
#end
