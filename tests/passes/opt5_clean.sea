fn clean(v: f64[], a: i64, x: f64, n: i64) -> f64[] {
    var u = zeros(n)
    var s = x
    var k = a
    for i in 0..n {
        let unused = x * 2.0 + v[0]
        let fat = a + 1
        k = k
        if a > i {
            let z = x + 1.0
        }
        s = s + x
    }
    return u
}
let w = [1.0]
let p = clean(w, 1, 0.5, 2)
let q = clean(w, 2, 1.5, 3)
