#sea 1
#target arm64-macos
#file opt5_dead.sea
func .main main 0:1:1 0 0
slot s1 16 8
li i1 1
lf f2 #3FE0000000000000
li i3 3
call dead 1 f4 3 i1 f2 i3
li i5 9
lf f6 #404E000000000000
li i7 4
call dead 1 f8 3 i5 f6 i7
sa p9 s1
stf f4 p9 - 0 0
stf f8 p9 - 0 8
la p10 d1
rcall sea_printf 0:17 0 2 p10 p9
ret 0
endfunc
func dead fn 0:1:1 3 i1 f2 i3 1 f
lf f4 #0000000000000000
li i5 0
li i6 1
rcount i7 i8 i5 i3 i6 0 0:3
if 1 i8
loop 2 i9 i5 i7 i6
lf f10 #4000000000000000
fmul f11 f2 f10
fadd f4 f4 f11
lf f12 #4059000000000000
fcmp gt i13 f4 f12
if 3 i13
exit 2
lf f14 #4008000000000000
fmul f15 f2 f14
lf f16 #4008000000000000
fmul f17 f2 f16
fadd f4 f15 f17
endif 3
endloop 2
endif 1
li i18 5
icmp gt i19 i1 i18
if 4 i19
ret 1 f4
lf f20 #4010000000000000
fmul f21 f2 f20
lf f22 #4010000000000000
fmul f23 f2 f22
fadd f4 f21 f23
endif 4
lf f24 #4000000000000000
fmul f25 f2 f24
fadd f26 f4 f25
fadd f27 f26 f25
ret 1 f27
lf f28 #4014000000000000
fmul f29 f2 f28
lf f30 #4014000000000000
fmul f31 f2 f30
fadd f32 f29 f31
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
#end
