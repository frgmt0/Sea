fn dead(a: i64, x: f64, n: i64) -> f64 {
    var t = 0.0
    for i in 0..n {
        t = t + x * 2.0
        if t > 100.0 {
            break
            t = x * 3.0 + x * 3.0
        }
    }
    if a > 5 {
        return t
        t = x * 4.0 + x * 4.0
    }
    return t + x * 2.0 + x * 2.0
    let u = x * 5.0 + x * 5.0
}
printf("%g %g\n", dead(1, 0.5, 3), dead(9, 60.0, 4))
