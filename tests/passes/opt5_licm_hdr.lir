#sea 1
#target arm64-macos
#file opt5_licm_hdr.sea
func .main main 0:1:1 0 0
slot s1 16 8
slot s2 16 8
li i1 3
li i2 0
call hdr 1 f3 2 i1 i2
li i4 4
li i5 1
call hdr 1 f6 2 i4 i5
sa p7 s1
stf f3 p7 - 0 0
stf f6 p7 - 0 8
la p8 d1
rcall sea_printf 0:20 0 2 p8 p7
call moving 1 f9 1 i1
call moving 1 f10 1 i4
sa p11 s2
stf f9 p11 - 0 0
stf f10 p11 - 0 8
la p12 d2
rcall sea_printf 0:21 0 2 p12 p11
ret 0
endfunc
func hdr fn 0:1:1 2 i1 i2 1 f
li i3 1
rcall sea_arr_new 0:2 1 p4 4 i3 i3 i1 i3
lf f5 #0000000000000000
li i6 0
mov i7 i3
rcount i8 i9 i6 i1 i7 0 0:4
if 1 i9
ldi i10 p4 - 0 16
ldp p11 p4 - 0 40
itof f12 i10
loop 2 i13 i6 i8 i7
icmp gt i14 i13 i2
if 3 i14
ldf f15 p11 i13 8 0
fadd f16 f5 f15
fadd f5 f16 f12
endif 3
endloop 2
endif 1
release p4
ret 1 f5
endfunc
func moving fn 0:11:1 1 i1 1 f
li i2 1
rcall sea_arr_new 0:12 1 p3 4 i2 i2 i2 i2
lf f4 #0000000000000000
mov i5 i2
mov i6 i2
rcount i7 i8 i5 i1 i6 0 0:14
if 1 i8
li i9 1
loop 2 i10 i5 i7 i6
rcall sea_arr_new 0:15 1 p11 4 i9 i9 i10 i9
release p3
mov p3 p11
ldi i12 p3 - 0 16
itof f13 i12
fadd f14 f4 f13
isub i15 i10 i9
chkb i15 i12 0 0:16
ldp p16 p3 - 0 40
ldf f17 p16 i15 8 0
fadd f4 f14 f17
endloop 2
endif 1
release p3
ret 1 f4
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
fmt d2 4
fconv - - - g f
ftext %20
fconv - - - g f
