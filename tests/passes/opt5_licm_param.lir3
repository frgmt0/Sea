func norm1 fn 0:5:1 1 p1 1 f
lf f2 #0000000000000000
li i3 0
li i4 2
li i5 1
rcount i6 i7 i3 i4 i5 0 0:7
if 1 i7
ldf f8 p1 - 0 0
ldf f9 p1 - 0 8
