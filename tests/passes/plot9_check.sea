fn g(ax: Axes, x: f64[], k: i64[], s: str[]) -> Figure {
    let fig = figure(2, 3, height: 600, name: "h")
    let p: Axes = panel(fig, 1, 0, colspan: 2)
    let tw = twin_y(p)
    plot(ax, x, x, label: s[0], style: "o")
    plot(p, k, [1.0, 2.0])
    xline(tw, 1, color: "#00ff00")
    xlim(ax, 0, 2.5)
    grid(ax)
    legend(p, loc: "best")
    x_ticks(ax, s)
    y_reverse(tw)
    save_svg(fig, "g.svg")
    return fig
}
