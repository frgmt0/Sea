struct S { a: Axes, k: i64 }
fn g(fig: Figure, n: i64) -> i64 {
    let ax = panel(fig, 0, n)
    if n > 0 { return n }
    var c = 0
    for i in 0..3 {
        let F = figure(1, 1)
        if i == 0 { continue }
        if i == 2 { break }
        c = c + i
    }
    let b = ax
    let s = S { a: ax, k: 1 }
    title(b, "b")
    xlabel(s.a, "s")
    return c + s.k
}
let fig = figure(1, 2)
printf("%d %d\n", g(fig, 0), g(fig, 1))
// plot9_release -- Figure and Axes locals are reference locals (DESIGN.md 2.14.4, rules 15 and 16; L-jo:
// class p): ax released before the early `return` in the `if`; the loop's Figure F released at
// `continue` (before `next`), at `break` (before `exit`) and at the end of its block; `let b = ax`
// retains (mov, retain); the struct field `a` retains ax when stored and is released with s (ldp,
// release) at the final return, then b, then ax. g has a loop and two call sites, so it is not inlined.
// Output: g(fig, 0) = (i = 1: c = 1) + s.k = 2, g(fig, 1) returns 1.
