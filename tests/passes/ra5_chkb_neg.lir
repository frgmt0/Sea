#sea 1
#target arm64-macos
#file ra5_chkb_neg.sea
func .main main 0:1:1 0 0
slot s1 16 8
slot s2 8 8
li i1 2
li i2 1
iadd i3 i1 i2
li i4 2
chkb i4 i3 0 0:2
sa p5 s1
sti i4 p5 - 0 0
sti i3 p5 - 0 8
la p6 d1
rcall sea_printf 0:3 0 2 p6 p5
li i7 -1
chkb i7 i3 0 0:6
sa p8 s2
sti i7 p8 - 0 0
la p9 d2
rcall sea_printf 0:7 0 2 p9 p8
ret 0
endfunc
fmt d1 6
ftext ok
ftext %20
fconv - - - d i
ftext %20
fconv - - - d i
ftext %0A
fmt d2 4
ftext unreached
ftext %20
fconv - - - d i
ftext %0A
#end
