    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    s += 1
    return s
}
fn s51(k: i64) -> i64 {
    var s = k
    if s > 0 {
        s += 1
    } else if s < 0 {
        s -= 1
    } else {
        s = 1
    }
    {
        s += 2
    }
    s += 1
    s += 1
