var A = zeros(2, 3)
A[0, 2] = 5.0
A[1, 2] = 6.0
let c = A[:, 2]
let w = filled(1, 2)
let r = c[w]
let M = A > 5.5
let s = A[M]
printf("%g %g %g %d %g\n", c[0], c[1], r[0], len(r), s[0])
