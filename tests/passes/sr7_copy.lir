#sea 1
#target arm64-macos
#file sr7_copy.sea
func .main main 0:1:1 0 0
slot s1 16 8
li i1 3
lf f2 #3FE0000000000000
call run 1 f3 2 i1 f2
li i4 1
lf f5 #3FD0000000000000
call run 1 f6 2 i4 f5
sa p7 s1
stf f3 p7 - 0 0
stf f6 p7 - 0 8
la p8 d1
rcall sea_printf 0:14 0 2 p8 p7
ret 0
endfunc
func run fn 0:5:1 2 i1 f2 1 f
lf f3 #3FF0000000000000
mov f4 f3
lf f5 #0000000000000000
mov f6 f5
mov f7 f3
mov f8 f4
mov f9 f6
mov f10 f7
li i11 0
li i12 1
rcount i13 i14 i11 i1 i12 0 0:7
if 1 i14
loop 2 i15 i11 i13 i12
mov f16 f8
mov f17 f9
mov f18 f16
mov f19 f17
fmul f20 f2 f19
fadd f21 f18 f20
mov f8 f21
mov f22 f17
mov f23 f16
fmul f24 f2 f23
fsub f25 f22 f24
mov f9 f25
endloop 2
endif 1
mov f26 f8
mov f27 f9
fadd f28 f26 f27
mov f29 f10
fadd f30 f28 f29
ret 1 f30
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
#end
