func half fn 0:1:1 1 i1 1 f
slot s1 16 8
sa p2 s1
lf f3 #4000000000000000
stf f3 p2 - 0 8
li i4 0
icmp gt i5 i1 i4
if 1 i5
stf f3 p2 - 0 0
endif 1
ldf f6 p2 - 0 0
ldf f7 p2 - 0 8
fadd f8 f6 f7
