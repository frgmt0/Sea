#sea 1
#target arm64-macos
#file sr7_state4_hand.sea
func .main main 0:1:1 0 0
slot s1 32 8
slot s2 8 8
sa p1 s1
lf f2 #3FF0000000000000
stf f2 p1 - 0 0
stf f2 p1 - 0 8
stf f2 p1 - 0 16
stf f2 p1 - 0 24
lf f3 #3FE0000000000000
li i4 0
li i5 2
li i6 1
li i7 3
loop 1 i8 i4 i5 i6
loop 2 i9 i4 i7 i6
ldf f10 p1 i9 8 0
fmul f11 f10 f3
fadd f12 f10 f11
stf f12 p1 i9 8 0
endloop 2
endloop 1
ldf f13 p1 - 0 0
ldf f14 p1 - 0 8
fadd f15 f13 f14
ldf f16 p1 - 0 16
fadd f17 f15 f16
ldf f18 p1 - 0 24
fadd f19 f17 f18
sa p20 s2
stf f19 p20 - 0 0
la p21 d1
rcall sea_printf 0:1 0 2 p21 p20
ret 0
endfunc
fmt d1 2
fconv - - - g f
ftext %0A
#end
