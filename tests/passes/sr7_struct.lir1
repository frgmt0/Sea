#sea 1
#target arm64-macos
#file sr7_struct.sea
func .main main 0:1:1 0 0
slot s1 24 8
slot s2 24 8
slot s3 16 8
sa p1 s1
sa p2 s2
lf f3 #3FF0000000000000
stf f3 p2 - 0 0
lf f4 #4000000000000000
stf f4 p2 - 0 8
lf f5 #4008000000000000
stf f5 p2 - 0 16
li i6 24
mcopy p1 p2 i6
li i7 3
li i8 1
li i9 1
li i10 1
rcall sea_arr_new_u 0:17 1 p11 4 i8 i9 i7 i10
ldp p12 p11 - 0 40
li i13 24
mcopy p12 p1 i13
li i14 3
call tally 1 f15 2 p11 i14
release p11
li i16 3
li i17 1
li i18 1
li i19 1
rcall sea_arr_new_u 0:17 1 p20 4 i17 i18 i16 i19
ldp p21 p20 - 0 40
li i22 24
mcopy p21 p1 i22
li i23 2
call tally 1 f24 2 p20 i23
release p20
sa p25 s3
stf f15 p25 - 0 0
stf f24 p25 - 0 8
la p26 d1
rcall sea_printf 0:17 0 2 p26 p25
ret 0
endfunc
func tally fn 0:8:1 2 p1 i2 1 f
slot s1 16 8
sa p3 s1
lf f4 #0000000000000000
stf f4 p3 - 0 0
li i5 0
sti i5 p3 - 0 8
li i6 0
li i7 1
rcount i8 i9 i6 i2 i7 0 0:10
if 1 i9
loop 2 i10 i6 i8 i7
ldf f11 p3 - 0 0
ldi i12 p1 - 0 16
chkb i10 i12 0 0:11
ldp p13 p1 - 0 40
ldf f14 p13 i10 8 0
fadd f15 f11 f14
stf f15 p3 - 0 0
ldi i16 p3 - 0 8
li i17 1
iaddc i18 i16 i17 0:12
sti i18 p3 - 0 8
endloop 2
endif 1
ldf f19 p3 - 0 0
ldi i20 p3 - 0 8
itof f21 i20
fadd f22 f19 f21
ret 1 f22
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
#end
