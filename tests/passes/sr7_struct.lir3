#sea 1
#target arm64-macos
#file sr7_struct.sea
func .main main 0:1:1 0 0
slot s1 24 8
slot s2 24 8
slot s3 16 8
sa p1 s1
sa p2 s2
lf f3 #3FF0000000000000
stf f3 p2 - 0 0
lf f4 #4000000000000000
stf f4 p2 - 0 8
lf f5 #4008000000000000
stf f5 p2 - 0 16
li i6 24
mcopy p1 p2 i6
li i7 3
li i8 1
rcall sea_arr_new_u 0:17 1 p9 4 i8 i8 i7 i8
ldp p10 p9 - 0 40
mcopy p10 p1 i6
call tally 1 f11 2 p9 i7
release p9
rcall sea_arr_new_u 0:17 1 p12 4 i8 i8 i7 i8
ldp p13 p12 - 0 40
mcopy p13 p1 i6
li i14 2
call tally 1 f15 2 p12 i14
release p12
sa p16 s3
stf f11 p16 - 0 0
stf f15 p16 - 0 8
la p17 d1
rcall sea_printf 0:17 0 2 p17 p16
ret 0
endfunc
func tally fn 0:8:1 2 p1 i2 1 f
slot s1 16 8
sa p3 s1
lf f4 #0000000000000000
stf f4 p3 - 0 0
li i5 0
sti i5 p3 - 0 8
mov i6 i5
li i7 1
rcount i8 i9 i6 i2 i7 0 0:10
if 1 i9
ldf f10 p3 - 0 0
ldi i11 p1 - 0 16
ldi i12 p3 - 0 8
ldp p13 p1 - 0 40
li i14 1
loop 2 i15 i6 i8 i7
chkb i15 i11 0 0:11
ldf f16 p13 i15 8 0
fadd f10 f10 f16
iaddc i12 i12 i14 0:12
endloop 2
stf f10 p3 - 0 0
sti i12 p3 - 0 8
endif 1
ldf f17 p3 - 0 0
ldi i18 p3 - 0 8
itof f19 i18
fadd f20 f17 f19
ret 1 f20
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
#end
