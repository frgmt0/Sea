#sea 1
#target arm64-macos
#file sr7_unroll.sea
func .main main 0:1:1 0 0
slot s1 32 8
slot s2 8 8
sa p1 s1
la p2 d1
li i3 32
mcopy p1 p2 i3
lf f4 #0000000000000000
li i5 0
li i6 3
li i7 1
loop 1 i8 i5 i6 i7
ldf f9 p1 i8 8 0
fadd f4 f4 f9
endloop 1
sa p10 s2
stf f4 p10 - 0 0
la p11 d2
rcall sea_printf 0:1 0 2 p11 p10
ret 0
endfunc
dat d1 f64 4
dvf #3FF0000000000000
dvf #4000000000000000
dvf #4008000000000000
dvf #4010000000000000
fmt d2 2
fconv - - - g f
ftext %0A
#end
