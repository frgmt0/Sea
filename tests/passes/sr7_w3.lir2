#sea 1
#target arm64-macos
#file sr7_w3.sea
func .main main 0:1:1 0 0
slot s1 16 8
li i1 3
lf f2 #3FE0000000000000
call run 1 f3 2 i1 f2
li i4 1
lf f5 #3FD0000000000000
call run 1 f6 2 i4 f5
sa p7 s1
stf f3 p7 - 0 0
stf f6 p7 - 0 8
la p8 d1
rcall sea_printf 0:16 0 2 p8 p7
ret 0
endfunc
func run fn 0:9:1 2 i1 f2 1 f
slot s1 32 8
slot s2 32 8
slot s3 32 8
slot s4 32 8
slot s5 32 8
sa p3 s1
sa p4 s2
lf f5 #3FF0000000000000
stf f5 p4 - 0 0
lf f6 #0000000000000000
stf f6 p4 - 0 8
stf f6 p4 - 0 16
stf f5 p4 - 0 24
li i7 32
mcopy p3 p4 i7
li i8 0
li i9 1
rcount i10 i11 i8 i1 i9 0 0:11
if 1 i11
loop 2 i12 i8 i10 i9
sa p13 s3
do 3
sa p14 s4
li i15 1
ldf f16 p3 i15 8 0
stf f16 p14 - 0 0
li i17 0
ldf f18 p3 i17 8 0
fneg f19 f18
stf f19 p14 - 0 8
li i20 3
ldf f21 p3 i20 8 0
stf f21 p14 - 0 16
li i22 2
ldf f23 p3 i22 8 0
fneg f24 f23
stf f24 p14 - 0 24
li i25 32
mcopy p13 p14 i25
exit 3
enddo 3
sa p26 s5
li i27 4
li i28 0
icmp gt i29 i27 i28
if 4 i29
li i30 1
isub i31 i27 i30
loop 5 i32 i28 i31 i30
ldf f33 p3 i32 8 0
ldf f34 p13 i32 8 0
fmul f35 f2 f34
fadd f36 f33 f35
stf f36 p26 i32 8 0
endloop 5
endif 4
li i37 32
mcopy p3 p26 i37
endloop 2
endif 1
li i38 0
ldf f39 p3 i38 8 0
li i40 1
ldf f41 p3 i40 8 0
fadd f42 f39 f41
li i43 2
ldf f44 p3 i43 8 0
fadd f45 f42 f44
li i46 3
ldf f47 p3 i46 8 0
fadd f48 f45 f47
ret 1 f48
endfunc
fmt d1 4
fconv - - - g f
ftext %20
fconv - - - g f
ftext %0A
#end
