// stmt_grammar_full -- one of every construct of LANGUAGE.md Appendix A; pass 1 parses the
// whole grammar in every phase (DESIGN.md 2.6.2, 3.4)
const N: i64 = 4
const H = 0.5
struct S {
    a: f64, b: i64
    c: f64[N]
}
elemental fn sq(x: f64) -> f64 {
    return x * x
}
fn f(ref v: f64[,], k: i64 = 2) -> (f64, i64) {
    return (v[0, $ - 1], k)
}
fn g() {
    return
}
let m: f64[2, 2] = [1.0, 2.0; 3.0, 4.0]
var w: f64[] = []
let (p, _) = f(ref m, k: 3)
let _ = sq(H)
var t = 0
t = 1; t += 2; t -= 1; t *= 3; t /= 2
(w[0], _) = f(ref w)
g()
if t == 1 { t = 2 } else if t != 3 { t = 4 } else { t = 5 }
while t < 10 && !false || true { break }
for i in 0..=N step 2 { continue }
for x in w[1..$] { }
match str(t) {
    "1" | "2" => { }, _ => { }
}
{ let r = S { a: 1.0, b: 2, c: [0.0, 0.0, 0.0, 0.0] } }
let e = { x: f64(1), y: i64(2.0) }
let q = (0..3) % 2 >= 1 & m[:, 1] <= 2.0 | false
let u = m.T @ e.x / 1.5 ^ -2 + w[i]
let z = if t > 0 { 1 } else if t < 0 { -1 } else { 0 }
