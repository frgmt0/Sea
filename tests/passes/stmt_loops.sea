// stmt_loops -- while as do / ifz / exit; a range loop with ..= and a negative step through
// rcount, if on its flag and loop; continue/break are next/exit of the loop (DESIGN.md 3.6.6
// rule 4); the step -2 reaches LIR folded (3.5.7)
fn walk(n: i64) -> i64 {
    var k = 0
    while k < n {
        k += 3
    }
    for i in n..=0 step -2 {
        if i == 4 {
            continue
        }
        if i < 2 {
            break
        }
        k -= i
    }
    return k
}
let a = walk(10)
let b = walk(7)
