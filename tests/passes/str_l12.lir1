#sea 1
#target arm64-macos
#file str_l12.sea
func .main main 0:1:1 0 0
slot s1 16 8
li i1 1
call two 2 p2 i3 1 i1
sa p4 s1
stp p2 p4 - 0 0
sti i3 p4 - 0 8
la p5 d1
rcall sea_printf 0:11 0 2 p5 p4
li i6 0
call upd 0 1 i6
li i7 1
call upd 0 1 i7
release p2
ret 0
endfunc
func two fn 0:1:1 1 i1 2 p i
rcall sea_str_i64 0:2 1 p2 1 i1
li i3 1
iaddc i4 i1 i3 0:2
ret 2 p2 i4
endfunc
func upd fn 0:4:1 1 i1 0
slot s1 24 8
li i2 2
li i3 4
li i4 1
li i5 1
rcall sea_arr_new 0:5 1 p6 4 i3 i4 i2 i5
ldp p7 p6 - 0 40
la p8 d2
retain p8
stp p8 p7 - 0 0
la p9 d3
retain p9
stp p9 p7 - 0 8
li i10 0
li i11 5
iaddc i12 i1 i11 0:7
call two 2 p13 i14 1 i12
ldi i15 p6 - 0 16
chkb i1 i15 0 0:7
ldi i16 p6 - 0 0
li i17 1
icmp ne i18 i16 i17
if 1 i18
rcall sea_arr_unique 0:7 1 p19 1 p6
mov p6 p19
endif 1
ldp p20 p6 - 0 40
ldp p21 p20 i1 8 0
stp p13 p20 i1 8 0
release p21
mov i10 i14
li i22 0
ldi i23 p6 - 0 16
chkb i22 i23 0 0:8
ldp p24 p6 - 0 40
ldp p25 p24 i22 8 0
li i26 1
ldi i27 p6 - 0 16
chkb i26 i27 0 0:8
ldp p28 p6 - 0 40
ldp p29 p28 i26 8 0
sa p30 s1
stp p25 p30 - 0 0
stp p29 p30 - 0 8
sti i10 p30 - 0 16
la p31 d4
rcall sea_printf 0:8 0 2 p31 p30
release p6
ret 0
endfunc
fmt d1 4
fconv - - - s p
ftext %20
fconv - - - d i
ftext %0A
str d2 x
str d3 y
fmt d4 6
fconv - - - s p
ftext %20
fconv - - - s p
ftext %20
fconv - - - d i
ftext %0A
#end
