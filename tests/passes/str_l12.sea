fn two(n: i64) -> (str, i64) {
    return (str(n), n + 1)
}
fn upd(i: i64) {
    var names = ["x", "y"]
    var k = 0
    (names[i], k) = two(i + 5)
    printf("%s %s %d\n", names[0], names[1], k)
}
let (a, b) = two(1)
printf("%s %d\n", a, b)
upd(0)
upd(1)
