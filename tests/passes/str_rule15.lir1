#sea 1
#target arm64-macos
#file str_rule15.sea
func .main main 0:1:1 0 0
li i1 12
rcall sea_str_i64 0:9 1 p2 1 i1
li i3 7
rcall sea_str_i64 0:10 1 p4 1 i3
call show 0 2 p2 p4
call show 0 2 p4 p2
release p4
release p2
ret 0
endfunc
func show fn 0:3:1 2 p1 p2 0
slot s1 8 8
slot s2 16 8
rcall sea_str_cat 0:4 1 p3 2 p1 p2
mov p4 p3
retain p4
rcall sea_str_cat 0:6 1 p5 2 p1 p2
sa p6 s1
stp p5 p6 - 0 0
la p7 d1
rcall sea_printf 0:6 0 2 p7 p6
release p5
sa p8 s2
stp p3 p8 - 0 0
stp p4 p8 - 0 8
la p9 d2
rcall sea_printf 0:7 0 2 p9 p8
release p4
release p3
ret 0
endfunc
fmt d1 2
fconv - - - s p
ftext %0A
fmt d2 4
fconv - - - s p
ftext %20
fconv - - - s p
ftext %0A
#end
