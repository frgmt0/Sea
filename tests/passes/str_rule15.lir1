#sea 1
#target arm64-macos
#file str_rule15.sea
func .main main 0:1:1 0 0
li i1 12
rcall sea_str_i64 0:9 1 p2 1 i1
li i3 7
rcall sea_str_i64 0:10 1 p4 1 i3
call show 0 2 p2 p4
call show 0 2 p4 p2
release p4
release p2
ret 0
endfunc
func show fn 0:3:1 2 p1 p2 0
slot s1 8 8
slot s2 16 8
do 1
li i3 0
ifz 2 i3
exit 1
endif 2
enddo 1
rcall sea_str_cat 0:4 1 p4 2 p1 p2
mov p5 p4
retain p5
rcall sea_str_cat 0:6 1 p6 2 p1 p2
sa p7 s1
stp p6 p7 - 0 0
la p8 d1
rcall sea_printf 0:6 0 2 p8 p7
release p6
sa p9 s2
stp p4 p9 - 0 0
stp p5 p9 - 0 8
la p10 d2
rcall sea_printf 0:7 0 2 p10 p9
release p5
release p4
ret 0
endfunc
fmt d1 2
fconv - - - s p
ftext %0A
fmt d2 4
fconv - - - s p
ftext %20
fconv - - - s p
ftext %0A
#end
