#sea 1
#target arm64-macos
#file str_rule26.sea
tvec 10 5
fn 1 .main main 1 0 2 0:1:1
loc names 10 let 0:1:5
loc n 5 for 0:2:5
cs 0:1:14 5 a
cs 0:1:19 5 bc
row 0:1:14 10 2
arr 0:1:13 10 1
bind 0:1:1 1
lv 0:2:10 10 1
lv 0:3:20 5 2
fconv 0:3:12 1 - - - s
ftext 0:3:12 1 %0A
fmt 0:3:12 1 2
lib 0:3:5 1 printf 1
eval 0:3:5
block 0:2:16 1
fore 0:2:1 2
block 0:1:1 2
end
#end
