#sea 1
#target arm64-macos
#file str_rule30.sea
tvec 10 5
fn 1 .main main 1 0 2 0:1:1
loc a 5 for 0:3:5
loc k 3 let 0:4:5
lib 0:3:10 10 args 0
block 0:3:17 0
fore 0:3:1 1
lib 0:4:13 10 args 0
lib 0:4:9 3 len 1
bind 0:4:1 2
lv 0:5:16 3 2
fconv 0:5:8 1 - - - d
ftext 0:5:8 1 %0A
fmt 0:5:8 1 2
lib 0:5:1 1 printf 1
eval 0:5:1
block 0:1:1 3
end
#end
