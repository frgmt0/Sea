#sea 1
#target arm64-macos
#file str_rule32.sea
func .main main 0:1:1 0 0
la p1 d1
la p2 d2
call less 0 2 p1 p2
la p3 d3
la p4 d4
call less 0 2 p3 p4
la p5 d5
la p6 d6
call less 0 2 p5 p6
ret 0
endfunc
func less fn 0:1:1 2 p1 p2 0
slot s1 8 8
slot s2 8 8
slot s3 24 8
do 1
li i3 0
ifz 2 i3
exit 1
endif 2
enddo 1
rcall sea_str_cmp - 1 i4 2 p1 p2
li i5 0
icmp lt i6 i4 i5
if 3 i6
sa p7 s1
la p8 d7
rcall sea_printf 0:3 0 2 p8 p7
else 3
sa p9 s2
la p10 d8
rcall sea_printf 0:5 0 2 p10 p9
endif 3
rcall sea_str_lower 0:7 1 p11 1 p1
ldi i12 p1 - 0 16
rcall sea_str_cmp - 1 i13 2 p1 p2
li i14 0
icmp lt i15 i13 i14
la p16 d9
la p17 d10
psel p18 i15 p16 p17
sa p19 s3
stp p11 p19 - 0 0
sti i12 p19 - 0 8
stp p18 p19 - 0 16
la p20 d11
rcall sea_printf 0:7 0 2 p20 p19
release p11
ret 0
endfunc
str d1 ab
str d2 b
str d3 b
str d4 ab
str d5 Ab
str d6 a
fmt d7 1
ftext lt%0A
fmt d8 1
ftext ge%0A
str d9 true
str d10 false
fmt d11 6
fconv - - - s p
ftext %20
fconv - - - d i
ftext %20
fconv - - - s p
ftext %0A
#end
