#sea 1
#target arm64-macos
#file str_rule33.sea
func .main main 0:1:1 0 0
call drive 0 0
call drive 0 0
ret 0
endfunc
func pick fn 0:1:1 1 p1 0
slot s1 8 8
do 1
li i2 0
ifz 2 i2
exit 1
endif 2
enddo 1
li i3 0
la p4 d1
rcall sea_str_cmp - 1 i5 2 p1 p4
li i6 0
icmp eq i7 i5 i6
la p8 d2
rcall sea_str_cmp - 1 i9 2 p1 p8
li i10 0
icmp eq i11 i9 i10
ior i12 i7 i11
if 3 i12
li i3 1
else 3
li i3 2
endif 3
sa p13 s1
sti i3 p13 - 0 0
la p14 d3
rcall sea_printf 0:7 0 2 p14 p13
ret 0
endfunc
func drive fn 0:9:1 0 0
do 1
li i1 0
ifz 2 i1
exit 1
endif 2
enddo 1
la p2 d4
call pick 0 1 p2
la p3 d5
call pick 0 1 p3
la p4 d6
call pick 0 1 p4
ret 0
endfunc
str d1 x
str d2 y
fmt d3 2
fconv - - - d i
ftext %0A
str d4 x
str d5 y
str d6 z
#end
