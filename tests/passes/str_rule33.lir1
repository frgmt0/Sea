#sea 1
#target arm64-macos
#file str_rule33.sea
func .main main 0:1:1 0 0
call drive 0 0
call drive 0 0
ret 0
endfunc
func pick fn 0:1:1 1 p1 0
slot s1 8 8
li i2 0
la p3 d1
rcall sea_str_cmp - 1 i4 2 p1 p3
li i5 0
icmp eq i6 i4 i5
la p7 d2
rcall sea_str_cmp - 1 i8 2 p1 p7
li i9 0
icmp eq i10 i8 i9
ior i11 i6 i10
if 1 i11
li i2 1
else 1
li i2 2
endif 1
sa p12 s1
sti i2 p12 - 0 0
la p13 d3
rcall sea_printf 0:7 0 2 p13 p12
ret 0
endfunc
func drive fn 0:9:1 0 0
la p1 d4
call pick 0 1 p1
la p2 d5
call pick 0 1 p2
la p3 d6
call pick 0 1 p3
ret 0
endfunc
str d1 x
str d2 y
fmt d3 2
fconv - - - d i
ftext %0A
str d4 x
str d5 y
str d6 z
#end
