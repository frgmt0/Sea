fn two(k: i64) -> (str, i64) { while false {}
    return (str(k), k + 1)
}
fn mk(k: i64) -> (P, i64) { while false {}
    return (P { name: str(k), x: 1.5 }, k)
}
var s = P { name: "a", x: 0.5 }
var ps = [P { name: "b", x: 2.5 }]
var k = 0
(s.name, k) = two(7)
(ps[0], k) = mk(k)
printf("%s %d %s %g\n", s.name, k, ps[0].name, ps[0].x)
ps[0] = P { name: "c", x: 3.5 }
let (t, j) = two(3)
let (q, m) = mk(4)
printf("%s %d %s %d %s\n", t, j, q.name, m, ps[0].name)
struct P {
    name: str
    x: f64
}
