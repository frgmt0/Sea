fn edit(k: i64) -> i64 {
    let l0 = Lim { lo: 0.0, hi: 1.0 }
    var s = S { n: k, name: "a", v: zeros(2), lim: l0 }
    s.n = s.n + 1
    s.n += 2
    s.name = "b"
    s.lim.hi = 3.0
    s.v[k] = 9.0
    let l1 = s.lim
    s.lim = Lim { lo: 0.5, hi: 0.75 }
    let l2 = s.lim
    printf("%d %s %g %g %g %g\n", s.n, s.name, s.v[0], s.v[1], l1.hi, l2.lo)
    return s.n
}
printf("%d\n", edit(0))
printf("%d\n", edit(1))
struct Lim {
    lo: f64
    hi: f64
}
struct S {
    n: i64
    name: str
    v: f64[]
    lim: Lim
}
