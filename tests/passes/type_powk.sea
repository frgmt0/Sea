// type_powk -- ^ whose exponent is a constant with an integral value |k| <= 4 is powk k:
// written 2 or 2.0, negative, a const, a constant expression, -0.0 (k = 0); an i64 base is
// converted; the exponent's nodes are not written (LANGUAGE.md 6.5; DESIGN.md 3.5.5)
const K = 6 % 4
let x = 1.5
let a = x ^ 2
let b = x ^ 2.0
let c = x ^ -1
let d = x ^ K
let e = x ^ (1 + 3)
let f = x ^ -0.0
let g = 2 ^ 3
let h = x ^ 0
let i = x ^ (8.0 / 2.0)
let n = 3
let j = n ^ 2
