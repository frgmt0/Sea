// plot_category -- category labels at 0 ... n - 1: x_ticks with no data (limits -0.5 ... n - 0.5), y_ticks with
// data beyond them (the limits widened, every label kept); an empty list returns to numeric ticks
// (LANGUAGE.md 12.4; DESIGN.md 2.14.6 rule 2)
let none: str[] = []
let fig = figure(1, 3)
let a = panel(fig, 0, 0)
x_ticks(a, ["low", "mid", "high"])
let b = panel(fig, 0, 1)
plot(b, [0.0, 1.0], [-1.0, 4.0])
y_ticks(b, ["A & B", "C"])
let c = panel(fig, 0, 2)
plot(c, [0.0, 4.0], [0.0, 1.0])
x_ticks(c, ["p", "q"])
x_ticks(c, none)
save_svg(fig, "plot_category.svg")
