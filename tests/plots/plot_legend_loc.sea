// plot_legend_loc -- each legend location and best (northeast); the box lists the labelled series in call
// order, unlabelled ones not (LANGUAGE.md 12.4, 12.5; L-kn)
let fig = figure(3, 3)
let a0 = panel(fig, 0, 0)
plot(a0, [0.0, 1.0], [0.0, 1.0], label: "north")
plot(a0, [0.0, 1.0], [1.0, 0.0])
legend(a0, loc: "north")
let a1 = panel(fig, 0, 1)
plot(a1, [0.0, 1.0], [0.0, 1.0], label: "south")
plot(a1, [0.0, 1.0], [1.0, 0.0])
legend(a1, loc: "south")
let a2 = panel(fig, 0, 2)
plot(a2, [0.0, 1.0], [0.0, 1.0], label: "east")
plot(a2, [0.0, 1.0], [1.0, 0.0])
legend(a2, loc: "east")
let a3 = panel(fig, 1, 0)
plot(a3, [0.0, 1.0], [0.0, 1.0], label: "west")
plot(a3, [0.0, 1.0], [1.0, 0.0])
legend(a3, loc: "west")
let a4 = panel(fig, 1, 1)
plot(a4, [0.0, 1.0], [0.0, 1.0], label: "northeast")
plot(a4, [0.0, 1.0], [1.0, 0.0])
legend(a4, loc: "northeast")
let a5 = panel(fig, 1, 2)
plot(a5, [0.0, 1.0], [0.0, 1.0], label: "northwest")
plot(a5, [0.0, 1.0], [1.0, 0.0])
legend(a5, loc: "northwest")
let a6 = panel(fig, 2, 0)
plot(a6, [0.0, 1.0], [0.0, 1.0], label: "southeast")
plot(a6, [0.0, 1.0], [1.0, 0.0])
legend(a6, loc: "southeast")
let a7 = panel(fig, 2, 1)
plot(a7, [0.0, 1.0], [0.0, 1.0], label: "southwest")
plot(a7, [0.0, 1.0], [1.0, 0.0])
legend(a7, loc: "southwest")
let a8 = panel(fig, 2, 2)
plot(a8, [0.0, 1.0], [0.0, 1.0], label: "best")
plot(a8, [0.0, 1.0], [1.0, 0.0])
legend(a8, loc: "best")
save_svg(fig, "plot_legend_loc.svg")
