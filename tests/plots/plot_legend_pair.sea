// plot_legend_pair -- a legend set before its series lists the labelled line series of both axes of a pair in
// call order (markers and lines sampled); a legend without labelled series and labelled series without a
// legend draw no box; the last location set is kept (LANGUAGE.md 12.4; L-kn, L-kg)
let fig = figure(1, 3)
let a = panel(fig, 0, 0)
legend(a, loc: "southwest")
plot(a, [0.0, 1.0], [0.0, 1.0], label: "first")
let t = twin_y(a)
plot(t, [0.0, 1.0], [5.0, 6.0], style: "o", label: "second")
plot(a, [0.0, 1.0], [1.0, 0.0])
plot(a, [0.0, 1.0], [0.5, 0.5], style: "-s", label: "third")
xline(a, 0.5)
legend(t, loc: "north")
let b = panel(fig, 0, 1)
plot(b, [0.0, 1.0], [0.0, 1.0])
legend(b)
let c = panel(fig, 0, 2)
plot(c, [0.0, 1.0], [0.0, 1.0], label: "unshown")
save_svg(fig, "plot_legend_pair.svg")
