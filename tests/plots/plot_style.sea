// plot_style -- each line part, each marker, each colour letter, the empty style, #RRGGBB upper case written
// lower case, `color:` over a style letter (LANGUAGE.md 12.3; L-ki, L-kh); the cycle wraps after seven
let fig = figure(1, 1)
let ax = panel(fig, 0, 0)
let x = [0.0, 1.0, 2.0]
plot(ax, x, [0.0, 1.0, 0.0], style: "-")
plot(ax, x, [1.0, 2.0, 1.0], style: "--")
plot(ax, x, [2.0, 3.0, 2.0], style: ":")
plot(ax, x, [3.0, 4.0, 3.0], style: "-.")
plot(ax, x, [4.0, 5.0, 4.0], style: "o")
plot(ax, x, [5.0, 6.0, 5.0], style: "s")
plot(ax, x, [6.0, 7.0, 6.0], style: "d")
plot(ax, x, [7.0, 8.0, 7.0], style: "^")
plot(ax, x, [8.0, 9.0, 8.0], style: "v")
plot(ax, x, [9.0, 10.0, 9.0], style: "x")
plot(ax, x, [10.0, 11.0, 10.0], style: "+")
plot(ax, x, [11.0, 12.0, 11.0], style: "*")
plot(ax, x, [12.0, 13.0, 12.0], style: ".")
plot(ax, x, [13.0, 14.0, 13.0], style: "r")
plot(ax, x, [14.0, 15.0, 14.0], style: "g-")
plot(ax, x, [15.0, 16.0, 15.0], style: "b--")
plot(ax, x, [16.0, 17.0, 16.0], style: "c:")
plot(ax, x, [17.0, 18.0, 17.0], style: "m-.")
plot(ax, x, [18.0, 19.0, 18.0], style: "yo")
plot(ax, x, [19.0, 20.0, 19.0], style: "k-s")
plot(ax, x, [20.0, 21.0, 20.0], style: "w*")
plot(ax, x, [30.0, 31.0, 30.0], style: "")
plot(ax, x, [31.0, 32.0, 31.0], width: 2.5, color: "#A1B2C3")
plot(ax, x, [32.0, 33.0, 32.0], style: "r", color: "#00FF00")
plot(ax, x, [33.0, 34.0, 33.0], style: "o-")
plot(ax, x, [34.0, 35.0, 34.0], style: "--r")
save_svg(fig, "plot_style.svg")
