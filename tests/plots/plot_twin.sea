// plot_twin -- twin_y: the twin's cycle starts at #d95319, its ticks on the right (ytick2) and its ylabel2;
// twin_y twice and twin_y of the twin return the same axes; xlabel, title and grid of the twin act on the pair,
// ylabel and ylim on its own y-axis; the pair's x-axis takes both axes' data (LANGUAGE.md 12.2-12.4; L-km)
let fig = figure(1, 2)
let ax = panel(fig, 0, 0)
plot(ax, [0.0, 1.0, 2.0], [0.0, 10.0, 20.0])
let t = twin_y(ax)
plot(t, [0.0, 4.0], [0.5, 0.75])
let t2 = twin_y(ax)
let t3 = twin_y(t)
plot(t3, [1.0, 3.0], [0.6, 0.7])
xlabel(t, "time [s]")
title(t2, "pair")
ylabel(ax, "left")
ylabel(t3, "right")
grid(t)
let b = panel(fig, 0, 1)
plot(b, [0.0, 1.0], [0.0, 1.0])
let tb = twin_y(b)
ylim(tb, 0.25, 0.75)
ylabel(tb, "limited")
save_svg(fig, "plot_twin.svg")
