// arr_compound -- compound element assignment += -= *= /= on f64[], i64[] and f64[,] (LANGUAGE.md
// 5.5, 7.3)
var v = filled(1.0, 3)
v[1] = 2.0
v[2] = 3.0
v[0] += 2.0
v[1] -= 0.5
v[2] *= 4.0
printf("%g %g %g\n", v[0], v[1], v[2])
v[2] /= 8.0
printf("%g\n", v[2])
var iv = filled(10, 2)
iv[0] += 5
iv[1] -= 20
iv[1] *= -3
printf("%d %d\n", iv[0], iv[1])
var A = ones(2, 2)
A[0, 1] = 7.0
A[1, 0] += A[0, 1]
printf("%g %g\n", A[1, 0], A[0, 1])
var k = 0
iv[k] += iv[k + 1]
printf("%d\n", iv[0])
