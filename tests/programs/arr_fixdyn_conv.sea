// arr_fixdyn_conv -- implicit dyn and fix (LANGUAGE.md 4.5; DESIGN.md 3.5.5): bindings, assignments,
// arguments, returns, if expressions with fixed and dynamic arms, matrices
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pmf(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
fn total(v: f64[]) -> f64 {
    var s = 0.0
    for x in v {
        s += x
    }
    return s
}
fn first3(v: f64[3]) -> f64 {
    return v[0] * 100.0 + v[1] * 10.0 + v[2]
}
fn mkdyn() -> f64[] {
    return [1.0, 2.0, 3.0, 4.0]
}
fn mkfix() -> f64[2] {
    return ones(2)
}
var d: f64[] = [1.0, 2.0]
printf("%d %g\n", len(d), total(d))
d = [5.0, 6.0, 7.0]
printf("%d %g\n", len(d), total([1.0, 2.0, 3.0]))
let f: f64[3] = d
printf("%g\n", first3(f))
printf("%g\n", first3(zeros(3) + 1.0))
pf(mkdyn())
let g = mkfix()
printf("%g %g\n", g[0], g[1])
var e = [1.0, 2.0]
e = d[0..2]
pf(e)
let c = len(d) > 2
let h = if c { [1.0, 2.0] } else { [3.0, 4.0, 5.0] }
printf("%d\n", len(h))
let k = if c { d } else { [0.0] }
printf("%d\n", len(k))
let q = if c { [1.0, 2.0] } else { [3.0, 4.0] }
pf(q)
var m: f64[,] = [1.0, 2.0; 3.0, 4.0]
m = zeros(1, 3)
pmf(m)
let fm: f64[1,3] = m
pmf(fm)
