let v = [1.0, 2.0]
var w = zeros(3)
pf([v, 3.0])
pf([0.0, v, w])
pf([1, v])
pf([(0..2), 0.5])
pvi([(0..3), 10, (5..7)])
let A = [1.0, 2.0; 3.0, 4.0]
let B = [5.0; 6.0]
pmf([A, B])
pmf([A; [7.0, 8.0]])
pmf([v; v])
pmf([A, B; v.row, 9.0])
pmf([zeros(2, 1), A])
pmf([A; ones(1, 2)])
pf([zeros(0), v])
pmf([zeros(0, 2); A])
pvb([b, true])
pf([v])
let e: f64[] = []
pf(e)
let em: f64[,] = []
pmf(em)
let e0: f64[0] = []
