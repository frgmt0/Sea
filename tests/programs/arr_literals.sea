// arr_literals -- array literals (LANGUAGE.md 6.9, 4.5): fixed vectors and matrices of each scalar kind,
// untyped elements, trailing separators and newlines, 256 (fixed) and 257 (dynamic)
// elements, vector and matrix concatenation, [] under each context that types it
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn pvb(v: bool[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn pmf(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
fn pmi(A: i64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %d", A[i, j])
        }
    }
    printf("\n")
}
fn cnt(v: i64[]) -> i64 {
    return len(v)
}
fn none() -> bool[] {
    return []
}
let a = [0.135, 2.5, 50, 97.5, 99.865]
pf(a)
let i = 3
let idx = [2 * i, 2 * i + 1, 2 * 0, 1]
pvi(idx)
let b = [true, false, ]
pvb(b)
let m = [1, 2, 3;
    4, 5, 6;]
pmi(m)
let mf = [1, 2.5; -3, 4]
pmf(mf)
let col = [1.0; 2.0; 3.0]
pmf(col)
printf("%d %d %d %d\n", len(a), rows(m), cols(m), numel(col))
