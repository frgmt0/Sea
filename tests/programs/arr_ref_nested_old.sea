// arr_ref_nested_old -- f(a, g(ref a)) where g replaces a: f sees the old array (LANGUAGE.md 6.8 rule 5,
// 8.3; DESIGN.md 3.6.6 rule 12 (a)), and nothing leaks
fn g(ref v: f64[]) -> f64 {
    v = filled(9.0, 1)
    return 0.5
}
fn f(old: f64[], x: f64) -> f64 {
    return old[0] + f64(len(old)) + x
}
var a = ones(3)
let r = f(a, g(ref a))
printf("%g %d %g\n", r, len(a), a[0])
let r2 = f(a, g(ref a))
printf("%g %d %g\n", r2, len(a), a[0])
