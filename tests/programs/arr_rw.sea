// arr_rw -- element read and write of f64[], i64[], bool[], f64[,], i64[,] and bool[,] by scalar
// indices (LANGUAGE.md 5.1, 5.2, 5.5)
var v = zeros(4)
for i in 0..4 {
    v[i] = f64(i) * 0.5
}
printf("%g %g %g %g\n", v[0], v[1], v[2], v[3])
var iv = filled(0, 4)
for i in 0..4 {
    iv[i] = i * i
}
printf("%d %d %d %d\n", iv[0], iv[1], iv[2], iv[3])
var bv = filled(false, 3)
bv[1] = true
printf("%d %d %d\n", bv[0], bv[1], bv[2])
if bv[1] && !bv[2] {
    printf("bool ok\n")
}
var A = zeros(2, 3)
for j in 0..3 {
    for i in 0..2 {
        A[i, j] = f64(i + 10 * j)
    }
}
printf("%g %g %g %g %g %g\n", A[0, 0], A[1, 0], A[0, 1], A[1, 1], A[0, 2], A[1, 2])
var M = filled(0, 3, 2)
M[2, 1] = -5
M[0, 1] = 9223372036854775807
printf("%d %d %d\n", M[2, 1], M[0, 1], M[1, 0])
var B = filled(true, 2, 2)
B[1, 0] = false
printf("%d %d %d %d\n", B[0, 0], B[1, 0], B[0, 1], B[1, 1])
let x = A[1, 2] + v[3]
printf("%g\n", x)
