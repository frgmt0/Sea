// call6_named_cvt_fixed -- a named call out of parameter order passing a fixed-size i64[3] to an f64[]
// parameter: the array converts element by element (LANGUAGE.md 4.2 (c), 8.1) and the arguments are
// bound in source order (L-cp). Before 9b this crashed sealoop ("bad record", seacheck's cty): a
// pre-existing defect fixed in 9b. f = 1 + 3 + 5 = 9.
fn f(a: f64[], b: i64 = 2) -> f64 {
    return a[0] + a[2] + f64(b)
}
let v: i64[3] = [1, 2, 3]
let w = f(b: 5, a: v)
printf("%g\n", w)
