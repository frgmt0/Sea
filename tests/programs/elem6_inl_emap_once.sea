// elem6_inl_emap_once -- an elemental application with an array argument inside a function with one call site (LANGUAGE.md 8.x elemental
// functions, 6.3): the function is inlined; `let (a, _) = two(v, 1.0)` binds the first result, sq maps over it
fn pv(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
elemental fn sq(x: f64) -> f64 {
    return x * x
}
elemental fn two(x: f64, y: f64) -> (f64, f64) {
    return (x + y, x - y)
}
fn once(v: f64[]) -> f64[] {
    let (a, _) = two(v, 1.0)
    return sq(a)
}
pv(once([1.0, 2.0]))
