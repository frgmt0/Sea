// elem_fixed -- fixed-size elemental arguments give fixed-size results (the annotations f64[3], f64[2,2], f64[2,3] bind
// them; a result that were dynamic would still pass, so err_elem6_fixed_result proves it at compile time);
// a fixed and a dynamic argument give a dynamic result (r_elem6_mixed_dynamic proves it) (LANGUAGE.md 4.5, 8.5)
fn pv(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pm(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
fn ramp(n: i64) -> f64[] {
    var v = zeros(n)
    for i in 0..n {
        v[i] = f64(i) * 0.5
    }
    return v
}
elemental fn f2(x: f64, y: f64) -> f64 {
    return x * 10.0 + y
}
fn sum3(v: f64[3]) -> f64 {
    return v[0] + v[1] + v[2]
}
let a = [1.0, 2.0, 3.0]
let b = [0.5, 0.25, 0.125]
let r: f64[3] = f2(a, b)
pv(r)
printf("%g\n", sum3(f2(a, 1.0)))
printf("%g\n", sum3(f2(0.5, b)))
let M = [1.0, 2.0; 3.0, 4.0]
let N: f64[2,2] = f2(M, M)
pm(N)
let c = [1.0, 2.0]
let d = [10.0, 20.0, 30.0]
let P: f64[2,3] = f2(c.col, d.row)
pm(P)
let Q: f64[2,2] = f2(M, c.col)
pm(Q)
let dyn3 = ramp(3)
let m1 = f2(a, dyn3)
pv(m1)
printf("%d\n", len(f2(dyn3, b)))
let m2: f64[3] = f2(a, dyn3)
pv(m2)
let m3 = f2(M, ones(2, 2))
pm(m3)
