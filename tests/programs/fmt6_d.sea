// fmt6_d -- format of the cases of fmt_d.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
printf("[%d] [%d] [%d]\n", 0, 42, -42)
print(format("[%d] [%d] [%d]\n", 0, 42, -42))
printf("[%d]\n", 9223372036854775807)
print(format("[%d]\n", 9223372036854775807))
printf("[%d]\n", -9223372036854775808)
print(format("[%d]\n", -9223372036854775808))
printf("[%5d] [%-5d] [%05d]\n", 42, 42, -42)
print(format("[%5d] [%-5d] [%05d]\n", 42, 42, -42))
printf("[%+d] [%+d] [% d] [% d]\n", 42, 0, 42, -42)
print(format("[%+d] [%+d] [% d] [% d]\n", 42, 0, 42, -42))
printf("[%+5d] [%-+5d]\n", -3, 3)
print(format("[%+5d] [%-+5d]\n", -3, 3))
printf("[%3d]\n", 12345)
print(format("[%3d]\n", 12345))
printf("[%i] [%4i]\n", 7, -7)
print(format("[%i] [%4i]\n", 7, -7))
printf("[%d]\n", 2 - 8)
print(format("[%d]\n", 2 - 8))
printf("[%d]\n", 1_000_000)
print(format("[%d]\n", 1_000_000))
printf("[%d]\n", 0xFF)
print(format("[%d]\n", 0xFF))
