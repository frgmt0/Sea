// fmt6_d_ext -- the printf lines of fmt_d_ext.sea, each followed by print(format(...)) of the same arguments, byte-equal
// (LANGUAGE.md 11.1: %d of a bool, of -0.0, C integer rules for an integral f64, %e for a non-integral one)
printf("[%d] [%d] [%i]\n", true, false, 1 < 2)
print(format("[%d] [%d] [%i]\n", true, false, 1 < 2))
printf("[%5d] [%-3d]\n", true, false)
print(format("[%5d] [%-3d]\n", true, false))
printf("[%d] [%+d] [% d]\n", -0.0, -0.0, -0.0)
print(format("[%d] [%+d] [% d]\n", -0.0, -0.0, -0.0))
printf("[%.3d] [%.3d] [%5.3d] [%-6.3d]\n", 7.0, -7.0, 7.0, 7.0)
print(format("[%.3d] [%.3d] [%5.3d] [%-6.3d]\n", 7.0, -7.0, 7.0, 7.0))
printf("[%.0d] [%3.0d] [%.0d]\n", 0.0, 0.0, 5.0)
print(format("[%.0d] [%3.0d] [%.0d]\n", 0.0, 0.0, 5.0))
printf("[%.3d] [%.10i]\n", 1.5, -2.5)
print(format("[%.3d] [%.10i]\n", 1.5, -2.5))
