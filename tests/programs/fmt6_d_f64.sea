// fmt6_d_f64 -- format of the cases of fmt_d_f64.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
printf("[%d] [%d]\n", 3.0, -3.0)
print(format("[%d] [%d]\n", 3.0, -3.0))
printf("[%d]\n", 1e20)
print(format("[%d]\n", 1e20))
printf("[%d]\n", 9223372036854775808.0)
print(format("[%d]\n", 9223372036854775808.0))
printf("[%d]\n", 1.7976931348623157e308)
print(format("[%d]\n", 1.7976931348623157e308))
printf("[%5d] [%-5d] [%+d] [%05d]\n", 2.0, 2.0, 2.0, -3.0)
print(format("[%5d] [%-5d] [%+d] [%05d]\n", 2.0, 2.0, 2.0, -3.0))
printf("[%d]\n", 1.5)
print(format("[%d]\n", 1.5))
printf("[%12d] [%14d]\n", 1.5, -2.5)
print(format("[%12d] [%14d]\n", 1.5, -2.5))
printf("[%+d] [% d]\n", 0.1, 0.1)
print(format("[%+d] [% d]\n", 0.1, 0.1))
printf("[%-15d]\n", 0.1)
print(format("[%-15d]\n", 0.1))
printf("[%d]\n", 5e-324)
print(format("[%d]\n", 5e-324))
printf("[%i]\n", 1e-3)
print(format("[%i]\n", 1e-3))
