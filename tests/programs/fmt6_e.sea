// fmt6_e -- format of the cases of fmt_e.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
printf("[%e]\n", 0.0)
print(format("[%e]\n", 0.0))
printf("[%e]\n", -0.0)
print(format("[%e]\n", -0.0))
printf("[%e]\n", 1.0)
print(format("[%e]\n", 1.0))
printf("[%e]\n", 123456.789)
print(format("[%e]\n", 123456.789))
printf("[%.2e] [%.2e]\n", 1.125, 1.135)
print(format("[%.2e] [%.2e]\n", 1.125, 1.135))
printf("[%.0e] [%#.0e]\n", 2.5, 2.5)
print(format("[%.0e] [%#.0e]\n", 2.5, 2.5))
printf("[%E]\n", 1e-10)
print(format("[%E]\n", 1e-10))
printf("[%e] [%e]\n", 1e100, 1e-100)
print(format("[%e] [%e]\n", 1e100, 1e-100))
printf("[%e]\n", 5e-324)
print(format("[%e]\n", 5e-324))
printf("[%e]\n", 1.7976931348623157e308)
print(format("[%e]\n", 1.7976931348623157e308))
printf("[%.16e]\n", 0.1)
print(format("[%.16e]\n", 0.1))
printf("[%12.3e] [%-12.3e]\n", -1234.5, -1234.5)
print(format("[%12.3e] [%-12.3e]\n", -1234.5, -1234.5))
printf("[%+e] [% e]\n", 1.5, 1.5)
print(format("[%+e] [% e]\n", 1.5, 1.5))
printf("[%012.3e]\n", 1234.5)
print(format("[%012.3e]\n", 1234.5))
printf("[%e]\n", 9.9999996)
print(format("[%e]\n", 9.9999996))
printf("[%e] [%.3E]\n", 7, -1234567)
print(format("[%e] [%.3E]\n", 7, -1234567))
printf("[%.30e]\n", 1e23)
print(format("[%.30e]\n", 1e23))
