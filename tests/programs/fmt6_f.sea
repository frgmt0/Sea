// fmt6_f -- format of the cases of fmt_f.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
let big = 9007199254740993   // an i64 that %f converts, rounding to even
printf("[%f]\n", 0.0)
print(format("[%f]\n", 0.0))
printf("[%f]\n", -0.0)
print(format("[%f]\n", -0.0))
printf("[%f]\n", 1.5)
print(format("[%f]\n", 1.5))
printf("[%f]\n", -2.75)
print(format("[%f]\n", -2.75))
printf("[%.0f] [%.0f] [%.0f] [%.0f]\n", 0.5, 1.5, 2.5, 3.5)
print(format("[%.0f] [%.0f] [%.0f] [%.0f]\n", 0.5, 1.5, 2.5, 3.5))
printf("[%.2f] [%.2f] [%.2f]\n", 0.125, 0.375, 2.675)
print(format("[%.2f] [%.2f] [%.2f]\n", 0.125, 0.375, 2.675))
printf("[%.1f] [%.1f]\n", 0.05, 0.25)
print(format("[%.1f] [%.1f]\n", 0.05, 0.25))
printf("[%.3f]\n", 1e-4)
print(format("[%.3f]\n", 1e-4))
printf("[%.20f]\n", 0.1)
print(format("[%.20f]\n", 0.1))
printf("[%f]\n", 1e20)
print(format("[%f]\n", 1e20))
printf("[%f]\n", 1.7976931348623157e308)
print(format("[%f]\n", 1.7976931348623157e308))
printf("[%f] [%.0f]\n", 5e-324, 5e-324)
print(format("[%f] [%.0f]\n", 5e-324, 5e-324))
printf("[%10.4f]\n", 3.14159265358979)
print(format("[%10.4f]\n", 3.14159265358979))
printf("[%-10.2f]\n", 3.14159265358979)
print(format("[%-10.2f]\n", 3.14159265358979))
printf("[%+.3f] [% .3f] [%+.3f] [% .3f]\n", 2.0, 2.0, -2.0, -2.0)
print(format("[%+.3f] [% .3f] [%+.3f] [% .3f]\n", 2.0, 2.0, -2.0, -2.0))
printf("[%010.3f] [%010.3f]\n", -3.14159, 3.14159)
print(format("[%010.3f] [%010.3f]\n", -3.14159, 3.14159))
printf("[%-010.3f]\n", 3.14159)
print(format("[%-010.3f]\n", 3.14159))
printf("[%#.0f] [%.0f]\n", 3.0, 3.0)
print(format("[%#.0f] [%.0f]\n", 3.0, 3.0))
printf("[%F]\n", 1.25)
print(format("[%F]\n", 1.25))
printf("[%5.1f]\n", 99.95)
print(format("[%5.1f]\n", 99.95))
printf("[%.1f]\n", 0.95)
print(format("[%.1f]\n", 0.95))
printf("[%f] [%.0f]\n", 3, big)
print(format("[%f] [%.0f]\n", 3, big))
printf("[%3f]\n", 12.5)
print(format("[%3f]\n", 12.5))
