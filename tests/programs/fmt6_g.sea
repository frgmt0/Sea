// fmt6_g -- format of the cases of fmt_g.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
printf("[%g] [%g]\n", 0.0, -0.0)
print(format("[%g] [%g]\n", 0.0, -0.0))
printf("[%g] [%g]\n", 100000.0, 1000000.0)
print(format("[%g] [%g]\n", 100000.0, 1000000.0))
printf("[%g] [%g]\n", 1e-4, 1e-5)
print(format("[%g] [%g]\n", 1e-4, 1e-5))
printf("[%g]\n", 123456789.0)
print(format("[%g]\n", 123456789.0))
printf("[%g] [%.17g]\n", 0.1, 0.1)
print(format("[%g] [%.17g]\n", 0.1, 0.1))
printf("[%g] [%#g]\n", 3.0, 3.0)
print(format("[%g] [%#g]\n", 3.0, 3.0))
printf("[%G] [%G]\n", 1e-10, 1.5e20)
print(format("[%G] [%G]\n", 1e-10, 1.5e20))
printf("[%.0g] [%.1g] [%.1g]\n", 2.5, 0.95, 0.96)
print(format("[%.0g] [%.1g] [%.1g]\n", 2.5, 0.95, 0.96))
printf("[%.2g]\n", 99.5)
print(format("[%.2g]\n", 99.5))
printf("[%10.4g] [%-10.4g]\n", 3.14159265358979, 3.14159265358979)
print(format("[%10.4g] [%-10.4g]\n", 3.14159265358979, 3.14159265358979))
printf("[%+g] [% g]\n", 1.5, 1.5)
print(format("[%+g] [% g]\n", 1.5, 1.5))
printf("[%010g]\n", -1.5)
print(format("[%010g]\n", -1.5))
printf("[%.17g]\n", 1.7976931348623157e308)
print(format("[%.17g]\n", 1.7976931348623157e308))
printf("[%g]\n", 5e-324)
print(format("[%g]\n", 5e-324))
printf("[%g] [%g]\n", 1234567, -42)
print(format("[%g] [%g]\n", 1234567, -42))
printf("[%#.3g] [%.3g]\n", 1.0, 1.0)
print(format("[%#.3g] [%.3g]\n", 1.0, 1.0))
printf("[%g]\n", 0.0001234567)
print(format("[%g]\n", 0.0001234567))
printf("[%.3g]\n", 1e-5)
print(format("[%.3g]\n", 1e-5))
