// fmt6_nonfinite -- format of the cases of fmt_nonfinite.sea, printed with print and byte-equal to the printf line of the same
// arguments (LANGUAGE.md 11.1, 10.9: format(F, ...) is the str that printf(F, ...) writes); the
// expected bytes are progfmt.py's exact decimal oracle, each case twice
printf("[%f] [%f] [%f]\n", inf, -inf, nan)
print(format("[%f] [%f] [%f]\n", inf, -inf, nan))
printf("[%+f] [% f] [%+f] [% f]\n", inf, inf, -inf, -inf)
print(format("[%+f] [% f] [%+f] [% f]\n", inf, inf, -inf, -inf))
printf("[%+f] [% f] [%f]\n", nan, nan, -nan)
print(format("[%+f] [% f] [%f]\n", nan, nan, -nan))
printf("[%e] [%E] [%g] [%G] [%F]\n", inf, inf, -inf, nan, nan)
print(format("[%e] [%E] [%g] [%G] [%F]\n", inf, inf, -inf, nan, nan))
printf("[%+8.2f]\n", inf)
print(format("[%+8.2f]\n", inf))
printf("[%08d]\n", nan)
print(format("[%08d]\n", nan))
printf("[%08.3f] [%-8f] [%#g]\n", inf, -inf, inf)
print(format("[%08.3f] [%-8f] [%#g]\n", inf, -inf, inf))
printf("[%d] [%5i] [%-6d]\n", inf, -inf, nan)
print(format("[%d] [%5i] [%-6d]\n", inf, -inf, nan))
printf("[%2f]\n", -inf)
print(format("[%2f]\n", -inf))
printf("[%f] [%f]\n", 1.0 / 0.0, -1.0 / 0.0)
print(format("[%f] [%f]\n", 1.0 / 0.0, -1.0 / 0.0))
printf("[%f]\n", 0.0 / 0.0)
print(format("[%f]\n", 0.0 / 0.0))
