// fmt_hex -- %x and %X of i64 (LANGUAGE.md 11.1; DESIGN.md 2.15.2, Decisions 147 (a), 150 (d)): 0, 255, -1, -2^63,
// 2^63 - 1 with width, precision, the flags - 0 # and their combinations (C99 7.21.6.1: the prefix only before a
// non-zero value, precision 0 of 0 prints no digit, the order prefix, zeros, digits, the 0 flag ignored with a
// precision or -), + and space accepted and ignored; each case through printf and print(format(...)), byte-equal;
// expected bytes from a transcription of C99's rules, every case also checked against /usr/bin/printf
printf("[%x %x %x %x %x]\n", 0, 255, -1, -9223372036854775808, 9223372036854775807)
print(format("[%x %x %x %x %x]\n", 0, 255, -1, -9223372036854775808, 9223372036854775807))
printf("[%X %X %X %X %X]\n", 0, 255, -1, -9223372036854775808, 9223372036854775807)
print(format("[%X %X %X %X %X]\n", 0, 255, -1, -9223372036854775808, 9223372036854775807))
printf("[%08X]\n", 0x18FF50E5)
print(format("[%08X]\n", 0x18FF50E5))
printf("[%5x %5x %5x]\n", 255, 0, -1)
print(format("[%5x %5x %5x]\n", 255, 0, -1))
printf("[%-5x %-5x]\n", 255, 0)
print(format("[%-5x %-5x]\n", 255, 0))
printf("[%05x %05x]\n", 255, 0)
print(format("[%05x %05x]\n", 255, 0))
printf("[%020x]\n", -1)
print(format("[%020x]\n", -1))
printf("[%.3x %.3x %.3x]\n", 255, 0, 0x12345)
print(format("[%.3x %.3x %.3x]\n", 255, 0, 0x12345))
printf("[%.0x %.0x]\n", 0, 255)
print(format("[%.0x %.0x]\n", 0, 255))
printf("[%5.0x]\n", 0)
print(format("[%5.0x]\n", 0))
printf("[%.20x]\n", 255)
print(format("[%.20x]\n", 255))
printf("[%#x %#x %#x %#x]\n", 255, 0, -1, 9223372036854775807)
print(format("[%#x %#x %#x %#x]\n", 255, 0, -1, 9223372036854775807))
printf("[%#X %#X %#X]\n", 255, 0, -9223372036854775808)
print(format("[%#X %#X %#X]\n", 255, 0, -9223372036854775808))
printf("[%#010x %#010x]\n", 255, 0)
print(format("[%#010x %#010x]\n", 255, 0))
printf("[%#.4x %#.4x]\n", 255, 0)
print(format("[%#.4x %#.4x]\n", 255, 0))
printf("[%#.0x %#.0x]\n", 0, 1)
print(format("[%#.0x %#.0x]\n", 0, 1))
printf("[%#10x]\n", 255)
print(format("[%#10x]\n", 255))
printf("[%-#10x]\n", 255)
print(format("[%-#10x]\n", 255))
printf("[%#020x]\n", -1)
print(format("[%#020x]\n", -1))
printf("[%#020X]\n", -9223372036854775808)
print(format("[%#020X]\n", -9223372036854775808))
printf("[%08.3x]\n", 255)
print(format("[%08.3x]\n", 255))
printf("[%-08x]\n", 255)
print(format("[%-08x]\n", 255))
printf("[%-#8.4x]\n", 255)
print(format("[%-#8.4x]\n", 255))
printf("[%+x]\n", 255)
print(format("[%+x]\n", 255))
printf("[% x]\n", 255)
print(format("[% x]\n", 255))
printf("[%+08X]\n", 255)
print(format("[%+08X]\n", 255))
printf("[%+ #x]\n", 255)
print(format("[%+ #x]\n", 255))
printf("[%3x]\n", 0x18FF50E5)
print(format("[%3x]\n", 0x18FF50E5))
