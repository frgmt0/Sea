// fn_call -- functions with scalar parameters and results, visible before their declaration,
// arguments evaluated left to right, early return, implicit conversion of arguments
// (LANGUAGE.md 8.1, 8.2, 6.8 rule 5, 4.2).
printf("%d\n", add(2, 3))
printf("%g\n", hyp2(3, 4))
greet()
printf("%d %d\n", early(5), early(-5))
printf("%d\n", add(order(1), order(2)))
printf("%d\n", add(add(1, 2), add(3, 4)))
say(1)
say(0)
fn add(a: i64, b: i64) -> i64 {
    return a + b
}
fn hyp2(x: f64, y: f64) -> f64 {
    return x * x + y * y
}
fn greet() {
    printf("hello\n")
}
fn early(x: i64) -> i64 {
    if x > 0 {
        return 1
    }
    return 0
}
fn order(k: i64) -> i64 {
    printf("arg%d ", k)
    return k
}
fn say(x: i64) {
    if x > 0 {
        printf("pos\n")
        return
    }
    printf("nonpos\n")
}
