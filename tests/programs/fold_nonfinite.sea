// fold_nonfinite -- folded overflow, x / 0, inf and nan operands, -0 and subnormals print as at run time (DESIGN.md 2.8 U1; LANGUAGE.md 11.1)
printf("%f %f %f\n", 1e308 * 10.0, -1.0 / 0.0, 1e200 ^ 2)
printf("%f %f %f %f\n", inf - inf, 0.0 * inf, -nan, nan + 1.0)
printf("%g %g %g\n", -0.0 * 1.0, 1e-320 * 1e-10, 5e-324 * 1.5)
