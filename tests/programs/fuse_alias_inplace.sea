// fuse_alias_inplace -- F1 (5) in place (DESIGN.md 2.12.4; LANGUAGE.md 5.5): `x = x + 1.0`, `x = x * x - x * 0.5`, a matrix and a
// fixed-size vector updated from their own elements at the element being written
fn pv(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %.17g", x)
    }
    printf("\n")
}
fn pm(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %.17g", A[i, j])
        }
    }
    printf("\n")
}
var x: f64[] = [0.1, 2.5, -3.0, 1e+16, 0.7, -0.0]
x = x + 1.0
pv(x)
x = x * x - x * 0.5
pv(x)
var A: f64[,] = [1.5, -2.0, 0.25; 3.0, 100000000.0, -0.5]
A = A * A + 1.0
pm(A)
var q: f64[3] = [1.0, 2.0, 3.0]
q = q + q * 0.5
pv(q)
