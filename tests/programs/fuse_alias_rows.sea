// fuse_alias_rows -- F1 (5) and F4 (DESIGN.md 2.12.4; LANGUAGE.md 5.5): `T[1..r-1, :] = avg(T[0..r-2, :], T[2..r, :])` with an
// elemental function reads the old rows (the reference's temporary); then the rows above, at and below
fn pm(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %.17g", A[i, j])
        }
    }
    printf("\n")
}
elemental fn avg(a: f64, b: f64) -> f64 {
    return (a + b) * 0.5
}
var T = zeros(5, 3)
for j in 0..3 {
    for i in 0..5 {
        T[i, j] = f64(i * i * 3 + j) + 0.125
    }
}
let r = rows(T)
T[1..r-1, :] = avg(T[0..r-2, :], T[2..r, :])
pm(T)
T[1..r-1, :] = T[0..r-2, :] * 0.25 + T[1..r-1, :] - T[2..r, :] * 0.5
pm(T)
