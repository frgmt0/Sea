// fuse_group_fixed -- F2 with fixed-size operands and targets (LANGUAGE.md 4.5, DESIGN.md 2.12.4 F2 (2), (6)): `q: f64[4]` and
// `Q: f64[2,2]` written in place by groups whose roots all have one static shape (no space test, no split copy)
fn pv(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %.17g", x)
    }
    printf("\n")
}
fn pm(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %.17g", A[i, j])
        }
    }
    printf("\n")
}
var q: f64[4] = [1.5, -2.0, 1e+16, 0.25]
let f: f64[4] = [3.0, 0.5, -1.0, 8.0]
let a = q * f + 0.5
q = a * a - q
let r = q + f * 1e-16
pv(q)
pv(r)
var Q: f64[2,2] = [1.0, 2.0; 3.0, 4.0]
let FF = [0.5, -1.0; 2.0, 0.001]
Q = Q * FF - 1.0
let R = Q * Q + FF
pm(Q)
pm(R)
