// fuse_group_split_bcast -- F2 (2) the split copy (DESIGN.md 2.12.4, L-eq): a group over a 1 x 3 operand (`a`, space 1 x 3) and
// the same operand broadcast against a 2 x 3 matrix (`b`, `c`, space 2 x 3): no error, each statement over
// its own space
fn pm(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %.17g", A[i, j])
        }
    }
    printf("\n")
}
var R = zeros(1, 3)
let rv = [0.5, -1.25, 1e+16]
for j in 0..3 {
    R[0, j] = rv[j]
}
let M: f64[,] = [1.0, 2.0, 3.0; -0.5, 0.001, 7.75]
let a = R * 2.0 + 0.5
let b = R - M * 0.25
let c = b * b
pm(a)
pm(b)
pm(c)
