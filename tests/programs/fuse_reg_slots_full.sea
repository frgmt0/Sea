// fuse_reg_slots_full -- F1, F2 (DESIGN.md 2.12.4), 7c regression: trees large enough to exhaust the fusion pass's
// operand and temporary slots (about 200 leaves in `a`, about 100 uses of `a` in `b`). Fusion has to stop and
// fall back to the unfused evaluation instead of overflowing a table; the values are those of evaluating each
// element's tree strictly left to right in IEEE binary64 (LANGUAGE.md 6.8). Expected output computed by an
// independent Python evaluation of the two expressions.
let x: f64[] = [1.0, 2.0, 3.0, 4.0, 5.5]
let y: f64[] = [0.5, -1.0, 2.0, 7.0, 3.25]
let a = (x * 1.5 + x * 2.5 + y / 3.25 + x * 4.5 + x * 5.5 + y / 6.25 + x * 7.5 + x * 8.5 + y / 9.25 + x * 10.5 + x * 11.5 + y / 12.25 + x * 13.5 + x * 14.5 + y / 15.25 + x * 16.5 + x * 17.5 + y / 18.25 + x * 19.5 + x * 20.5 + y / 21.25 + x * 22.5 + x * 23.5 + y / 24.25 + x * 25.5 + x * 26.5 + y / 27.25 + x * 28.5 + x * 29.5 + y / 30.25 + x * 31.5 + x * 32.5 + y / 33.25 + x * 34.5 + x * 35.5 + y / 36.25 + x * 37.5 + x * 38.5 + y / 39.25 + x * 40.5 + x * 41.5 + y / 42.25 + x * 43.5 + x * 44.5 + y / 45.25 + x * 46.5 + x * 47.5 + y / 48.25 + x * 49.5 + x * 50.5 + y / 51.25 + x * 52.5 + x * 53.5 + y / 54.25 + x * 55.5 + x * 56.5 + y / 57.25 + x * 58.5 + x * 59.5 + y / 60.25 + x * 61.5 + x * 62.5 + y / 63.25 + x * 64.5 + x * 65.5 + y / 66.25 + x * 67.5 + x * 68.5 + y / 69.25 + x * 70.5 + x * 71.5 + y / 72.25 + x * 73.5 + x * 74.5 + y / 75.25 + x * 76.5 + x * 77.5 + y / 78.25 + x * 79.5 + x * 80.5 + y / 81.25 + x * 82.5 + x * 83.5 + y / 84.25 + x * 85.5 + x * 86.5 + y / 87.25 + x * 88.5 + x * 89.5 + y / 90.25 + x * 91.5 + x * 92.5 + y / 93.25 + x * 94.5 + x * 95.5 + y / 96.25 + x * 97.5 + x * 98.5 + y / 99.25 + x * 100.5 + x * 101.5 + y / 102.25 + x * 103.5 + x * 104.5 + y / 105.25 + x * 106.5 + x * 107.5 + y / 108.25 + x * 109.5 + x * 110.5 + y / 111.25 + x * 112.5 + x * 113.5 + y / 114.25 + x * 115.5 + x * 116.5 + y / 117.25 + x * 118.5 + x * 119.5 + y / 120.25 + x * 121.5 + x * 122.5 + y / 123.25 + x * 124.5 + x * 125.5 + y / 126.25 + x * 127.5 + x * 128.5 + y / 129.25 + x * 130.5 + x * 131.5 + y / 132.25 + x * 133.5 + x * 134.5 + y / 135.25 + x * 136.5 + x * 137.5 + y / 138.25 + x * 139.5 + x * 140.5 + y / 141.25 + x * 142.5 + x * 143.5 + y / 144.25 + x * 145.5 + x * 146.5 + y / 147.25 + x * 148.5 + x * 149.5 + y / 150.25 + x * 151.5 + x * 152.5 + y / 153.25 + x * 154.5 + x * 155.5 + y / 156.25 + x * 157.5 + x * 158.5 + y / 159.25 + x * 160.5 + x * 161.5 + y / 162.25 + x * 163.5 + x * 164.5 + y / 165.25 + x * 166.5 + x * 167.5 + y / 168.25 + x * 169.5 + x * 170.5 + y / 171.25 + x * 172.5 + x * 173.5 + y / 174.25 + x * 175.5 + x * 176.5 + y / 177.25 + x * 178.5 + x * 179.5 + y / 180.25 + x * 181.5 + x * 182.5 + y / 183.25 + x * 184.5 + x * 185.5 + y / 186.25 + x * 187.5 + x * 188.5 + y / 189.25 + x * 190.5 + x * 191.5 + y / 192.25 + x * 193.5 + x * 194.5 + y / 195.25 + x * 196.5 + x * 197.5 + y / 198.25 + x * 199.5) * 0.001
let b = (a * 1.0 - x - a * 3.0 - x - a * 5.0 - x - a * 7.0 - x - a * 9.0 - x - a * 11.0 - x - a * 13.0 - x - a * 15.0 - x - a * 17.0 - x - a * 19.0 - x - a * 21.0 - x - a * 23.0 - x - a * 25.0 - x - a * 27.0 - x - a * 29.0 - x - a * 31.0 - x - a * 33.0 - x - a * 35.0 - x - a * 37.0 - x - a * 39.0 - x - a * 41.0 - x - a * 43.0 - x - a * 45.0 - x - a * 47.0 - x - a * 49.0 - x - a * 51.0 - x - a * 53.0 - x - a * 55.0 - x - a * 57.0 - x - a * 59.0 - x - a * 61.0 - x - a * 63.0 - x - a * 65.0 - x - a * 67.0 - x - a * 69.0 - x - a * 71.0 - x - a * 73.0 - x - a * 75.0 - x - a * 77.0 - x - a * 79.0 - x - a * 81.0 - x - a * 83.0 - x - a * 85.0 - x - a * 87.0 - x - a * 89.0 - x - a * 91.0 - x - a * 93.0 - x - a * 95.0 - x - a * 97.0 - x - a * 99.0 - x - a * 101.0 - x - a * 103.0 - x - a * 105.0 - x - a * 107.0 - x - a * 109.0 - x - a * 111.0 - x - a * 113.0 - x - a * 115.0 - x - a * 117.0 - x - a * 119.0 - x - a * 121.0 - x - a * 123.0 - x - a * 125.0 - x - a * 127.0 - x - a * 129.0 - x - a * 131.0 - x - a * 133.0 - x - a * 135.0 - x - a * 137.0 - x - a * 139.0 - x - a * 141.0 - x - a * 143.0 - x - a * 145.0 - x - a * 147.0 - x - a * 149.0 - x - a * 151.0 - x - a * 153.0 - x - a * 155.0 - x - a * 157.0 - x - a * 159.0 - x - a * 161.0 - x - a * 163.0 - x - a * 165.0 - x - a * 167.0 - x - a * 169.0 - x - a * 171.0 - x - a * 173.0 - x - a * 175.0 - x - a * 177.0 - x - a * 179.0 - x - a * 181.0 - x - a * 183.0 - x - a * 185.0 - x - a * 187.0 - x - a * 189.0 - x - a * 191.0 - x - a * 193.0 - x - a * 195.0 - x - a * 197.0 - x - a * 199.0) + a
printf("%.17g %.17g %.17g %.17g\n", a[0], a[4], b[1], b[3])
