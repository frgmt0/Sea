// fuse_reg_two_tbinds -- F5, F2 (DESIGN.md 2.12.4), 7c regression: two consecutive tuple bindings of an elemental
// function with two results (`let (g, h) = f2(x, x)` and `let (i, j) = f2(x, 2.0)`). Each binding is its own
// fused loop with its own result arrays: g = x + x, h = x * x, i = x + 2, j = x * 2; g[0] = 2, h[1] = 4,
// i[2] = 5, j[3] = 8.
elemental fn f2(x: f64, y: f64) -> (f64, f64) {
    return (x + y, x * y)
}
let x: f64[] = [1.0, 2.0, 3.0, 4.0]
let (g, h) = f2(x, x)
let (i, j) = f2(x, 2.0)
printf("%.17g %.17g %.17g %.17g\n", g[0], h[1], i[2], j[3])
