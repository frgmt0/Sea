// heap_early_exit -- early exits while array temporaries are held: return from an element loop over a
// selection, break and continue in a loop over a range value expression, returns of
// selections and of element-wise results, break out of a while (DESIGN.md 3.6.6 rule 16)
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn mk(n: i64) -> f64[] {
    var v = zeros(n)
    for i in 0..n {
        v[i] = f64(i)
    }
    return v
}
fn mki(n: i64) -> i64[] {
    return (0..n) * 2
}
fn mkm() -> f64[,] {
    return [1.0, 2.0; 3.0, 4.0]
}
fn firstbig(v: f64[], lim: f64) -> f64 {
    for x in v[v > lim] {
        return x
    }
    return -1.0
}
fn sumto(n: i64, stop: i64) -> i64 {
    var s = 0
    for x in (0..n) * 2 {
        if x == stop {
            break
        }
        if x == 2 {
            continue
        }
        s += x
    }
    return s
}
fn pick(c: bool) -> f64[] {
    let a = mk(3) * 2.0
    let b = [9.0, 8.0]
    if c {
        return a[1..3]
    }
    return b + a[0..2]
}
printf("%g %g\n", firstbig(mk(5), 2.5), firstbig(mk(3), 5.0))
printf("%d %d\n", sumto(5, 100), sumto(5, 6))
pf(pick(true))
pf(pick(false))
var n = 0
while true {
    let w = mk(4)[1..4] + 1.0
    n += 1
    if n == 2 {
        break
    }
}
printf("%d\n", n)
