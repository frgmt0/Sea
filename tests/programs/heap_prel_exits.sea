// heap_prel_exits -- the early returns of linspace (n < 1, n = 1) and exits around prelude calls: a loop left by
// break, continue, a return from inside a loop (DESIGN.md 3.5.9 R29; rule 16); heap check 0
fn pe(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %.17g", x)
    }
    printf("\n")
}
fn firstv(n: i64) -> f64 {
    for k in 0..n {
        let v = linspace(1.0, 2.0, k + 2)
        if len(v) == 3 {
            return v[1]
        }
    }
    return -1.0
}
for n in -1..3 {
    let v = linspace(5.0, 6.0, n)
    pe(v)
}
for k in 0..5 {
    let c = bincount([k], 5)
    let s = setdiff((0..5), [k])
    if k == 2 {
        printf("break %d %d\n", c[2], len(s))
        break
    }
}
var m = 0
while true {
    m += 1
    let (X, Y) = meshgrid(linspace(0.0, 1.0, m), [1.0])
    if m % 2 == 1 {
        continue
    }
    if cols(X) >= 4 {
        printf("while %d %g\n", m, Y[0, 0])
        break
    }
}
printf("%g %g\n", firstv(5), firstv(1))
