// heap_sel_store -- selection stores with temporary values, index vectors and masks, copy on write of a
// shared target, a compound store in a loop, matrix stores of views of temporaries
// (DESIGN.md 3.6.6 rules 15, 19, 21)
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pmf(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
fn mk(n: i64) -> f64[] {
    var v = zeros(n)
    for i in 0..n {
        v[i] = f64(i)
    }
    return v
}
fn mki(n: i64) -> i64[] {
    return (0..n) * 2
}
fn mkm() -> f64[,] {
    return [1.0, 2.0; 3.0, 4.0]
}
var v = zeros(6)
v[mki(3)] = mk(3)
pf(v)
v[mk(6) > 3.5] = 9.0
pf(v)
v[1..3] += mk(2)
pf(v)
var w = v
w[mki(2)] = 5.0
pf(w)
pf(v)
for k in 0..3 {
    v[mki(1)] += 1.0
}
pf(v)
var A = zeros(2, 2)
A[mki(1), :] = mk(2).row
A[:, mki(1)] += mk(2).col
pmf(A)
var x: f64[] = [1.0, 2.0, 3.0]
x[x > 1.5] = mk(2)
pf(x)
