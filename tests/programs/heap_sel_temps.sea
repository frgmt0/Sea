// heap_sel_temps -- selections of temporaries: a call result sliced, masked and indexed by temporary index
// vectors, nested selections, views of temporaries, a selection held per iteration and
// one discarded (DESIGN.md 3.6.6 rules 15, 20, 28)
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pmf(A: f64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
fn mk(n: i64) -> f64[] {
    var v = zeros(n)
    for i in 0..n {
        v[i] = f64(i)
    }
    return v
}
fn mki(n: i64) -> i64[] {
    return (0..n) * 2
}
fn mkm() -> f64[,] {
    return [1.0, 2.0; 3.0, 4.0]
}
pf(mk(5)[1..3])
pf(mk(5)[mki(2)])
pf(mk(4)[mk(4) > 1.5])
pf(mk(6)[1..5][[0, 3]])
printf("%g\n", mk(3)[1..3][1])
pf(mkm()[:, 1])
pmf(mkm().T)
printf("%g\n", mkm().flat[2])
var acc = 0.0
for i in 0..3 {
    let s = mk(4)[i..4]
    acc += s[0]
}
printf("%g\n", acc)
let _ = mk(3)[0..2]
printf("%d\n", len(mk(7)[mki(3)]))
