// inl_return_branches -- inlined functions that return from several branches and from a nested else block (LANGUAGE.md 8.1: a statement
// ends every path); the call is an operand of an expression
fn sign3(x: i64) -> i64 {
    if x < 0 {
        return -1
    } else if x > 0 {
        return 1
    }
    return 0
}
fn pick(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    } else {
        if b > 100 {
            return 100
        }
        return b
    }
}
printf("%d %d %d\n", sign3(-5), sign3(0), sign3(9))
printf("%d %d %d\n", pick(3, 2), pick(2, 3), pick(2, 500))
let s = sign3(-1) + sign3(1) * 10 + pick(1, 2) * 100
printf("%d\n", s)
