// inl_stmt_forms -- statement forms inside inlined functions: an if / else if / else chain, a bare block, a match with several
// patterns and a multi-statement arm (LANGUAGE.md 8.6 counts these statements; the dumps are T2's inl6_count*)
fn grade(x: i64) -> i64 {
    var r = 0
    if x < 10 {
        r = 1
    } else if x < 20 {
        r = 2
    } else {
        r = 3
    }
    {
        r += 10
        r *= 2
    }
    return r
}
fn kind(s: str) -> i64 {
    var r = -1
    match s {
        "a" | "b" => { r = 1 }
        "c" => {
            r = 2
            r += 1
        }
        _ => { r = 0 }
    }
    return r
}
printf("%d %d %d\n", grade(5), grade(15), grade(25))
printf("%d %d %d %d\n", kind("a"), kind("b"), kind("c"), kind("zz"))
