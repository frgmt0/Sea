// json_f64_values -- a record of f64 fields written as %.17g (LANGUAGE.md 11.4): values that need 17 digits (0.1, 0.1 + 0.2, 1/3, 2/3,
// pi), integral values without a point (`100`, 2^53, 1e16), exponent forms (`1e+17`, `1e-05` written with two
// digits, subnormals, the largest double), -0.0 as `-0`, NaN and the infinities as null (also computed ones)
let zero = 0.0
let huge_in = 1e308
let r = {
    zero: 0.0,
    negzero: -0.0,
    one: 1.0,
    hundred: 100.0,
    neg: -2.5,
    tenth: 0.1,
    fifth: 0.2,
    sum: 0.1 + 0.2,
    third: 1.0 / 3.0,
    twothirds: 2.0 / 3.0,
    pi: pi,
    eps: eps,
    p53: 9007199254740992.0,
    e16: 1e16,
    e17: 1e17,
    e22: 1e22,
    e300: 1e300,
    em5: 1e-5,
    em300: 1e-300,
    quarter: 123456789.125,
    long: 123456789012345678.0,
    tiny: 5e-324,
    minnorm: 2.2250738585072014e-308,
    huge: 1.7976931348623157e308,
    nan: nan,
    inf: inf,
    ninf: -inf,
    div_pos: 1.0 / zero,
    div_neg: -1.0 / zero,
    div_nan: zero / zero,
    overflow: huge_in * 10.0,
}
write_json("f64.json", r)
printf("done\n")
