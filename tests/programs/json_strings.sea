// json_strings -- str values with every kind of byte (LANGUAGE.md 11.4): `"`, `\`, LF and TAB as `\n` `\t`, the other bytes below 0x20
// (NUL, CR, 0x01, 0x1F, all 32 of them) as `\u00xx` with lowercase hex digits, 0x7F, a space, `~` and `/` as they are,
// bytes 0x80-0xFF and valid UTF-8 unchanged (never decoded); strings built at run time (`format`, `+`); a top-level
// str and a str[] with the same bytes
let r = {
    plain: "plain text",
    empty: "",
    quote: "say \"hi\"",
    backslash: "a\\b\\\\c",
    lf: "one\ntwo\n",
    tab: "a\tb",
    cr: "a\x0db",
    nul: "a\x00b",
    ctl01: "x\x01y",
    ctl1f: "x\x1fy",
    ctl_all: "\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
