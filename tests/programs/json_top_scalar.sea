// json_top_scalar -- write_json of a top-level scalar of each type, one file each: the value then one LF (LANGUAGE.md 11.4); finite f64
// as %.17g (0.1, 1/3, pi, 100 as `100`, 1e22 as `1e+22`, -0.0 as `-0`), NaN and the infinities as null, i64 -2^63
// and 2^63-1, a bool, a str, the empty str
write_json("f.json", 1.5)
write_json("i.json", 42)
write_json("b.json", true)
write_json("s.json", "text")
write_json("n.json", nan)
write_json("neg.json", -inf)
write_json("pos.json", inf)
write_json("nz.json", -0.0)
write_json("h.json", 100.0)
write_json("big.json", 1e22)
write_json("min.json", -9223372036854775808)
write_json("max.json", 9223372036854775807)
write_json("pi.json", pi)
write_json("third.json", 1.0 / 3.0)
write_json("tenth.json", 0.1)
write_json("false.json", false)
write_json("empty.json", "")
printf("done\n")
