// la_chol_rhs -- solve(F, B) of a Chol F with a vector and a matrix B (LANGUAGE.md 10.8: a vector gives a vector, a matrix
// a matrix, also with one column; DESIGN.md 2.13.5 CHOL_SOLVE, L-ik): A = [4, 2, 0; 2, 5, 2; 0, 2, 5] = R^T R
// with R = [2, 1, 0; 0, 2, 1; 0, 0, 2]; b = A [1, -1, 2] = [2, 1, 8]; B = [2, 6; 1, 11; 8, -4] = A [1, 0;
// -1, 3; 2, -2]; a 3 x 0 B gives the 3 x 0 result; exact data, printed as x + 0.0; by hand, checked by
// tests/vectors/la8_cases.py
fn pvz(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %.17g", x + 0.0)
    }
    printf("\n")
}
fn pmz(M: f64[,]) {
    printf("%dx%d:", rows(M), cols(M))
    for i in 0..rows(M) {
        for j in 0..cols(M) {
            printf(" %.17g", M[i, j] + 0.0)
        }
        printf(" |")
    }
    printf("\n")
}
let A = [4.0, 2.0, 0.0; 2.0, 5.0, 2.0; 0.0, 2.0, 5.0]
let F = chol(A)
pvz(solve(F, [2.0, 1.0, 8.0]))
pmz(solve(F, [2.0; 1.0; 8.0]))
pmz(solve(F, [2.0, 6.0; 1.0, 11.0; 8.0, -4.0]))
pmz(solve(F, zeros(3, 0)))
let b = [2.0, 1.0, 8.0]
let x = solve(F, b)
printf("%d %.17g\n", len(x), x[2])
