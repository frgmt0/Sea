// la_eig_tridiag -- eig_sym of the n = 10 matrix tridiag(-1, 2, -1) (LANGUAGE.md 10.8; DESIGN.md 2.13.8): eigenvalue k is
// 2 - 2 cos(k pi / 11), ascending, each within the tolerance rule c * n * eps * scale with c = 16,
// n = 10 and the scale ||A||_2 < 4: 16 * 10 * eps * 4 = 1.4210854715202004e-13 (a printed bool per k; Sea's cos
// is within 1 ulp, far below the bound; the closest eigenvalues are 0.236 apart); the bound by
// tests/vectors/la8_cases.py
var T = zeros(10, 10)
for i in 0..10 {
    T[i, i] = 2.0
    if i > 0 {
        T[i, i - 1] = -1.0
        T[i - 1, i] = -1.0
    }
}
let e = eig_sym(T)
let tol = 16.0 * 10.0 * eps * 4.0
printf("%d %.17g\n", len(e), tol)
for k in 1..=10 {
    let ex = 2.0 - 2.0 * cos(f64(k) * pi / 11.0)
    printf("%d %d\n", k, abs(e[k - 1] - ex) <= tol)
}
