// la_mm_fixed -- @ of two fixed-size matrices, inlined by L21 (DESIGN.md 2.13.4, Decision 125 (a), L-iw; LANGUAGE.md
// 6.8: class E at every extent, the chain c[i,j] = (...(a[i,0]*b[0,j] + a[i,1]*b[1,j]) ...)):
// order-sensitive 3 x 4 @ 4 x 2 data (1e16 + 1 - 1e16 + 0.5 is 0.5; a row of -0 products is -0), 7 x 8 @
// 8 x 6 rounded quotients, a 16 x 16 product on exact integer data (256 elements: fixed-size), k = 0
// (f64[2,0] @ f64[0,3]: +0), and 17 x 8 @ 8 x 17 whose 289 elements exceed 256, so the result is a
// dynamic matrix, still class E (2.13.2); all printed raw; expected bytes from tests/vectors/la8_cases.py
fn pm(M: f64[,]) {
    printf("%dx%d:", rows(M), cols(M))
    for i in 0..rows(M) {
        for j in 0..cols(M) {
            printf(" %.17g", M[i, j])
        }
        printf(" |")
    }
    printf("\n")
}
let A = [1e+16, 1.0, -1e+16, 0.5; 0.1, 0.2, 0.3, 0.4; -0.0, -0.0, -0.0, -0.0]
let B = [1.0, -0.0; 1.0, 2.0; 1.0, -3.0; 1.0, 0.25]
let C: f64[3,2] = A @ B
pm(C)
var P: f64[7,8] = zeros(7, 8)
for i in 0..7 {
    for j in 0..8 {
        P[i, j] = f64((i * 7 + j * 3 + 3) % 11 - 5) / f64(i + 2 * j + 3 + 3)
    }
}
var Q: f64[8,6] = zeros(8, 6)
for i in 0..8 {
    for j in 0..6 {
        Q[i, j] = f64((i * 7 + j * 3 + 1) % 11 - 5) / f64(i + 2 * j + 1 + 3)
    }
}
pm(P @ Q)
var G: f64[16,16] = zeros(16, 16)
for i in 0..16 {
    for j in 0..16 {
        G[i, j] = f64((i * 3 + j * 5 + 2) % 7 - 3)
    }
}
var H: f64[16,16] = zeros(16, 16)
for i in 0..16 {
    for j in 0..16 {
        H[i, j] = f64((i * 3 + j * 5 + 5) % 7 - 3)
    }
}
let GH: f64[16,16] = G @ H
printf("%.17g %.17g %.17g\n", GH[0, 0], GH[15, 15], GH[3, 11])
for j in 0..16 {
    printf(" %.17g", sum(GH[:, j]))
}
printf("\n")
let Z: f64[2,0] = []
let W: f64[0,3] = []
pm(Z @ W)
var U: f64[17,8] = zeros(17, 8)
for i in 0..17 {
    for j in 0..8 {
        U[i, j] = f64((i * 7 + j * 3 + 2) % 11 - 5) / f64(i + 2 * j + 2 + 3)
    }
}
var V: f64[8,17] = zeros(8, 17)
for i in 0..8 {
    for j in 0..17 {
        V[i, j] = f64((i * 7 + j * 3 + 4) % 11 - 5) / f64(i + 2 * j + 4 + 3)
    }
}
let D = U @ V
printf("%dx%d %.17g %.17g %.17g\n", rows(D), cols(D), D[0, 0], D[16, 3], sum(D.flat))
