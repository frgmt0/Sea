// la_mm_i64 -- i64 operands of matrix @ matrix converted to f64 (LANGUAGE.md 6.2, 4.2; DESIGN.md 2.13.3, L-iq): i64 @
// f64, i64 @ i64, f64 @ i64 (dynamic: GEMM on exact data, printed as x + 0.0), and the fixed-size i64[2,2]
// @ f64[2,2] of L21 (9007199254740993 converted to 2^53, class E, printed raw); expected bytes from
// tests/vectors/la8_cases.py
fn pm(M: f64[,]) {
    printf("%dx%d:", rows(M), cols(M))
    for i in 0..rows(M) {
        for j in 0..cols(M) {
            printf(" %.17g", M[i, j])
        }
        printf(" |")
    }
    printf("\n")
}
fn pmz(M: f64[,]) {
    printf("%dx%d:", rows(M), cols(M))
    for i in 0..rows(M) {
        for j in 0..cols(M) {
            printf(" %.17g", M[i, j] + 0.0)
        }
        printf(" |")
    }
    printf("\n")
}
fn mki(r: i64, c: i64, s: i64) -> f64[,] {
    var A = zeros(r, c)
    for i in 0..r {
        for j in 0..c {
            A[i, j] = f64((i * 3 + j * 5 + s) % 7 - 3)
        }
    }
    return A
}
let Ai: i64[,] = [1, -2, 3; 4, 0, -6]
let Bf = mki(3, 2, 1)
pmz(Ai @ Bf)
let Bi: i64[,] = [2, 1, 0, -1; 3, -3, 5, 1; -4, 2, 2, 7]
pmz(Ai @ Bi)
pmz(mki(2, 3, 5) @ Bi)
let Ki = [9007199254740993, 1; 2, 3]
let Kf = [1.0, 0.0; 0.0, 1.0]
pm(Ki @ Kf)
