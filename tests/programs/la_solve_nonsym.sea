// la_solve_nonsym -- solve(A, B) takes LU at once when A is not symmetric or its diagonal is not positive (LANGUAGE.md 10.8;
// DESIGN.md 2.13.6 SOLVE): lucase(5) (not symmetric, exact as in la_lu_exact) with a vector and a 5 x 3 B
// gives x and X exactly and the bits of solve(lu(A), b); the symmetric [0, 1; 1, 0] (zero diagonal: rows
// exchanged, [5, 3]) and [-2, 1; 1, -4] (negative diagonal: l = -0.5, U[1,1] = -3.5, [1, 2]) go to LU too;
// printed as x + 0.0;
// exact data (DESIGN.md 2.13.8): every value, product and partial sum is a binary64 dyadic in every
// order and grouping, so every target, variant and kernel gives these bits; checked by an exact Fraction
// simulation in tests/vectors/la8_cases.py
fn lucase(n: i64) -> f64[,] {
    let lv = [0.0, 0.5, -0.25, 0.0, -0.5, 0.25, 0.0, 0.5, -0.5]
    let dv = [2.0, -4.0, 1.0, 8.0, -2.0]
    var L = zeros(n, n)
    var U = zeros(n, n)
    for i in 0..n {
        L[i, i] = 1.0
        U[i, i] = dv[i % 5]
        for j in 0..i {
            L[i, j] = lv[(i * 7 + j * 13) % 9]
        }
        for j in i + 1..n {
            U[i, j] = f64((i * 5 + j * 3) % 7 - 3)
        }
    }
    let M = L @ U
    var A = zeros(n, n)
    for i in 0..n {
        A[i, :] = M[(17 * i + 5) % n, :]
    }
    return A
}
fn xint(n: i64) -> f64[] {
    var x = zeros(n)
    for i in 0..n {
        x[i] = f64((i * 3) % 11 - 5)
    }
    return x
}
fn xmat(n: i64, m: i64) -> f64[,] {
    var X = zeros(n, m)
    for i in 0..n {
        for c in 0..m {
            X[i, c] = f64((i * 2 + c * 5) % 9 - 4)
        }
    }
    return X
}
fn pvz(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %.17g", x + 0.0)
    }
    printf("\n")
}
let A = lucase(5)
let x = xint(5)
let X = xmat(5, 3)
let b = A @ x
let xa = solve(A, b)
printf("%d %g\n", nnz(xa != x), max(abs(xa - x)))
let Q = solve(A, A @ X) != X
printf("%d\n", nnz(Q.flat))
printf("%d\n", nnz(xa != solve(lu(A), b)))
pvz(solve([0.0, 1.0; 1.0, 0.0], [3.0, 5.0]))
pvz(solve([-2.0, 1.0; 1.0, -4.0], [0.0, -7.0]))
