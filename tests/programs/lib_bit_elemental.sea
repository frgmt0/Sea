// lib_bit_elemental -- the bitwise functions are elemental (LANGUAGE.md 10.14, 8.5, 6.3): a dynamic i64[] with a scalar
// on either side, two vectors, a fixed-size i64[4] (with a scalar, with a fixed-size literal, with a dynamic
// slice; the result stored into an i64[4]), the fused bitand(shr(v, 4), 0xF), an empty vector, a fixed-size 2 x 3
// matrix, a dynamic matrix with a .row and a .col (implicit expansion); expected values from exact integers
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn pmi(A: i64[,]) {
    printf("%dx%d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %d", A[i, j])
        }
    }
    printf("\n")
}
let v: i64[] = [0x1234, -1, 255, 4096, -9223372036854775808]
let n: i64[] = [0, 1, 2, 63, 8]
pvi(bitand(v, 0xFF))
pvi(bitor(v, 1))
pvi(bitxor(v, v))
pvi(bitxor(0x0F, v))
pvi(bitnot(v))
pvi(shl(v, 4))
pvi(shr(v, 4))
pvi(sar(v, 4))
pvi(shl(1, n))
pvi(shr(v, n))
pvi(sar(v, n))
pvi(bitand(shr(v, 4), 0xF))
pvi(bitor(bitand(v, 0xF0), shl(bitand(v, 0xF), 8)))
let e = v[0..0]
pvi(shl(e, 3))
let f: i64[4] = [1, 2, 4, 8]
let g: i64[4] = shl(f, 2)
pvi(g)
pvi(bitor(f, [16, 32, 64, 128]))
pvi(bitand(f, v[0..4]))
pvi(sar(-64, f))
let m = [1, 2, 3; 4, 5, 6]
pmi(shl(m, 8))
pmi(bitxor(m, [1, 1, 1; 0, 0, 0]))
let M: i64[,] = m
let r = [16, 32, 64]
let c = [0, 4]
pmi(bitand(M, 5))
pmi(bitor(M, r.row))
pmi(shl(M, c.col))
pmi(bitnot(M))
