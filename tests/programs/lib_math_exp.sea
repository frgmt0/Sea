// lib_math_exp -- exp of ordinary, i64 and special arguments, overflow and underflow (LANGUAGE.md 10.4; DESIGN.md 4.10)
let k = 3
printf("%.17g\n", exp(0.0))
printf("%.17g\n", exp(-0.0))
printf("%.17g\n", exp(1.0))
printf("%.17g\n", exp(-1.0))
printf("%.17g\n", exp(k))
printf("%.17g\n", exp(2))
printf("%.17g\n", exp(709.7))
printf("%.17g\n", exp(710.0))
printf("%.17g\n", exp(-745.0))
printf("%.17g\n", exp(-746.0))
printf("%.17g\n", exp(inf))
printf("%.17g\n", exp(-inf))
printf("%.17g\n", exp(nan))
printf("%.17g\n", exp(1e-20))
