// lib_math_log -- log of ordinary, i64, untyped and special arguments (LANGUAGE.md 10.4; DESIGN.md 4.10)
let n = 10
printf("%.17g\n", log(1.0))
printf("%.17g\n", log(2.0))
printf("%.17g\n", log(n))
printf("%.17g\n", log(1))
printf("%.17g\n", log(0.5))
printf("%.17g\n", log(1e-300))
printf("%.17g\n", log(5e-324))
printf("%.17g\n", log(0.0))
printf("%.17g\n", log(-0.0))
printf("%.17g\n", log(-1.0))
printf("%.17g\n", log(inf))
printf("%.17g\n", log(-inf))
printf("%.17g\n", log(nan))
printf("%.17g\n", log(1.7976931348623157e308))
