// lib_math_pow -- pow calls and ^ with a non-powk exponent, special values of C99 Annex F, i64 and untyped operands (LANGUAGE.md 6.5, 10.4)
let x = 2.0
let n = 3
printf("%.17g\n", pow(2.0, 0.5))
printf("%.17g\n", pow(2, 10))
printf("%.17g\n", pow(10.0, 22.0))
printf("%.17g\n", pow(-2.0, 3.0))
printf("%.17g\n", pow(-8.0, 0.3333333333333333))
printf("%.17g\n", pow(0.0, -1.0))
printf("%.17g\n", pow(-0.0, -1.0))
printf("%.17g\n", pow(-0.0, -2.0))
printf("%.17g\n", pow(1.0, nan))
printf("%.17g\n", pow(nan, 0.0))
printf("%.17g\n", pow(-1.0, inf))
printf("%.17g\n", pow(0.5, inf))
printf("%.17g\n", pow(2.0, -inf))
printf("%.17g\n", pow(-inf, 3.0))
printf("%.17g\n", pow(-inf, -3.0))
printf("%.17g\n", pow(inf, 0.5))
printf("%.17g\n", pow(1e300, 2.5))
printf("%.17g\n", pow(2.0, -1074.0))
printf("%.17g\n", x ^ 0.5)
printf("%.17g\n", x ^ 5)
printf("%.17g\n", n ^ 2.5)
printf("%.17g\n", 2 ^ 0.5)
printf("%.17g\n", x ^ -0.5)
printf("%.17g\n", x ^ i64(2.0))
