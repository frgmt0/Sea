// lib_math_powk_vs_pow -- x ^ k (powk, pinned multiplications) next to x ^ f64(k) and pow(x, k) (an exponent with a call is pow) for x where the bits differ (LANGUAGE.md 6.5; DESIGN.md 4.10.6)
let x = 1.3
let y = 1.2
let z = 2.3
printf("%.17g %.17g %.17g\n", x ^ 3, x ^ f64(3), pow(x, 3.0))
printf("%.17g %.17g %.17g\n", z ^ 3, z ^ f64(3), pow(z, 3.0))
printf("%.17g %.17g %.17g\n", y ^ -2, y ^ f64(-2), pow(y, -2.0))
