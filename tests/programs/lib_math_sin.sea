// lib_math_sin -- sin of ordinary, huge, i64 and special arguments (LANGUAGE.md 10.4; DESIGN.md 4.10)
let n = 7
printf("%.17g\n", sin(0.0))
printf("%.17g\n", sin(-0.0))
printf("%.17g\n", sin(1.0))
printf("%.17g\n", sin(pi))
printf("%.17g\n", sin(-pi))
printf("%.17g\n", sin(1e22))
printf("%.17g\n", sin(1e300))
printf("%.17g\n", sin(n))
printf("%.17g\n", sin(1e-310))
printf("%.17g\n", sin(inf))
printf("%.17g\n", sin(-inf))
printf("%.17g\n", sin(nan))
