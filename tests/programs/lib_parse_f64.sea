// lib_parse_f64 -- parse_f64 (LANGUAGE.md 10.9): 0, -0 (str writes -0), 1.5, .5, 5., 1e3, 1E-3, +2.5, the eight words, an
// overflow to Inf and an underflow to 0, then parse_f64(str(x)) == x for x = 0.1, 1e300, 5e-324 and -0.0 (the last also by
// the text str gives). Each result is printed with str: %.17g, nan, inf, -inf
print(str(parse_f64("0")) + "\n")
print(str(parse_f64("-0")) + "\n")
print(str(parse_f64("+0")) + "\n")
print(str(parse_f64("1.5")) + "\n")
print(str(parse_f64(".5")) + "\n")
print(str(parse_f64("5.")) + "\n")
print(str(parse_f64("1e3")) + "\n")
print(str(parse_f64("1E-3")) + "\n")
print(str(parse_f64("+2.5")) + "\n")
print(str(parse_f64("-2.5e+2")) + "\n")
print(str(parse_f64("5e-1")) + "\n")
print(str(parse_f64("inf")) + "\n")
print(str(parse_f64("Inf")) + "\n")
print(str(parse_f64("+inf")) + "\n")
print(str(parse_f64("+Inf")) + "\n")
print(str(parse_f64("-inf")) + "\n")
print(str(parse_f64("-Inf")) + "\n")
print(str(parse_f64("nan")) + "\n")
print(str(parse_f64("NaN")) + "\n")
print(str(parse_f64("1700000000.123456")) + "\n")
print(str(parse_f64("1e309")) + "\n")
print(str(parse_f64("-1e309")) + "\n")
print(str(parse_f64("1e-400")) + "\n")
print(str(parse_f64("-1e-400")) + "\n")
print(str(parse_f64("0.1")) + "\n")
print(str(parse_f64("4.9406564584124654e-324")) + "\n")
let xs: f64[] = [0.1, 1e300, 5e-324, -0.0]
for x in xs {
    printf("%d %s\n", parse_f64(str(x)) == x, str(parse_f64(str(x))))
}
