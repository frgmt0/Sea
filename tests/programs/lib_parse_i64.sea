// lib_parse_i64 -- parse_i64 (LANGUAGE.md 10.9): bases 2, 3, 8, 10, 16, 35, 36; both signs; -2^63 and 2^63 - 1 (decimal, hex,
// binary, base 36); leading zeros; hex digits in both cases; base 36 letters in both cases. Printed with %d
printf("%d\n", parse_i64("-123"))
printf("%d\n", parse_i64("+5"))
printf("%d\n", parse_i64("+0"))
printf("%d\n", parse_i64("-0"))
printf("%d\n", parse_i64("000042"))
printf("%d\n", parse_i64("-007"))
printf("%d\n", parse_i64("18FF50E5", base: 16))
printf("%d\n", parse_i64("ff", base: 16))
printf("%d\n", parse_i64("FF", base: 16))
printf("%d\n", parse_i64("Ff", base: 16))
printf("%d\n", parse_i64("aBcDeF", base: 16))
printf("%d\n", parse_i64("101", base: 2))
printf("%d\n", parse_i64("-101", base: 2))
printf("%d\n", parse_i64("777", base: 8))
printf("%d\n", parse_i64("17", base: 8))
printf("%d\n", parse_i64("10", base: 3))
printf("%d\n", parse_i64("zz", base: 36))
printf("%d\n", parse_i64("ZZ", base: 36))
printf("%d\n", parse_i64("Zz", base: 36))
printf("%d\n", parse_i64("-zZ", base: 36))
printf("%d\n", parse_i64("10", base: 36))
printf("%d\n", parse_i64("y", base: 35))
printf("%d\n", parse_i64("Y", base: 35))
printf("%d\n", parse_i64("9223372036854775807"))
printf("%d\n", parse_i64("-9223372036854775808"))
printf("%d\n", parse_i64("7FFFFFFFFFFFFFFF", base: 16))
printf("%d\n", parse_i64("-8000000000000000", base: 16))
printf("%d\n", parse_i64("111111111111111111111111111111111111111111111111111111111111111", base: 2))
printf("%d\n", parse_i64("1y2p0ij32e8e7", base: 36))
printf("%d\n", parse_i64("-1y2p0ij32e8e8", base: 36))
printf("%d\n", parse_i64("0000000000000000000000000000001", base: 2))
printf("%d\n", parse_i64("00ff", base: 16))
