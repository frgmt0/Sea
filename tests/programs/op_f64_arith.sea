// op_f64_arith -- f64 + - * / and unary - are single IEEE binary64 operations, round to
// nearest even; / of two i64 divides in f64; Inf/NaN are values
// (LANGUAGE.md 6.5, 6.8, 4.2); digits from tests/vectors/progfmt.py.
printf("%.17g\n", 0.1 + 0.2)
printf("%.17g\n", 0.3 - 0.1)
printf("%.17g\n", 0.1 * 3.0)
printf("%.17g\n", 1.0 / 3.0)
printf("%.17g\n", 2.0 / 3)
printf("%.17g\n", 7 / 2)
printf("%.17g\n", 1 / 3)
printf("%.17g\n", -(0.5 - 0.5))
printf("%g %g\n", 1e308 * 10.0, -1e308 * 10.0)
printf("%g\n", 5e-324 / 2.0)
printf("%g\n", 1.0 / 0.0 - 1.0 / 0.0)
printf("%.17g\n", 1e16 + 1.0)
printf("%.17g\n", 2.5e-324 + 2.5e-324)
printf("%.17g\n", 3 * 0.1)
