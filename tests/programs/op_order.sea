// op_order -- operation order: left associativity, parentheses, no reassociation and
// no fused multiply-add (LANGUAGE.md 6.1, 6.8); digits from progfmt.py.
printf("%.17g\n", 0.1 + 0.2 + 0.3)
printf("%.17g\n", 0.1 + (0.2 + 0.3))
printf("%.17g\n", 1e16 + 1.0 + 1.0)
printf("%.17g\n", 1e16 + (1.0 + 1.0))
printf("%.17g\n", 2 * pi * 1500.0 / 60)
printf("%.17g\n", 1.1 * 1.3 + -1.43)
printf("%.17g\n", 1.0 - 0.9 - 0.1)
printf("%.17g\n", 1.0 / 3.0 * 3.0)
printf("%.17g\n", 0.1 * 10.0 / 10.0)
printf("%.17g\n", 0.7 / 0.1)
