// opt_dead_checks -- checks inside if arms that never run: an arm whose condition is false at every
// iteration and one whose condition is loop-invariant and false (an index out of bounds,
// a division by zero, an overflow), in for and while loops: no error (LANGUAGE.md 5.4,
// 6.5, 6.6; DESIGN.md 5.8 T1, T8, T9)
fn probe(v: i64[], bad: i64, flag: bool, z: i64) -> i64 {
    var t = 0
    for i in 0..len(v) {
        if i > 100 {
            t += v[i + bad]
        }
        if flag {
            t += v[bad]
            t += idiv(1, z)
            t += bad * 9223372036854775807
        }
        t += v[i]
    }
    return t
}
let w = [1, 2, 3]
printf("%d\n", probe(w, 7, false, 0))
printf("%d\n", probe(w, -1, false, 0))
let never = len(w) > 10
var k = 0
while k < 3 {
    if never {
        printf("%d\n", w[k + 50])
    }
    printf("k %d\n", k)
    k += 1
}
let big = 9223372036854775807
for i in 0..4 {
    if never {
        printf("%d\n", big + i)
    }
    if i < 0 {
        printf("%d\n", w[i])
    }
}
printf("done\n")
