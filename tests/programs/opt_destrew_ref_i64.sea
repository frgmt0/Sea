// opt_destrew_ref_i64 -- T5 destination rewriting: the promoted location is stored again before the value it first received is
// read; each read sees the most recent store in program order (LANGUAGE.md 6.8, 7.1, 8.3)
fn f(ref s: i64, t: i64, n: i64) -> i64 {
    var u = 0
    for i in 0..n {
        s = t * 3
        s = s + 1
        u = t * 3
    }
    return u
}
var s = 0
let u = f(ref s, 5, 2)
printf("%d %d\n", s, u)
