// opt_sr_extents -- addresses of loop accesses near the extents (DESIGN.md 5.8 T7): a matrix row with the
// column stride rows(A) and a column with unit stride, 2j + 1, n - 1 - j, j + t and j - t
// with an invariant t (0 and the whole length included), a range counting down by 3 to 0,
// an invariant register stride j * k + c in a while and a for, a transpose stored column
// by column, the diagonal, stores at 3j + 2, 3j and j + 1 with step 2 reaching the last
// element, 1 x n, n x 1 and empty matrices (LANGUAGE.md 4.5, 5.1, 5.4)
fn pv(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn rowdot(A: f64[,], i: i64) -> f64 {
    var t = 0.0
    for j in 0..cols(A) {
        t += A[i, j] * f64(j + 1)
    }
    return t
}
fn coldot(A: f64[,], j: i64) -> f64 {
    var t = 0.0
    for i in 0..rows(A) {
        t += A[i, j] * f64(i + 1)
    }
    return t
}
fn odd_sum(v: i64[]) -> i64 {
    var t = 0
    for j in 0..idiv(len(v), 2) {
        t += v[2 * j + 1] * (j + 1)
    }
    return t
}
fn rev_dot(v: i64[]) -> i64 {
    let n = len(v)
    var t = 0
    for j in 0..n {
        t += v[n - 1 - j] * (j + 1)
    }
    return t
}
fn shifted(v: i64[], t: i64) -> i64 {
    var s = 0
    for j in 0..len(v) - t {
        s += v[j + t] * (j + 1)
    }
    for j in t..len(v) {
        s += v[j - t] * 1000
    }
    return s
}
fn down(A: f64[,]) -> f64 {
    var s = 0.0
    for j in cols(A) - 1..=0 step -3 {
        s += A[rows(A) - 1, j] * f64(j)
        s += A[0, j]
    }
    return s
}
fn kth(v: i64[], k: i64, c: i64) -> i64 {
    var s = 0
    var j = 0
    while j * k + c < len(v) {
        s += v[j * k + c]
        j += 1
    }
    for m in 0..3 {
        s += v[m * k + c] * 100
    }
    return s
}
fn transpose(A: f64[,]) -> f64[,] {
    var B = zeros(cols(A), rows(A))
    for i in 0..rows(A) {
        for j in 0..cols(A) {
            B[j, i] = A[i, j]
        }
    }
    return B
}
fn diag(A: f64[,]) -> f64 {
    var s = 0.0
    for j in 0..min(rows(A), cols(A)) {
        s += A[j, j] * f64(j + 1)
    }
    return s
}
fn stores(n: i64) -> i64[] {
    var v = filled(0, 3 * n + 2)
    for j in 0..n {
        v[3 * j + 2] = j + 1
        v[3 * j] = -(j + 1)
    }
    for j in 0..=n step 2 {
        v[j + 1] += 100
    }
    return v
}
fn show(A: f64[,]) {
    printf("%d %d", rows(A), cols(A))
    for i in 0..rows(A) {
        printf(" |")
        for j in 0..cols(A) {
            printf(" %g", A[i, j])
        }
    }
    printf("\n")
}
var A = zeros(3, 5)
for j in 0..5 {
    for i in 0..3 {
        A[i, j] = f64(i * 10 + j) + 0.5
    }
}
for i in 0..3 {
    printf("%g\n", rowdot(A, i))
}
for j in 0..5 {
    printf("%g\n", coldot(A, j))
}
printf("%g %g\n", down(A), diag(A))
show(transpose(A))
pv(transpose(A).flat)
var R1 = zeros(1, 4)
for j in 0..4 {
    R1[0, j] = f64(j) - 1.5
}
var C1 = zeros(4, 1)
for i in 0..4 {
    C1[i, 0] = f64(i * i)
}
printf("%g %g %g %g\n", rowdot(R1, 0), coldot(C1, 0), down(R1), diag(C1))
show(transpose(R1))
show(transpose(C1))
printf("%g %g\n", down(zeros(2, 1)), diag(zeros(0, 0)))
var w = filled(0, 7)
for i in 0..7 {
    w[i] = i * i + 1
}
printf("%d %d\n", odd_sum(w), rev_dot(w))
printf("%d %d %d\n", shifted(w, 2), shifted(w, 0), shifted(w, 7))
printf("%d %d\n", kth(w, 2, 1), kth(w, 3, 0))
pvi(stores(3))
pvi(stores(0))
pvi(stores(4))
