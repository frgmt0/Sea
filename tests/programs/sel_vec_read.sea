// sel_vec_read -- vector selections in reads: ranges, ..=, steps, negative steps, empty ranges, :, $,
// index vectors with repeats, masks of both kinds, nested selections (LANGUAGE.md 5.1-5.4)
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn pvb(v: bool[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
let v = [10.0, 11.0, 12.0, 13.0, 14.0]
var d = zeros(5)
for i in 0..5 {
    d[i] = 10.0 + f64(i)
}
pf(v[1..3])
pf(v[1..=3])
pf(v[0..5 step 2])
pf(v[4..=0 step -2])
pf(v[3..0 step -1])
pf(v[2..2])
pf(v[9..2])
pf(v[5..5])
pf(v[:])
pf(v[1..$])
pf(v[0..$ step 2])
pf(v[$ - 2..$])
pf(v[[3, 0, 3]])
pf(v[[0, $ - 1]])
pf(v[[true, false, true, false, true]])
pf(v[v > 11.5])
pf(d[1..3])
pf(d[(0..5 step 2)])
let k = filled(4, 2)
pf(d[k])
let e: i64[] = []
pf(d[e])
pf(d[d < 0.0])
let w = d[1..4][1..3]
pf(w)
let iv = (0..3)
let b = [false, true, false, true, true]
pvi(iv[b[0..3]])
pvb(b[[4, 0]])
pvb(b[1..=3 step 2])
