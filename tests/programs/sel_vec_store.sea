// sel_vec_store -- vector selection stores: ranges, steps, negative steps, empty selections, :, index
// vectors with repeats (last store wins), masks with a scalar and with a vector (LANGUAGE.md 5.5)
fn pf(v: f64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %g", x)
    }
    printf("\n")
}
fn pvi(v: i64[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
fn pvb(v: bool[]) {
    printf("%d:", len(v))
    for x in v {
        printf(" %d", x)
    }
    printf("\n")
}
var v = zeros(6)
v[1..3] = 5.0
pf(v)
v[3..6] = [1.0, 2.0, 3.0]
pf(v)
v[5..=0 step -2] = [7.0, 8.0, 9.0]
pf(v)
v[2..2] = 4.0
v[4..1] = []
pf(v)
v[:] = 1.5
pf(v)
v[[0, 2, 0]] = [10.0, 20.0, 30.0]
pf(v)
v[v > 10.0] = 0.0
pf(v)
v[v == 1.5] = [1.0, 2.0, 3.0, 4.0]
pf(v)
var w = filled(0, 4)
w[(0..4 step 3)] = 9
pvi(w)
w[[1, 2]] = (5..7)
pvi(w)
var b = filled(false, 3)
b[[true, false, true]] = true
pvb(b)
var f = [1.0, 2.0, 3.0, 4.0]
f[1..3] = 0.0
pf(f)
f[[3, 0]] = [8.0, 9.0]
pf(f)
f[$ - 1..$] = 7.0
pf(f)
