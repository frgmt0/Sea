// sr7_reg_bigslots -- regression (7e review): T12 (DESIGN.md 2.12.6) in a function with many slots, where
// the location rows of the slots T12 replaces pass 10 000: q, w and the late r (f64[4], replaced) keep their
// values beside 38 kept f64[256] slots and an f64[224] (LANGUAGE.md 4.5 fixed-size arrays, `filled`)
fn f(x: f64, k: i64) {
    var q: f64[4] = [x, x + 1.0, x + 2.0, x + 3.0]
    var w: f64[4] = [x * 10.0, x * 20.0, x * 30.0, x * 40.0]
    var b1: f64[256] = filled(x + 1.0, 256)
    var b2: f64[256] = filled(x + 2.0, 256)
    var b3: f64[256] = filled(x + 3.0, 256)
    var b4: f64[256] = filled(x + 4.0, 256)
    var b5: f64[256] = filled(x + 5.0, 256)
    var b6: f64[256] = filled(x + 6.0, 256)
    var b7: f64[256] = filled(x + 7.0, 256)
    var b8: f64[256] = filled(x + 8.0, 256)
    var b9: f64[256] = filled(x + 9.0, 256)
    var b10: f64[256] = filled(x + 10.0, 256)
    var b11: f64[256] = filled(x + 11.0, 256)
    var b12: f64[256] = filled(x + 12.0, 256)
    var b13: f64[256] = filled(x + 13.0, 256)
    var b14: f64[256] = filled(x + 14.0, 256)
    var b15: f64[256] = filled(x + 15.0, 256)
    var b16: f64[256] = filled(x + 16.0, 256)
    var b17: f64[256] = filled(x + 17.0, 256)
    var b18: f64[256] = filled(x + 18.0, 256)
    var b19: f64[256] = filled(x + 19.0, 256)
    var b20: f64[256] = filled(x + 20.0, 256)
    var b21: f64[256] = filled(x + 21.0, 256)
    var b22: f64[256] = filled(x + 22.0, 256)
    var b23: f64[256] = filled(x + 23.0, 256)
    var b24: f64[256] = filled(x + 24.0, 256)
    var b25: f64[256] = filled(x + 25.0, 256)
    var b26: f64[256] = filled(x + 26.0, 256)
    var b27: f64[256] = filled(x + 27.0, 256)
    var b28: f64[256] = filled(x + 28.0, 256)
    var b29: f64[256] = filled(x + 29.0, 256)
    var b30: f64[256] = filled(x + 30.0, 256)
    var b31: f64[256] = filled(x + 31.0, 256)
    var b32: f64[256] = filled(x + 32.0, 256)
    var b33: f64[256] = filled(x + 33.0, 256)
    var b34: f64[256] = filled(x + 34.0, 256)
    var b35: f64[256] = filled(x + 35.0, 256)
    var b36: f64[256] = filled(x + 36.0, 256)
    var b37: f64[256] = filled(x + 37.0, 256)
    var b38: f64[256] = filled(x + 38.0, 256)
    var p: f64[224] = filled(x, 224)
    var r: f64[4] = [x * 0.5, x * 0.25, x * 0.125, x * 0.0625]
    var acc = 0.0
    acc = acc + b1[k]
    acc = acc + b2[k]
    acc = acc + b3[k]
    acc = acc + b4[k]
    acc = acc + b5[k]
    acc = acc + b6[k]
    acc = acc + b7[k]
    acc = acc + b8[k]
    acc = acc + b9[k]
    acc = acc + b10[k]
    acc = acc + b11[k]
    acc = acc + b12[k]
    acc = acc + b13[k]
    acc = acc + b14[k]
    acc = acc + b15[k]
    acc = acc + b16[k]
    acc = acc + b17[k]
    acc = acc + b18[k]
    acc = acc + b19[k]
    acc = acc + b20[k]
    acc = acc + b21[k]
    acc = acc + b22[k]
    acc = acc + b23[k]
    acc = acc + b24[k]
    acc = acc + b25[k]
    acc = acc + b26[k]
    acc = acc + b27[k]
    acc = acc + b28[k]
    acc = acc + b29[k]
    acc = acc + b30[k]
    acc = acc + b31[k]
    acc = acc + b32[k]
    acc = acc + b33[k]
    acc = acc + b34[k]
    acc = acc + b35[k]
    acc = acc + b36[k]
    acc = acc + b37[k]
    acc = acc + b38[k]
    acc = acc + p[k]
    q[1] = q[1] + r[2]
    w[3] = w[3] + r[0]
    printf("%.17g %.17g %.17g %.17g\n", q[0], q[1], q[2], q[3])
    printf("%.17g %.17g %.17g %.17g\n", w[0], w[1], w[2], w[3])
    printf("%.17g %.17g %.17g %.17g\n", r[0], r[1], r[2], r[3])
    printf("%.17g\n", acc)
}
f(2.0, 3)
