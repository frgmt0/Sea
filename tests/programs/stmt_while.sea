// stmt_while -- while tests its condition before each iteration (LANGUAGE.md 7.4).
var i = 0
var total = 0
while i < 5 {
    total += i
    i += 1
}
printf("%d %d\n", i, total)
var n = 27
var count = 0
while n != 1 {
    if n % 2 == 0 {
        n = idiv(n, 2)
    } else {
        n = 3 * n + 1
    }
    count += 1
}
printf("%d\n", count)
while false {
    printf("never\n")
}
var x = 1.0
while x < 1000.0 {
    x *= 2.0
}
printf("%g\n", x)
