// str_caret_bytes -- the bytes ^ and @ in strings beside array code (7f, WP-LOOPFIX): a printf
// format, print strings and str constants holding ^ and @ (also ^ or @ followed by digits, which
// is then a whole field of sea.hirl) reach the output unchanged (LANGUAGE.md 3.5, 6.2, 11.1, 11.2)
fn ps(v: str[]) {
    printf("%d:", len(v))
    for s in v {
        printf(" [%s]", s)
    }
    printf("\n")
}
let a = ones(3)
let b = a * 2.0 + 1.0
printf("q W/m^2 at %g\n", sum(b))
print("x^12\n")
let u = "^2"
let v = "@1"
let w = "^4"
print(u + v + w + "\n")
printf("%s %s %s\n", "^10", "@3", "^")
let t = ["^1", "a^b", "@2", "^11"]
ps(t)
ps(t + "^5")
let x = linspace(0.0, 1.0, 5)
printf("%g ^%d @%d\n", sum(x), len(t), len(a))
print("^9" + "\n")
