// vec_ifexpr_pow -- W1's if-converted shape with `pow` in the arms (`d ^ e` with a variable exponent is a `pow`
// rcall): the arms are speculated in every lane, including lanes where pow takes its rare paths (d NaN, d < 0,
// d = 0, d tiny or huge, large |e|), and each lane selects its own arm's result. Every (d, e) pair is a row of
// tests/math/pow.vec, so the expected values are the reference bits. Loop meant to vectorize (T13): the F1 nest of
// `kb(d, e)` after if-conversion: two `rcall sea_pow` (no site: replaced by the vector entry, DESIGN.md 2.12.8),
// fmul by splats, fmin, fcmp masks read only by fsel; unit accesses of d and e (conditions 1-3). Lengths 1, 7, 8, 9,
// 17 (the slices are bound first, so the loop reads whole arrays).
fn pv(tag: str, v: f64[]) {
    printf("%s %d:", tag, len(v))
    for x in v {
        printf(" %.17g", x)
    }
    printf("\n")
}
elemental fn kb(d: f64, e: f64) -> f64 {
    return if d > 2.79 && d <= 51.0 { 1.24 * d ^ e }
           else if d > 51.0 { 1.51 * min(d, 1e300) ^ e }
           else { 1.0 }
}
let d: f64[] = [0.5, 3.1201654943073267, 64.0, 2.2756531599858986e+266, nan, 5.489201742692876, 1.1795268867060904, 3.999120291953497e+297, -1.0, 4.0, 2.0924805395895065e+43, 3.152266323422582, 2.659693413977278e-110, 81.0, 9.0, 0.0, 100.0]
let e: f64[] = [0.5, 45.13002645614674, 0.5, 0.010002672203310328, 1.0, -26.094122995528096, -1176.3286178100136, 8.643358869871074e-05, 1.0, 0.5, 1.6333496915182182e-06, -29.894262685654653, 1.3082093332795885e-06, 0.5, 0.5, 0.0, 0.5]
let lens: i64[] = [1, 7, 8, 9, 17]
for n in lens {
    printf("n=%d\n", n)
    let dn = d[0..n]
    let en = e[0..n]
    pv("kb", kb(dn, en))
}
