// vec_ifexpr_w1 -- W1's shape (ports/w1_shaft_design.sea, shaft_safety): `if` expressions with `&&` conditions and
// else-if chains whose arms are quiet (arithmetic, sqrt, min: no store, no failing instruction, no call), inlined
// into the elemental loop by L19/L20, and statement-form `if` blocks assigning a local. DESIGN.md 2.12.6 "What
// the workloads get". Loop meant to vectorize (T13): the F1 nest of `kq(d, t)` / `kr(d, t)` over the whole arrays
// after if-conversion (each arm computed, each register written in an arm and read later becomes fsel): unit
// accesses of d and t, fsqrt/fmul/fadd/fsub/fdiv/fmin arms, fcmp masks read only by fsel (conditions 1-3). The
// boundaries 2.79, 51 and 254, NaN, +-inf and negative d fall to different arms in neighbouring lanes. Lengths
// 1, 7, 8, 9, 17 and a 1000-element case (the slices are bound first, so the loops read whole arrays).
fn pv(tag: str, v: f64[]) {
    printf("%s %d:", tag, len(v))
    for x in v {
        printf(" %.17g", x)
    }
    printf("\n")
}
elemental fn kq(d: f64, t: f64) -> f64 {
    let k = if d > 2.79 && d <= 51.0 { 1.24 * sqrt(d) - t }
            else if d > 51.0 { 1.51 * min(d, 254.0) + t * 0.5 }
            else { 1.0 }
    let s = if t > 0.0 { k * t } else { k / (d + 1.0) }
    return s + k
}
elemental fn kr(d: f64, t: f64) -> f64 {
    var r = d
    if d < 0.0 {
        r = -d
    }
    if t > r {
        r = t * 0.5
    } else {
        r = r + 1.0
    }
    return r
}
let d: f64[] = [2.79, 2.7899999999999996, 2.8, 51.0, 51.00000000000001, 50.99999999999999, 254.0, 300.0, nan, inf, -1.0, 0.0, 3.0, 10.0, 60.0, 1.0, -inf]
let t: f64[] = [1.5, -2.0, 0.0, 4.0, nan, -0.5, 7.0, 3.0, 2.0, -1.0, 5.0, 6.0, -3.0, 0.25, 9.0, -8.0, 1.0]
let lens: i64[] = [1, 7, 8, 9, 17]
for n in lens {
    let dn = d[0..n]
    let tn = t[0..n]
    let a = kq(dn, tn)
    let b = kr(dn, tn)
    printf("n=%d\n", n)
    pv("kq", a)
    pv("kr", b)
}
var dd = zeros(1000)
var tt = zeros(1000)
for i in 0..1000 {
    dd[i] = f64(i) * 0.3 - 5.0
    tt[i] = f64(i % 13) - 6.0
}
let a = kq(dd, tt)
let b = kr(dd, tt)
printf("1000: sum(kq)=%.17g sum(kr)=%.17g kq[10]=%.17g kq[500]=%.17g kr[7]=%.17g\n", sum(a), sum(b), a[10], a[500], b[7])
